@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject UiSettings Settings
@inject IPlatformServices Platform
@inject ILoggerFactory LoggerFactory
@inject IStringLocalizer<Strings> L

@if (State.Session is not { } session)
{
    <div class="ne-placeholder">@L["NotesPlaceholder"]</div>
}
else
{
    var filter = Filter();
    <div class="ne-notes-pane">
        @* The head stays in place; only what is below it scrolls (with the search field on top). *@
        <div class="ne-notes-head">
            <div class="ne-notes-tabs" role="tablist">
                <button type="button" role="tab" class="ne-tab ne-tab-relevant @(_tab == Tab.Relevant ? "active" : null)"
                        aria-selected="@(_tab == Tab.Relevant)" @onclick="() => SelectTab(Tab.Relevant)">@L["NotesTabRelevant"]</button>
                <button type="button" role="tab" class="ne-tab ne-tab-search @(_tab == Tab.Search ? "active" : null)"
                        aria-selected="@(_tab == Tab.Search)" @onclick="() => SelectTab(Tab.Search)">@L["NotesTabSearch"]</button>
                <button type="button" role="tab" class="ne-tab ne-tab-journal @(_tab == Tab.Journal ? "active" : null)"
                        aria-selected="@(_tab == Tab.Journal)" @onclick="() => SelectTab(Tab.Journal)">@L["NotesTabJournal"]</button>
                <button type="button" role="tab" class="ne-tab ne-tab-coverage @(_tab == Tab.Coverage ? "active" : null)"
                        aria-selected="@(_tab == Tab.Coverage)" @onclick="() => SelectTab(Tab.Coverage)">@L["NotesTabCoverage"]</button>
            </div>
            <div class="ne-notes-filters">
                <label class="ne-filter-hide"><input type="checkbox" class="ne-hide-used" checked="@Settings.HideUsed" @onchange="OnHideUsed" /> @L["NotesHideUsed"]</label>
                @* "Von"/"Bis" are switched off; to bring them back, restore the _from/_to fields and pass them in Filter().
                <label class="ne-filter-date"><span>@L["NotesFrom"]</span>
                    <input type="date" class="ne-filter-from" value="@Format(_from)" @onchange="e => _from = Parse(e)" /></label>
                <label class="ne-filter-date"><span>@L["NotesTo"]</span>
                    <input type="date" class="ne-filter-to" value="@Format(_to)" @onchange="e => _to = Parse(e)" /></label>
                *@
                @if (_tab == Tab.Journal)
                {
                    <label class="ne-filter-hide"><input type="checkbox" class="ne-hide-not-relevant" checked="@Settings.HideNotRelevant" disabled="@(State.CurrentBook is null)"
                                                         @onchange="e => SaveSetting(() => Settings.HideNotRelevant = e.Value is true)" /> @L["NotesHideNotRelevant"]</label>
                    <label class="ne-filter-hide"><input type="checkbox" class="ne-hide-later" checked="@Settings.HideLater"
                                                         @onchange="e => SaveSetting(() => Settings.HideLater = e.Value is true)" /> @L["NotesHideLater"]</label>
                    <label class="ne-filter-date ne-journal-jump-label"><span>@L["NotesJumpTo"]</span>
                        <input type="date" class="ne-journal-jump" value="@Format(_jump)" @onchange="e => _jump = Parse(e)" /></label>
                }
            </div>
        </div>
        <div class="ne-notes-scroll">
            @if (State.FocusedNoteKey is { } focusedKey && session.Notes.Get(focusedKey) is { } focused)
            {
                <div class="ne-note-focused">
                    <div class="ne-note-focused-head">
                        <span>@L["NoteFocused"]</span>
                        <button type="button" class="ne-note-focused-close" title="@L["NoteFocusedClose"]"
                                aria-label="@L["NoteFocusedClose"]" @onclick="CloseFocused">×</button>
                    </div>
                    <NoteCard @key="focused.Key" Note="focused" />
                </div>
            }
            @if (_tab == Tab.Relevant)
            {
                <RelevantTab Filter="filter" Revision="_revision" />
            }
            else if (_tab == Tab.Search)
            {
                <SearchTab Query="@_query" QueryChanged="q => _query = q" Filter="filter" Revision="_revision" />
            }
            else if (_tab == Tab.Coverage)
            {
                <CoverageTab />
            }
            else
            {
                <JournalTab Filter="filter" Marks="MarkFilter()" Jump="_jump" Revision="_revision" RevealKey="_revealKey" RevealSequence="_revealSequence" />
            }
        </div>
    </div>
}

@code {
    private enum Tab
    {
        Relevant,
        Search,
        Journal,
        Coverage,
    }

    private ILogger _logger = default!;
    private VaultSession? _session;
    private Tab _tab = Tab.Search;
    private string _query = "";

    /// <summary>The Journal tab starts at this day (its field is in the filter row).</summary>
    private DateOnly? _jump;

    /// <summary>Counts the changes of the vault's pages and of the session; the tabs read their notes again when it changes.</summary>
    private int _revision;

    /// <summary>The journal note the Journal tab jumps to and highlights, with the sequence number of that request.</summary>
    private Guid? _revealKey;

    private int _revealSequence;

    protected override void OnInitialized()
    {
        _logger = LoggerFactory.CreateLogger<NotesPane>();
        State.Changed += OnStateChanged;
        State.NoteRevealRequested += OnNoteRevealRequested;
        State.NotesTabRequested += OnNotesTabRequested;
        TrackSession();
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        State.NoteRevealRequested -= OnNoteRevealRequested;
        State.NotesTabRequested -= OnNotesTabRequested;
        Unsubscribe();
    }

    private void OnStateChanged() => _ = InvokeAsync(() =>
    {
        TrackSession();
        StateHasChanged();
    });

    /// <summary>
    /// Brings the note with the block id <paramref name="noteId"/> into view: the Journal tab jumps to it if the note is
    /// a journal entry the filter shows; else (no date, or hidden by the filter) its card is shown at the top of the pane.
    /// The block can be a sub-bullet; the card is always its root note's.
    /// </summary>
    private void OnNoteRevealRequested(Guid noteId) => _ = InvokeAsync(() =>
    {
        if (State.Session is not { } session || session.Vault.FindBlockById(noteId) is not { } found)
        {
            return;
        }

        var root = found.Block;
        while (root.Parent is { } parent)
        {
            root = parent;
        }

        if (session.Notes.Get(root.Key) is not { } note)
        {
            return;
        }

        if (note.Date is not null && !MarkFilter().Hides(note.Page) && session.Notes.Journal(Filter()).Any(entry => entry.Key == note.Key))
        {
            _tab = Tab.Journal;
            _jump = note.Date;
            _revealKey = note.Key;
            _revealSequence++;
            StateHasChanged();
        }
        else
        {
            State.FocusedNoteKey = note.Key;
            State.Notify();
        }
    });

    /// <summary>Shows the requested tab.</summary>
    private void OnNotesTabRequested(NotesTab requested) => _ = InvokeAsync(() =>
    {
        var tab = requested switch
        {
            NotesTab.Relevant => Tab.Relevant,
            NotesTab.Search => Tab.Search,
            NotesTab.Journal => Tab.Journal,
            NotesTab.Coverage => Tab.Coverage,
            _ => throw new ArgumentOutOfRangeException(nameof(requested)),
        };
        SelectTab(tab);
        StateHasChanged();
    });

    private void SelectTab(Tab tab)
    {
        _tab = tab;
        _revealKey = null;
    }

    private void OnPagesChanged(string path) => _ = InvokeAsync(() =>
    {
        _revision++;
        StateHasChanged();
    });

    /// <summary>Follows the pages of the current session (a vault switch brings a new one and new notes).</summary>
    private void TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return;
        }

        Unsubscribe();
        _session = State.Session;
        _revision++;
        _revealKey = null;
        if (_session is not null)
        {
            _session.PagesChanged += OnPagesChanged;

            // The notes of a vault start with the journal; a later change of the AI never switches tabs.
            _tab = Tab.Journal;
        }
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.PagesChanged -= OnPagesChanged;
        }
    }

    /// <summary>The filter of all tabs ("Von"/"Bis" are switched off, see the filter row).</summary>
    private NoteFilter Filter() => new(Settings.HideUsed, null, null);

    /// <summary>The Journal tab's filter of marked days; "nicht relevant" counts for the current book.</summary>
    private DayMarkFilter MarkFilter() => new(Settings.HideNotRelevant, Settings.HideLater, State.CurrentBook?.LinkName);

    private void OnHideUsed(ChangeEventArgs e) => SaveSetting(() => Settings.HideUsed = e.Value is true);

    /// <summary>Applies a change of the filter settings and stores them.</summary>
    private void SaveSetting(Action change)
    {
        change();
        try
        {
            Settings.Save(Platform.UserDataDirectory);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _logger.LogWarning(ex, "Saving the UI settings failed");
        }
    }

    private void CloseFocused()
    {
        State.FocusedNoteKey = null;
        State.Notify();
    }

    private static string? Format(DateOnly? day) => day?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static DateOnly? Parse(ChangeEventArgs e) =>
        DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day)
            ? day
            : null;
}
