@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Links
@using NoteEvolution.UI.Editor
@implements IEditorCallbacks
@implements IAsyncDisposable
@inject AppState State
@inject IEditorInterop Editor
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L
@inject ILogger<EditorPane> Logger

@* The book text (spec 7): the whole book as manuscript in the TipTap editor. Every change is saved 1000 ms after the
   last one by reconciling the editor's document into the book page (BookTextSaver). The cursor element sets the
   current section; the editor marks the nodes of the range (AppState.CurrentRange) and the section bar sits at the
   bottom of that marking; revealed elements (outline, jumps) are scrolled to once the editor shows the book. The
   editor shows its own BookView (one half of a split): its cursor, section, marking and reveals are that view's; the
   editor getting the focus makes it the active view, and only the active view's editor shows the section bar. *@
<div class="@PaneClass">
    @if (State.CurrentBook is null)
    {
        <div class="ne-placeholder">@L["EditorNoBook"]</div>
    }
    else
    {
        <div class="ne-editor-bar">
            <label class="ne-editor-chips"><input type="checkbox" checked="@_showChips" @onchange="ToggleChipsAsync" /> @L["EditorShowChips"]</label>
        </div>
        @if (ReadOnlyReason is { } reason)
        {
            <div class="ne-editor-hint" role="status">@L[reason]</div>
        }
        @if (_saver.Message is { } message)
        {
            <div class="@(message.IsError ? "ne-editor-error" : "ne-editor-info")" role="@(message.IsError ? "alert" : "status")">@L[message.Key]</div>
        }
    }
    <div class="ne-editor-host" hidden="@(State.CurrentBook is null)" inert="@(ReadOnlyReason is not null)" @ref="_host"></div>
    @if (State.CurrentBook is not null && IsActive)
    {
        <SectionBar Top="_barTop" Visible="_barVisible" Element="MyView.ElementIn(State.CurrentBook)" Locked="ReadOnlyReason is not null"
                    OnCommand="OnSectionCommand" OnStatus="OnStatusChosen"
                    OnReference="OnReferenceChosen" OnLevel="OnLevelChosen" OnSource="OnSourceChosen"
                    OnAppendixPick="OnAppendixPicked" CitationLocator="@(_citationEdit?.Locator)"
                    OnCitationSave="SaveCitationAsync" OnCitationCancel="CancelCitationEdit" />
    }
</div>

@code {
    /// <summary>Autosave delay after the last change (spec 5.3), measured with the injected <see cref="TimeProvider"/> (R4).</summary>
    private static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(1000);

    /// <summary>Loading, saving and the chip operations run one at a time (they await the editor in between).</summary>
    private readonly SemaphoreSlim _gate = new(1, 1);

    private BookTextSaver _saver = default!;
    private ElementReference _host;
    private VaultSession? _session;
    private CancellationTokenSource? _debounce;
    private bool _ready;
    private bool _loading;

    /// <summary>True while the document of another book or session (or the first one) is being loaded (see <see cref="OnCursorChanged"/>).</summary>
    private bool _newTarget;

    private bool _showChips;
    private bool _shownChips;
    private bool _disposed;

    /// <summary>The dates labels the editor shows, by text block key (spec "Blockdaten" 3).</summary>
    private Dictionary<Guid, BlockDateLabel?> _shownDates = [];

    /// <summary>The cross references of the text the editor shows (spec 2.3), as last loaded or pushed.</summary>
    private ShownRefs _shownRefs = new([], []);

    /// <summary>What the editor shows of the appendix (appendix spec 3), as last loaded or pushed.</summary>
    private ShownAppendix _shownAppendix = new([], [], [], []);

    /// <summary>
    /// The labels of the people and sources, the glossary marks, and the references and citations of the text that name
    /// a person or source (by id, in order; a change there means one may have been typed as text).
    /// </summary>
    private sealed record ShownAppendix(
        Dictionary<Guid, RefLabel> People, Dictionary<Guid, RefLabel> Sources, List<GlossaryMark> Marks, List<Guid> Units)
    {
        public bool SameAs(ShownAppendix other) =>
            SameLabels(People, other.People) && SameLabels(Sources, other.Sources)
            && Marks.SequenceEqual(other.Marks) && Units.SequenceEqual(other.Units);

        private static bool SameLabels(Dictionary<Guid, RefLabel> a, Dictionary<Guid, RefLabel> b) =>
            a.Count == b.Count && a.All(l => b.GetValueOrDefault(l.Key) == l.Value);
    }

    /// <summary>The citation whose locator is being changed (a double click on it); <c>null</c> while none is.</summary>
    private CitationEditing? _citationEdit;

    /// <summary>A citation of a source at an offset of a text block or detail, and its locator as the field shows it.</summary>
    private sealed record CitationEditing(Guid SourceId, Guid ElementKey, int Offset, string Locator);

    /// <summary>The references of a text in order (by target id) and the label of each target.</summary>
    private sealed record ShownRefs(List<Guid> Order, Dictionary<Guid, RefLabel> Labels);

    /// <summary>Where the section bar goes (pixels from the pane's top) and whether the marking is in view, as the editor reports it.</summary>
    private double _barTop;

    private bool _barVisible;

    /// <summary>
    /// True while <see cref="OnCursorChanged"/>, <see cref="FollowCursorSection"/> or a range command notifies the other
    /// components (see <see cref="OnStateChanged"/>).
    /// </summary>
    private bool _notifyingCursor;

    /// <summary>The nodes last given to the editor to mark (<see cref="PushMarkedAsync"/>); <c>null</c> after that failed.</summary>
    private IReadOnlyList<MarkedNode>? _marked = [];

    /// <summary>
    /// The book view this editor shows (one half of a split view); without one the first of <see cref="AppState.Views"/>,
    /// so an editor rendered without it behaves as before the split. Taken once, when the editor starts.
    /// </summary>
    [Parameter] public BookView? View { get; set; }

    /// <summary>The view this editor shows: <see cref="View"/>, else the first view (see <see cref="OnInitialized"/>).</summary>
    private BookView MyView { get; set; } = default!;

    /// <summary>Whether <see cref="MyView"/> is the active view (the one the position members of <see cref="AppState"/> forward to).</summary>
    private bool IsActive => ReferenceEquals(MyView, State.ActiveView);

    /// <summary>The pane is marked <c>active</c> only in a split view, as the half the user works in.</summary>
    private string PaneClass => State.IsSplit && IsActive ? "ne-editor-pane active" : "ne-editor-pane";

    /// <summary>
    /// Why the book page cannot be edited now: it is read-only, a conflict for its file is open (R26), or, in the half
    /// that is not the active one, the other half holds text it could not save (typing here would save a document
    /// without it over it; see <see cref="AppState.ActivateAsync"/>).
    /// </summary>
    private string? ReadOnlyReason => State switch
    {
        { CurrentBook.Page.IsReadOnly: true } => "EditorReadOnly",
        { Session: { } session, CurrentBook.Page: { } page } when session.HasOpenConflict(page.FilePath) => "EditorConflict",
        _ when OtherHalfHasUnsavedText => "EditorOtherHalfUnsaved",
        _ => null,
    };

    /// <summary>In a split view, this half is not the active one and another half's editor holds text whose save failed.</summary>
    private bool OtherHalfHasUnsavedText =>
        State.IsSplit && !IsActive
        && State.Views.Any(v => !ReferenceEquals(v, MyView) && v.HasFailedEditorText?.Invoke() == true);

    protected override void OnInitialized()
    {
        MyView = View ?? State.Views[0];
        _saver = new BookTextSaver(State, Logger);
        State.Changed += OnStateChanged;
        MyView.RevealRequested += OnRevealRequested;
        MyView.FlushEditor = FlushAsync;
        MyView.WarnUnsavedText = WarnUnsavedText;
        MyView.HasUnsavedEditorText = HasUnsavedText;
        MyView.HasFailedEditorText = HasFailedText;
        TrackSession();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Editor.InitAsync(_host, this);
        }
        catch (Exception ex)
        {
            // Whatever failed (the bundle not found, a script error), the rest of the app stays usable.
            Logger.LogError(ex, "Loading the editor failed");
            _saver.Message = new AdoptMessage("EditorLoadFailed", true);
            StateHasChanged();
            return;
        }

        _ready = true;
        await SyncAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        State.Changed -= OnStateChanged;
        MyView.RevealRequested -= OnRevealRequested;
        if (MyView.FlushEditor == (Func<Task>)FlushAsync)
        {
            MyView.FlushEditor = null;
        }

        if (MyView.WarnUnsavedText == (Func<bool>)WarnUnsavedText)
        {
            MyView.WarnUnsavedText = null;
        }

        if (MyView.HasUnsavedEditorText == (Func<bool>)HasUnsavedText)
        {
            MyView.HasUnsavedEditorText = null;
        }

        if (MyView.HasFailedEditorText == (Func<bool>)HasFailedText)
        {
            MyView.HasFailedEditorText = null;
        }

        Unsubscribe();
        CancelDebounce();
        try
        {
            // The last text typed is not lost when the editor goes away (e.g. while another vault opens).
            _saver.Save();
            _saver.SaveDirtyPage();
            _saver.ApplyUnsavedEffects();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the book text on closing the editor failed");
        }

        try
        {
            await Editor.DisposeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Closing the editor failed");
        }
    }

    /// <summary>
    /// Saves the pending text now (the debounce is skipped) and shows what the book has. Registered as
    /// <see cref="MyView"/>'s <see cref="BookView.FlushEditor"/>: whoever changes the book page behind the editor's back awaits it first.
    /// </summary>
    public async Task FlushAsync()
    {
        if (!_ready || _disposed)
        {
            return;
        }

        await _gate.WaitAsync();
        try
        {
            await SyncCoreAsync();
            await PushMarkedAsync();
        }
        finally
        {
            _gate.Release();
        }
    }

    /// <summary>
    /// Registered as <see cref="MyView"/>'s <see cref="BookView.WarnUnsavedText"/>: before the window closes (after a flush), says whether text
    /// could not be saved and, if so, shows that closing again loses it (R33).
    /// </summary>
    private bool WarnUnsavedText()
    {
        if (!HasUnsavedText())
        {
            return false;
        }

        _saver.Message = new AdoptMessage("EditorCloseUnsaved", true);
        StateHasChanged();
        return true;
    }

    /// <summary>
    /// Registered as <see cref="MyView"/>'s <see cref="BookView.HasUnsavedEditorText"/>: whether text could not be saved
    /// (after a flush). Each editor answers for its own text: its pending text, or what a failed save of it left in the
    /// book page. The shown book page holding other changes that could not be saved is one page for all halves: if no
    /// other editor answers, the first view's editor does, so the user is told once when the window closes (without a
    /// split: the pending text or the page's unsaved changes, as before).
    /// </summary>
    private bool HasUnsavedText()
    {
        if (_disposed)
        {
            return false;
        }

        if (_saver.Pending is not null || _saver.HasFailedText)
        {
            return true;
        }

        return _saver.ShownPageIsDirty && ReferenceEquals(MyView, State.Views[0])
               && !State.Views.Skip(1).Any(v => v.HasUnsavedEditorText?.Invoke() == true);
    }

    /// <summary>
    /// Registered as <see cref="MyView"/>'s <see cref="BookView.HasFailedEditorText"/>: whether a save of this editor's
    /// own text failed and the text is not in the file yet (asked at any time).
    /// </summary>
    private bool HasFailedText() => !_disposed && _saver.HasFailedText;

    /// <summary>
    /// Takes the editor's changed document as pending text, saved after the debounce. A change in an editor that is not
    /// the active one makes its view active first (the editor may have kept the focus); if that is refused (the other
    /// half could not save its text), the change is not taken and the editor shows the book again.
    /// </summary>
    public async Task OnDocumentChanged(string docJson)
    {
        // A change from before a newly loaded document, or in a page that cannot be saved, is not taken.
        if (_loading || _saver.Shown is null || ReadOnlyReason is not null)
        {
            return;
        }

        if (!IsActive && !await ActivateAsync())
        {
            if (!_disposed)
            {
                _saver.ReloadNeeded = true;
                await SyncAsync();
            }

            return;
        }

        _saver.Pending = docJson;
        State.Session?.NotifyTyping();
        CancelDebounce();
        var source = _debounce = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(source.Token);
    }

    /// <summary>
    /// Takes the cursor element and its section into <see cref="MyView"/> (without a cursor the section stays): through
    /// <see cref="AppState"/> while it is the active view (the back/forward dwell, the session's focus), else into the view
    /// alone. A report never makes the view active (<see cref="OnEditorFocused"/> does): the editor also reports its kept
    /// cursor after a reload, e.g. when the other half saved.
    /// Components are only notified when the element or the section changed, not for every keystroke. The editor is
    /// never reloaded for it (it reports the cursor after a reload of the same book), and typed text waits for its
    /// debounce. A report while the document of another book or session is loaded is not taken: the editor's selection
    /// there is no place the user chose.
    /// </summary>
    public Task OnCursorChanged(CursorInfo? cursor)
    {
        var before = MyView.Cursor;
        if (_newTarget || cursor == before)
        {
            return Task.CompletedTask;
        }

        var section = MyView.CurrentSectionKey;
        if (IsActive)
        {
            State.Cursor = cursor;
        }
        else
        {
            MyView.Cursor = cursor;
        }

        if (cursor is not null && State.CurrentBook is { } book)
        {
            SetSection(MyView.ElementIn(book) is { } element ? BookElements.SectionOf(book, element) : Guid.Empty);
        }

        if (before is null || cursor is null || (before.Kind, before.Key, before.TextBlockKey) != (cursor.Kind, cursor.Key, cursor.TextBlockKey)
            || section != MyView.CurrentSectionKey)
        {
            _notifyingCursor = true;
            try
            {
                State.Notify();
            }
            finally
            {
                _notifyingCursor = false;
            }
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The editor got the focus: <see cref="MyView"/> becomes the active view, after the other editor saved its text
    /// (<see cref="AppState.TryActivateAsync"/>).
    /// </summary>
    public Task OnEditorFocused() => ActivateAsync();

    /// <summary>Makes <see cref="MyView"/> the active view if it is not; <c>false</c> if it is not active afterwards (see <see cref="AppState.TryActivateAsync"/>).</summary>
    private Task<bool> ActivateAsync() => State.TryActivateAsync(MyView, Logger);

    /// <summary>Sets <see cref="MyView"/>'s section: the active view's through <see cref="AppState"/>, which tells the session.</summary>
    private void SetSection(Guid section)
    {
        if (IsActive)
        {
            State.CurrentSectionKey = section;
        }
        else
        {
            MyView.CurrentSectionKey = section;
        }
    }

    /// <summary>
    /// Runs the structure command or the status command (ToggleRemark, AddRemark) on the cursor element, or Merge and
    /// Wrap on the range (<see cref="ManuscriptCommands"/>), and shows its message; the editor's shortcuts and the buttons of the section bar both come here. The range
    /// buttons and shortcuts (RangeUp, RangeDown) only move the range
    /// (<see cref="BookView.ChangeRange"/> of <see cref="MyView"/>): the document stays as it is, the editor just marks the
    /// new range. A command from an editor that is not the active one makes its view active first.
    /// </summary>
    public async Task OnSectionCommand(SectionCommand command)
    {
        if (!await ActivateAsync())
        {
            return;
        }

        if (command is SectionCommand.RangeUp or SectionCommand.RangeDown)
        {
            _notifyingCursor = true;
            try
            {
                if (MyView.ChangeRange(State.CurrentBook, command == SectionCommand.RangeUp ? 1 : -1))
                {
                    State.Notify();
                }
            }
            finally
            {
                _notifyingCursor = false;
            }

            return;
        }

        // The editor splits the block itself and saves the result like typed text (its own Ctrl+Z takes it back).
        if (command == SectionCommand.Split)
        {
            if (ManuscriptCommands.CanRun(State, command))
            {
                await Editor.SplitAtCursorAsync();
            }

            return;
        }

        // Merge goes through the link service, which names its undo action itself.
        var undo = command switch
        {
            SectionCommand.Wrap => L["UndoWrap"],
            SectionCommand.ToggleRemark => L["UndoStatus"],
            SectionCommand.AddRemark => L["UndoAddRemark"],
            _ => L["UndoStructure"],
        };
        _saver.Message = await ManuscriptCommands.RunAsync(State, command, undo, Logger);
        StateHasChanged();
    }

    /// <summary>
    /// Sets the status chosen in the section bar on the text block or detail at the cursor
    /// (<see cref="ManuscriptCommands.SetStatusAsync"/>) and shows its message; the cursor stays where it is.
    /// </summary>
    public async Task OnStatusChosen(BlockStatus status)
    {
        _saver.Message = await ManuscriptCommands.SetStatusAsync(State, status, L["UndoStatus"], Logger);
        StateHasChanged();
    }

    /// <summary>
    /// Inserts a cross reference to the heading or text block chosen in the section bar at the cursor
    /// (<see cref="ManuscriptCommands.InsertReferenceAsync"/>) and shows its message.
    /// </summary>
    public async Task OnReferenceChosen(Guid targetKey)
    {
        _saver.Message = await ManuscriptCommands.InsertReferenceAsync(State, targetKey, L["UndoReference"], Logger);
        StateHasChanged();
    }

    /// <summary>
    /// Converts the element at the cursor to the level chosen in the section bar (<see cref="ManuscriptCommands.SetLevelAsync"/>)
    /// and shows its message; the element stays the active one.
    /// </summary>
    public async Task OnLevelChosen(int level)
    {
        _saver.Message = await ManuscriptCommands.SetLevelAsync(State, level, L["UndoLevel"], Logger);
        StateHasChanged();
    }

    /// <summary>Moves the section bar to the bottom of the marking, or hides it while the marking is out of view.</summary>
    public Task OnSectionBoxMoved(double barTop, bool visible)
    {
        if ((barTop, visible) != (_barTop, _barVisible))
        {
            _barTop = barTop;
            _barVisible = visible;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>A click on a source chip brings the note into view in the notes pane (see <see cref="AppState.RevealNote"/>).</summary>
    public Task OnChipClicked(Guid noteId)
    {
        State.RevealNote(noteId);
        return Task.CompletedTask;
    }

    /// <summary>
    /// A click on a cross reference jumps to its target (spec 2.3): the heading or text block becomes the element at the
    /// cursor and is revealed, a jump in the back/forward history (<see cref="AppState.JumpTo"/>). A reference without a
    /// target goes nowhere. The jump lands in this editor: its view becomes the active one first.
    /// </summary>
    public async Task OnReferenceClicked(Guid targetId)
    {
        if (State.CurrentBook is not { } book || CrossRefIndex.Of(book).Target(targetId) is not { } target
            || !await ActivateAsync())
        {
            return;
        }

        State.JumpTo(target.Heading?.Key ?? target.TextBlock!.Key);
        State.Notify();
    }

    /// <summary>Removes the note from the block's sources and the usage from the note, after saving the pending text.</summary>
    public async Task OnChipRemoved(Guid textBlockKey, Guid noteId)
    {
        if (!_ready || _disposed)
        {
            return;
        }

        await _gate.WaitAsync();
        try
        {
            CancelDebounce();
            _saver.Message = null;
            _saver.Save();
            _saver.RemoveSource(textBlockKey, noteId);
        }
        finally
        {
            _gate.Release();
        }

        State.RefreshBook();
        State.Notify();
        StateHasChanged();
    }

    /// <summary>
    /// Links the note chosen in „Quellen suchen“ as a source of the text block at the cursor (after the editor saved its
    /// text), as the [handled] wizard links a placement; the source chip's × takes it back.
    /// </summary>
    public async Task OnSourceChosen(Guid noteBlockKey)
    {
        if (!_ready || _disposed || State.CursorTextBlockKey is not { } textBlockKey)
        {
            return;
        }

        await _gate.WaitAsync();
        try
        {
            CancelDebounce();
            _saver.Message = null;
            _saver.Save();
            _saver.AddSource(textBlockKey, noteBlockKey);
        }
        finally
        {
            _gate.Release();
        }

        State.RefreshBook();
        State.Notify();
        StateHasChanged();
    }

    /// <summary>
    /// Adopts the dropped note (<see cref="NoteAdoption"/>) after the given text block, at the start of the given
    /// heading's section, or at the start of the current section. The note lands in this editor: its view becomes the
    /// active one first.
    /// </summary>
    public async Task OnNoteDropped(Guid noteBlockKey, Guid? afterTextBlockKey)
    {
        if (!await ActivateAsync())
        {
            return;
        }

        var section = MyView.CurrentSectionKey;
        _saver.Message = await NoteAdoption.AdoptAsync(
            State,
            noteBlockKey,
            book => afterTextBlockKey switch
            {
                { } key when book.FindTextBlock(key) is not null => new InsertPosition.After(key),
                { } key when book.FindNode(key) is not null => new InsertPosition.SectionStart(key),
                _ => new InsertPosition.SectionStart(book.FindNode(section) is not null ? section : book.Root.Key),
            },
            Logger);
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        if (_notifyingCursor)
        {
            // The pane's own cursor or range notification: nothing the document depends on changed, the text waits
            // for its debounce; only the marking may have changed.
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                await PushMarkedAsync();
            });
            return;
        }

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncAsync();
        });
    }

    private void OnPagesChanged(string path) => _ = InvokeAsync(SyncAsync);

    /// <summary>
    /// <see cref="MyView"/> asked for an element: shows the current book (if it is not shown yet), then reveals it (see
    /// <see cref="RevealPendingAsync"/>).
    /// </summary>
    private void OnRevealRequested(Guid elementKey) => _ = InvokeAsync(SyncAsync);

    private void OnConflictsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The session is about to bring in an external change: pending text of that page goes into the page first, so it
    /// is merged with the external version (R30).
    /// </summary>
    private void OnExternalChangeStarting(string path)
    {
        CancelDebounce();
        _saver.PutPendingIntoPage(path);
    }

    /// <summary>Follows the current session's page and conflict events (a vault switch brings a new one).</summary>
    private void TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return;
        }

        Unsubscribe();
        _session = State.Session;
        if (_session is not null)
        {
            _session.PagesChanged += OnPagesChanged;
            _session.ConflictsChanged += OnConflictsChanged;
            _session.ExternalChangeStarting += OnExternalChangeStarting;
        }
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.PagesChanged -= OnPagesChanged;
            _session.ConflictsChanged -= OnConflictsChanged;
            _session.ExternalChangeStarting -= OnExternalChangeStarting;
        }
    }

    private async Task SaveAfterDelayAsync(CancellationToken cancel)
    {
        try
        {
            await Task.Delay(Debounce, Time, cancel);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(SyncAsync);
    }

    private void CancelDebounce()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = null;
    }

    /// <summary><see cref="FlushAsync"/> for events: failures are logged.</summary>
    private async Task SyncAsync()
    {
        try
        {
            await FlushAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Updating the editor failed");
        }
    }

    /// <summary>
    /// Saves the pending text to the place it was typed in, then shows the current book and reveals a pending element.
    /// The editor is only given a new document when that differs from what it shows (keeping the cursor while typing).
    /// </summary>
    private async Task SyncCoreAsync()
    {
        TrackSession();
        CancelDebounce();
        _saver.Save();
        _saver.SaveDirtyPage();
        _saver.ApplyUnsavedEffects();

        if (State.Session is not { } session || State.CurrentBook is null
            || session.Vault.FindBook(State.CurrentBook.LinkName) is not { } book)
        {
            _saver.Shown = null;
            _saver.Pending = null;
            StateHasChanged();
            return;
        }

        var shown = _saver.Shown;
        var sameTarget = shown is not null
                         && ReferenceEquals(shown.Session, session)
                         && string.Equals(shown.BookLink, book.LinkName, StringComparison.OrdinalIgnoreCase);
        if (_saver.Pending is not null)
        {
            // Saving failed and the text waits for the next try: keep showing it.
            if (sameTarget)
            {
                StateHasChanged();
                await RevealPendingAsync();
                return;
            }

            _saver.Pending = null;
            _saver.Message = new AdoptMessage("EditorChangesLost", true);
        }
        else if (!sameTarget)
        {
            _saver.Message = null;
        }

        var fresh = BookSnapshot.Create(book, session.Vault, book.Root.Key, true);
        if (sameTarget && !_saver.ReloadNeeded && _shownChips == _showChips
            && (SameContent(shown!.Snapshot, fresh) || (shown.FromEditor && SameShape(shown.Snapshot, fresh))))
        {
            // After its own save the editor keeps its document (cursor, undo history) even where the book holds a
            // text slightly normalized; it is compared with the book's version from now on (R33).
            var ownSave = shown!.FromEditor;
            _saver.Shown = shown with { Snapshot = fresh, FromEditor = false };
            await ShowDatesAsync(DatesOf(fresh, book));
            // Before the cross references: a citation typed as text becomes a node before its inner reference could.
            await ShowAppendixAsync(AppendixOf(fresh, book), book, ownSave);
            await ShowRefLabelsAsync(fresh, book);
            StateHasChanged();
            await RevealPendingAsync();
            return;
        }

        // Another book or session (or the first document): the editor puts no cursor into it before the user does.
        ShownAppendix appendixLoaded;
        _loading = true;
        _newTarget = !sameTarget;
        try
        {
            var dates = DatesOf(fresh, book);
            var refs = RefsOf(fresh, book);
            var appendix = AppendixOf(fresh, book);
            var json = EditorDocMapper.ToJson(
                fresh, key => dates.GetValueOrDefault(key), LabelsOf(book), id => appendix.People.GetValueOrDefault(id),
                id => appendix.Sources.TryGetValue(id, out var source) ? source : AppendixLabels.MissingSource(L));
            await Editor.SetDocumentAsync(json, _showChips, keepCursor: sameTarget);
            _shownDates = dates;
            _shownRefs = refs;
            // The document shows the labels; the editor keeps the marks it had (they are no part of the document).
            _shownAppendix = appendix with { Marks = _shownAppendix.Marks };
            appendixLoaded = appendix;
        }
        finally
        {
            _loading = false;
            _newTarget = false;
        }

        await ShowAppendixAsync(appendixLoaded, book);

        _saver.Shown = new ShownText(session, book.LinkName, fresh);
        _shownChips = _showChips;
        _saver.ReloadNeeded = false;
        if (sameTarget)
        {
            FollowCursorSection();
        }

        StateHasChanged();
        await RevealPendingAsync();
    }

    /// <summary>
    /// After the book changed under an unmoved cursor (a structure command, an undo, an outline change) the cursor
    /// element may belong to another section now: the current section follows it, as in <see cref="OnCursorChanged"/>.
    /// Components are notified only if the section changed. It is <see cref="MyView"/>'s cursor and section.
    /// </summary>
    private void FollowCursorSection()
    {
        if (MyView.Cursor is null || State.CurrentBook is not { } book)
        {
            return;
        }

        var section = MyView.ElementIn(book) is { } element ? BookElements.SectionOf(book, element) : Guid.Empty;
        if (section == MyView.CurrentSectionKey)
        {
            return;
        }

        SetSection(section);
        _notifyingCursor = true;
        try
        {
            State.Notify();
        }
        finally
        {
            _notifyingCursor = false;
        }
    }

    /// <summary>
    /// Gives the editor the nodes of <see cref="MyView"/>'s range to mark (none without a cursor), if they differ from the ones it
    /// was given last. Marking changes no document, so nothing is saved or loaded for it; the editor keeps the nodes for
    /// the documents it loads later.
    /// </summary>
    private async Task PushMarkedAsync()
    {
        if (!_ready || _disposed)
        {
            return;
        }

        IReadOnlyList<MarkedNode> nodes = MyView.RangeIn(State.CurrentBook)?.Nodes ?? [];
        if (_marked is not null && _marked.SequenceEqual(nodes))
        {
            return;
        }

        _marked = nodes;
        try
        {
            await Editor.SetMarkedAsync(nodes);
        }
        catch (Exception ex)
        {
            // The next change of the range tries again.
            _marked = null;
            Logger.LogWarning(ex, "Marking the range in the editor failed");
        }
    }

    /// <summary>Scrolls to the element <see cref="MyView"/> is to reveal (<see cref="AppState.RevealElement"/>), now that the book is shown.</summary>
    private async Task RevealPendingAsync()
    {
        var offset = MyView.PendingRevealOffset;
        var focus = MyView.PendingRevealFocus;
        if (MyView.TakePendingReveal() is { } elementKey)
        {
            await Editor.RevealAsync(elementKey, offset, focus);
        }
    }

    private async Task ToggleChipsAsync(ChangeEventArgs e)
    {
        _showChips = e.Value is true;
        await SyncAsync();
    }

    /// <summary>The dates each text block of the snapshot shows at its top right (spec "Blockdaten" 3).</summary>
    private Dictionary<Guid, BlockDateLabel?> DatesOf(SectionSnapshot snapshot, Book book) =>
        snapshot.Nodes.OfType<SnapshotTextBlock>().DistinctBy(t => t.Key).ToDictionary(
            t => t.Key,
            t => book.FindTextBlock(t.Key) is { } text ? BlockDateText.LabelOf(text.Created, text.Updated, L) : null);

    /// <summary>
    /// Gives the kept document the labels that changed (e.g. after its own save stamped a block), without reloading it.
    /// </summary>
    private async Task ShowDatesAsync(Dictionary<Guid, BlockDateLabel?> dates)
    {
        var changed = dates.Where(d => d.Value != _shownDates.GetValueOrDefault(d.Key)).ToDictionary();
        if (changed.Count > 0)
        {
            await Editor.SetBlockDatesAsync(changed);
        }

        // Only what the editor took counts as shown: after a failed push the next sync pushes the labels again.
        _shownDates = dates;
    }

    /// <summary>
    /// The cross references in the texts of the snapshot, with their labels from the book (<see cref="RefLabels"/>).
    /// A reference to a block outside the book (a note) is no cross reference but gets its foreign label too
    /// (<see cref="RefLabel.ForeignOf"/>), so one typed as text becomes a node as well: one position of the shown text.
    /// </summary>
    private ShownRefs RefsOf(SectionSnapshot snapshot, Book book)
    {
        var labelOf = LabelsOf(book);
        var labels = new Dictionary<Guid, RefLabel>();
        var order = new List<Guid>();
        foreach (var id in snapshot.Nodes.OfType<SnapshotTextBlock>()
                     .SelectMany(t => t.Paragraphs.Select(p => p.Text).Prepend(t.Text))
                     .SelectMany(text => BlockRefs.Find(text).Select(r => r.Id)))
        {
            labels.TryAdd(id, labelOf(id));
            order.Add(id);
        }

        return new ShownRefs(order, labels);
    }

    /// <summary>The reference labels of the book; an id the session's vault knows outside the book is no reference.</summary>
    private Func<Guid, RefLabel> LabelsOf(Book book) =>
        RefLabels.Of(book, L, State.Session?.Vault is { } vault ? id => vault.FindBlockById(id) is not null : null);

    /// <summary>
    /// Gives the kept document the current reference labels (a target renamed or deleted in its own save) and lets it
    /// turn references typed as text into reference nodes; pushed only when a label or the references changed.
    /// </summary>
    private async Task ShowRefLabelsAsync(SectionSnapshot snapshot, Book book)
    {
        var refs = RefsOf(snapshot, book);
        var same = refs.Order.SequenceEqual(_shownRefs.Order)
                   && refs.Labels.All(l => _shownRefs.Labels.GetValueOrDefault(l.Key) == l.Value);
        if (!same)
        {
            await Editor.SetRefLabelsAsync(refs.Labels);
        }

        // Only what the editor took counts as shown: after a failed push the next sync pushes the labels again.
        _shownRefs = refs;
    }

    /// <summary>
    /// What the editor is to show of the appendix for the snapshot's text (<see cref="AppendixLabels"/>): every person and
    /// source, a citation whose source is no entry as missing, and the glossary marks.
    /// </summary>
    private ShownAppendix AppendixOf(SectionSnapshot snapshot, Book book)
    {
        var index = AppendixIndex.Of(book);
        var people = AppendixLabels.People(book);
        var sources = AppendixLabels.Sources(book, index);
        var units = new List<Guid>();
        foreach (var text in snapshot.Nodes.OfType<SnapshotTextBlock>().SelectMany(t => t.Paragraphs.Select(p => p.Text).Prepend(t.Text)))
        {
            foreach (var citation in SourceCitations.Find(text))
            {
                sources.TryAdd(citation.Id, AppendixLabels.MissingSource(L));
                units.Add(citation.Id);
            }

            units.AddRange(BlockRefs.Find(text).Select(r => r.Id).Where(people.ContainsKey));
        }

        return new ShownAppendix(people, sources, AppendixLabels.Marks(book, index), units);
    }

    /// <summary>
    /// Gives the editor the appendix labels and marks (after its own save, a load, a change of the appendix) when they or
    /// the references to people and sources changed; a book without appendix pushes nothing. With
    /// <paramref name="afterOwnSave"/> (the editor's own save) the editor's text may have lost a mark or turned a typed
    /// reference into text while the book shows the same as before (a term deleted and typed again): what the book has is
    /// pushed unless the book has no appendix.
    /// </summary>
    private async Task ShowAppendixAsync(ShownAppendix appendix, Book book, bool afterOwnSave = false)
    {
        var hasAppendix = book.Root.Children.Any(node => node.AppendixKind != AppendixKind.None);
        if (!appendix.SameAs(_shownAppendix) || (afterOwnSave && hasAppendix))
        {
            await Editor.SetAppendixLabelsAsync(appendix.People, appendix.Sources, appendix.Marks);
        }

        // Only what the editor took counts as shown: after a failed push the next sync pushes the labels again.
        _shownAppendix = appendix;
    }

    /// <summary>A click on a person opens the window „Menschen“ at the entry.</summary>
    public Task OnPersonClicked(Guid personId)
    {
        if (State.CurrentBook is { } book && Appendix.PersonById(book, personId) is { } person)
        {
            State.RequestAppendixDialog(AppendixKind.People, person.Key);
        }

        return Task.CompletedTask;
    }

    /// <summary>A click on a citation opens the window „Quellen“ at the source; one without source goes nowhere.</summary>
    public Task OnSourceClicked(Guid sourceId)
    {
        if (State.CurrentBook is { } book && Appendix.SourceById(book, sourceId) is { } source)
        {
            State.RequestAppendixDialog(AppendixKind.Sources, source.Key);
        }

        return Task.CompletedTask;
    }

    /// <summary>A Ctrl+click on a marked glossary term opens the window „Glossar“ at the entry.</summary>
    public Task OnGlossaryClicked(Guid entryKey)
    {
        State.RequestAppendixDialog(AppendixKind.Glossary, entryKey);
        return Task.CompletedTask;
    }

    /// <summary>
    /// A double click on a citation opens the locator field at the section bar, with the citation's locator; the
    /// editor saves its text first, so the offset is one of the book's text. Not in a book that cannot be changed.
    /// </summary>
    public async Task OnCitationEdit(Guid sourceId, Guid elementKey, int offset)
    {
        if (ReadOnlyReason is not null || !await ActivateAsync())
        {
            return;
        }

        await FlushAsync();
        SourceCitation? citation = null;
        if (State.CurrentBook is { } book && BookElements.Find(book, elementKey) is { Kind: not ElementKind.Heading })
        {
            citation = ManuscriptEditor.CitationAt(book, elementKey, offset, sourceId);
        }

        _citationEdit = citation is { } found ? new CitationEditing(sourceId, elementKey, offset, found.Locator ?? "") : null;
        StateHasChanged();
    }

    /// <summary>Saves the locator typed in the field (<see cref="ManuscriptCommands.SetCitationLocatorAsync"/>) and closes it.</summary>
    private async Task SaveCitationAsync(string locator)
    {
        if (_citationEdit is not { } edit)
        {
            return;
        }

        _citationEdit = null;
        _saver.Message = await ManuscriptCommands.SetCitationLocatorAsync(
            State, edit.ElementKey, edit.Offset, edit.SourceId, locator, L["UndoCitationLocator"], Logger);
        StateHasChanged();
    }

    private void CancelCitationEdit() => _citationEdit = null;

    /// <summary>
    /// A person or source chosen in the section bar's picker goes in at the cursor
    /// (<see cref="ManuscriptCommands.InsertAppendixRefAsync"/>). „Neu anlegen …“ opens the window with a new entry; once
    /// it is saved, it goes in at the cursor the picker was opened at.
    /// </summary>
    public async Task OnAppendixPicked(AppendixPick pick)
    {
        var undo = L[pick.Kind == AppendixKind.People ? "UndoPersonRef" : "UndoSourceRef"].Value;
        if (pick.EntryKey is { } key)
        {
            _saver.Message = await ManuscriptCommands.InsertAppendixRefAsync(State, pick.Kind, key, pick.Locator, undo, Logger);
            StateHasChanged();
            return;
        }

        var cursor = State.Cursor;
        State.RequestNewAppendixEntry(pick.Kind, created => _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            _saver.Message = await ManuscriptCommands.InsertAppendixRefAsync(State, pick.Kind, created, pick.Locator, undo, Logger, cursor);
            StateHasChanged();
        }));
    }

    /// <summary>
    /// Same nodes, texts, paragraphs, statuses and chips (<see cref="SnapshotTextBlock.SplitFrom"/> is left out).
    /// </summary>
    private static bool SameContent(SectionSnapshot a, SectionSnapshot b) =>
        a.ScopeKey == b.ScopeKey
        && a.IncludeSubsections == b.IncludeSubsections
        && a.Nodes.Count == b.Nodes.Count
        && a.Nodes.Zip(b.Nodes).All(pair => (pair.First, pair.Second) switch
        {
            (SnapshotHeading x, SnapshotHeading y) => x == y,
            (SnapshotTextBlock x, SnapshotTextBlock y) =>
                x.Key == y.Key && x.Text == y.Text && x.Status == y.Status && x.Paragraphs.SequenceEqual(y.Paragraphs)
                && x.Sources.SequenceEqual(y.Sources),
            _ => false,
        });

    /// <summary>
    /// Same keys, heading levels, paragraph depths, note flags and statuses, and the same chips; texts may differ.
    /// </summary>
    private static bool SameShape(SectionSnapshot a, SectionSnapshot b) =>
        a.ScopeKey == b.ScopeKey
        && a.IncludeSubsections == b.IncludeSubsections
        && a.Nodes.Count == b.Nodes.Count
        && a.Nodes.Zip(b.Nodes).All(pair => (pair.First, pair.Second) switch
        {
            (SnapshotHeading x, SnapshotHeading y) => x.Key == y.Key && x.Level == y.Level,
            (SnapshotTextBlock x, SnapshotTextBlock y) =>
                x.Key == y.Key
                && x.Status == y.Status
                && x.Paragraphs.Select(p => (p.Key, p.Depth, p.IsNote, p.Status))
                    .SequenceEqual(y.Paragraphs.Select(p => (p.Key, p.Depth, p.IsNote, p.Status)))
                && x.Sources.SequenceEqual(y.Sources),
            _ => false,
        });
}
