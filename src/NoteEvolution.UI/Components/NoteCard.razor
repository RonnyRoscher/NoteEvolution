@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using NoteEvolution.AI.Embeddings
@using NoteEvolution.AI.Relevance
@using NoteEvolution.AI.Understanding
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject UiSettings Settings
@inject IPlatformServices Platform
@inject IStringLocalizer<Strings> L
@inject ILogger<NoteCard> Logger
@inject TimeProvider Time
@inject IServiceProvider Services

@* One note of the notes pane: origin, score, usage mark, the block text with its sub-bullets, and the actions. *@
@{
    var usageCount = Note.Usages.Count;
}

<article @ref="_root" class="ne-note-card @(InDay ? "ne-note-in-day" : null) @(Highlighted ? "ne-note-highlight" : null)" tabindex="-1"
         draggable="true" data-note-key="@Note.Key" @ondragstart="OnDragStart" @ondragend="OnDragEnd">
    @if (!InDay)
    {
        <header class="ne-note-head">
            <span class="ne-note-origin">@Origin</span>
            @if (Percent is { } percent)
            {
                <span class="ne-note-score" title="@L["NoteScoreTitle"]">@percent %</span>
            }
            @StatusDot()
            @UsedMark(usageCount)
        </header>
    }
    @if (Note.ContextPath.Count > 0)
    {
        <div class="ne-note-context">@string.Join(" › ", Note.ContextPath)</div>
    }
    <div class="ne-note-body">
        <div class="ne-note-text">@Note.Block.Content</div>
        @if (InDay)
        {
            @* In a day the buttons stand stacked at the right of the text, as for sub-bullets (a grid, see app.css). *@
            <div class="ne-adopt-column">
                @StatusDot()
                @UsedMark(usageCount)
                @AdoptSplit(Note.Block, "ne-note-adopt")
                @WhereToButton()
            </div>
            @Hint()
            @Results()
        }
        @SubBullets(Note.Block)
    </div>
    @if (!InDay)
    {
        @Hint()
        <footer class="ne-note-actions">
            @AdoptSplit(Note.Block, "ne-note-adopt")
            @WhereToButton()
            <button type="button" class="ne-note-logseq" @onclick="OpenInLogseq">@L["NoteOpenLogseq"]</button>
        </footer>
        @Results()
    }
    @if (_message is { } message)
    {
        <div class="ne-note-message @(message.IsError ? "ne-note-error" : "ne-note-info")" role="@(message.IsError ? "alert" : "status")">@L[message.Key]</div>
    }
</article>

@code {
    private ElementReference _root;
    private int _focused;
    private AdoptMessage? _message;

    /// <summary>The key of the block (the note or a sub-bullet) whose menu of adopt variants is open; <c>null</c> if none.</summary>
    private Guid? _adoptMenu;

    /// <summary>How many text blocks "Wohin damit?" lists.</summary>
    private const int WhereToLimit = 5;

    /// <summary>How many characters of a hit's first line the list shows.</summary>
    private const int WhereToExcerptLength = 60;

    private VaultSession? _session;
    private bool _disposed;
    private Guid _whereNoteKey;

    /// <summary>The app's language model, if it has one; "Genauer prüfen" is offered while it is ready.</summary>
    private LanguageModelRuntime? _language;

    /// <summary>Renders the card every second while a check runs (the elapsed time); null while none runs.</summary>
    private ITimer? _tick;

    /// <summary>The open "Wohin damit?" lists by the key of their block: the note itself or one of its sub-bullets.</summary>
    private readonly Dictionary<Guid, WhereToList> _whereTo = [];

    /// <summary>Counts the requests; a result is only applied while the list of its request is still open.</summary>
    private int _whereGeneration;

    /// <summary>
    /// An open "Wohin damit?" list: the request that opened it, the link name of the book it searched, the searched key
    /// and text (for "Genauer prüfen") and, once found, the hits (<c>null</c> while the search runs); then the check
    /// running for it, its recommendation or the hint that it failed (kept while the list is open, spec 5.2).
    /// </summary>
    private sealed class WhereToList(int generation, string bookName, Guid noteKey, string noteText)
    {
        public int Generation { get; } = generation;

        public string BookName { get; } = bookName;

        public Guid NoteKey { get; } = noteKey;

        public string NoteText { get; } = noteText;

        public IReadOnlyList<WhereToHit>? Hits { get; set; }

        public CheckRun? Check { get; set; }

        public WhereToRecommendation? Recommendation { get; set; }

        /// <summary>The recommendation is a stored placement that is out of date (note or book changed since).</summary>
        public bool RecommendationStale { get; set; }

        /// <summary>The note has a current stored placement: "Genauer prüfen" is not offered.</summary>
        public bool PlacementCurrent { get; set; }

        public bool CheckFailed { get; set; }
    }

    /// <summary>
    /// A text block of the list: its heading path (empty in the prologue), the excerpt of its first line and the score
    /// in percent of the best hit's. With the language model's understanding also its <paramref name="Topic"/> (the
    /// chosen heading's path, empty for the prologue; <c>null</c> without topics), the topic's key and summary. Whether it
    /// already uses the searched block is read when the list renders (<see cref="IsUsed"/>).
    /// </summary>
    private sealed record WhereToHit(Guid Key, string Path, string Excerpt, int Percent, string? Topic, Guid TopicKey, string? Summary);

    /// <summary>The model's choice: where a click goes, the topic's path and summary, the place and the model's reason.</summary>
    private sealed record WhereToRecommendation(Guid TargetKey, string Topic, string? Summary, string Place, string Reason, PlacementFit Fit);

    /// <summary>
    /// A running "Genauer prüfen": its cancellation, since when it runs (reset when its own request goes to the server),
    /// whether it waits behind a background request, and the duration expected when it started.
    /// </summary>
    private sealed class CheckRun(CancellationTokenSource cancel, long started, TimeSpan expected)
    {
        public CancellationTokenSource Cancel { get; } = cancel;

        public long Started { get; set; } = started;

        public TimeSpan Expected { get; } = expected;

        public bool Waiting { get; set; }

        public bool RequestStarted { get; set; }
    }

    [Parameter, EditorRequired] public NoteBlock Note { get; set; } = default!;

    /// <summary>The hit's score in percent of the best hit; <c>null</c> outside the search.</summary>
    [Parameter] public int? Percent { get; set; }

    /// <summary>The card is marked for a moment after a source jumped to its note (see <c>JournalTab</c>).</summary>
    [Parameter] public bool Highlighted { get; set; }

    /// <summary>
    /// The card stands in the card of its journal day (<c>JournalTab</c>), which shows the date and opens the page in
    /// Logseq: drawn as a box with the line on its left, without an origin and a Logseq button of its own; its buttons
    /// and its "Wohin damit?" list stand right below its text, above its sub-bullets.
    /// </summary>
    [Parameter] public bool InDay { get; set; }

    /// <summary>
    /// A new (positive) number puts the focus on the card after it rendered, which scrolls it into view; 0 asks for
    /// nothing.
    /// </summary>
    [Parameter] public int FocusRequest { get; set; }

    /// <summary>
    /// "Genauer prüfen" is offered while the language model is ready (spec 5.2) and the open vault's background work has not
    /// found its server unreachable or the model missing (the session raises <see cref="VaultSession.AiStatusChanged"/> then).
    /// </summary>
    private bool CheckAvailable => _language?.State == LanguageModelState.Ready && State.Session is not { LanguageModelAway: true };

    /// <summary>The button is offered while the AI is ready and there is a book to place the note in.</summary>
    private bool WhereToAvailable => State is { Session: { } session, CurrentBook: not null } && session.Relevance.IsAvailable;

    private string Origin => Note.Date is { } date
        ? date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)
        : Note.Page.Name;

    /// <summary>
    /// A note can be adopted into the current book: it is safely readable (R13: adopting from a read-only page
    /// throws before any change) and so is the book page.
    /// </summary>
    private bool CanAdopt =>
        State is { Session: not null, CurrentBook.Page.IsReadOnly: false } && !Note.Page.IsReadOnly;

    /// <summary>
    /// The lists belong to one note, session and book: when any of them changes (the card is reused for another note,
    /// another book is selected; compared by link name, so a new view of the same book keeps them) they are closed and
    /// a request still running is dropped.
    /// </summary>
    protected override void OnInitialized()
    {
        _language = Services.GetService<LanguageModelRuntime>();
        if (_language is not null)
        {
            _language.Changed += OnAiStatusChanged;
        }
    }

    protected override void OnParametersSet()
    {
        var sessionChanged = TrackSession();
        var bookChanged = _whereTo.Values.Any(list =>
            !string.Equals(State.CurrentBook?.LinkName, list.BookName, StringComparison.OrdinalIgnoreCase));
        if (sessionChanged || bookChanged || Note.Key != _whereNoteKey)
        {
            CloseAllWhereTo();
            _whereNoteKey = Note.Key;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRequest > 0 && FocusRequest != _focused)
        {
            _focused = FocusRequest;
            try
            {
                await _root.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or InvalidOperationException)
            {
                // The focus is only a help for the keyboard (the card may be gone or the window closing).
                Logger.LogDebug(ex, "Focusing the note card failed");
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;

        // The card is gone with its lists; the tab that showed it no longer keeps a place for it.
        if (_whereTo.Count > 0)
        {
            CancelChecks(_whereTo.Values);
            _whereTo.Clear();
            State.CloseWhereTo(_whereNoteKey);
        }

        _tick?.Dispose();
        _tick = null;
        Unsubscribe();
        if (_language is not null)
        {
            _language.Changed -= OnAiStatusChanged;
        }
    }

    /// <summary>
    /// Closes every "Wohin damit?" list of the card (see <see cref="OnParametersSet"/>). The tabs keep the card for an
    /// open list (<see cref="AppState.WhereToOpenNotes"/>); they are told afterwards (outside this rendering), so a card
    /// kept only for its list can go.
    /// </summary>
    private void CloseAllWhereTo()
    {
        if (_whereTo.Count == 0)
        {
            return;
        }

        CancelChecks(_whereTo.Values);
        _whereTo.Clear();
        StopTickingIfIdle();
        if (State.CloseWhereTo(_whereNoteKey))
        {
            _ = InvokeAsync(State.Notify);
        }
    }

    /// <summary>Cancels the checks running for <paramref name="lists"/>; their results are dropped.</summary>
    private static void CancelChecks(IEnumerable<WhereToList> lists)
    {
        foreach (var list in lists)
        {
            if (list.Check is { } run)
            {
                list.Check = null;
                run.Cancel.Cancel();
            }
        }
    }

    /// <summary>Follows the AI status of the current session: the button appears when the AI becomes ready.</summary>
    private bool TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return false;
        }

        Unsubscribe();
        _session = State.Session;
        if (_session is not null)
        {
            _session.AiStatusChanged += OnAiStatusChanged;
            _session.NoteStatusChanged += OnAiStatusChanged;
            _session.PlacementsChanged += OnPlacementsChanged;
        }

        return true;
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.AiStatusChanged -= OnAiStatusChanged;
            _session.NoteStatusChanged -= OnAiStatusChanged;
            _session.PlacementsChanged -= OnPlacementsChanged;
        }
    }

    /// <summary>A placement arrived: the open lists of this note take it over in place (their hits are not searched again).</summary>
    private void OnPlacementsChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        if (State is { CurrentBook: { } book } && _whereTo.Values.Any(list => ApplyStoredPlacement(list, book)))
        {
            StateHasChanged();
        }
    });

    /// <summary>
    /// Shows the note's stored placement as the list's recommendation (spec 4); false if nothing changed: a sub-bullet
    /// has none, the hits are not there yet (they apply it when they arrive) and a running check brings its own.
    /// </summary>
    private bool ApplyStoredPlacement(WhereToList list, Book book)
    {
        if (list.NoteKey == Guid.Empty || list.Hits is null || list.Check is not null || State.Session?.Placement(list.NoteKey) is not { } placement
            || !string.Equals(book.LinkName, list.BookName, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        list.PlacementCurrent = !placement.Stale;
        if (Recommend(list, book, placement.Verdict) is { } recommendation)
        {
            list.Recommendation = recommendation;
            list.RecommendationStale = placement.Stale;
        }

        return true;
    }

    private void OnAiStatusChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    private void OnDragStart() => State.DraggedNoteKey = Note.Key;

    private void OnDragEnd() => State.DraggedNoteKey = null;

    private void OpenInLogseq()
    {
        if (State.Session is { } session)
        {
            Platform.OpenExternal(LogseqLink.For(session.Vault.Root, Note.Block.Id, Note.Page.Name));
        }
    }

    /// <summary>
    /// The status dot of an unused note while the language model works for the vault (spec 7.2): its colour, and its
    /// stages as tooltip and label. Whether the note is used is read from the card's note, which is newer than the status.
    /// </summary>
    private RenderFragment StatusDot() =>
        @<text>
            @if (State.Session?.NoteStatus(Note.Key) is { } status
                 && NoteProgress.Of(status with { Used = Note.IsUsed }, L) is { Dot: not NoteDot.None } dot)
            {
                <span class="ne-note-dot ne-note-dot-@dot.Dot.ToString().ToLowerInvariant()" role="img"
                      title="@dot.Tooltip" aria-label="@dot.Tooltip"></span>
            }
        </text>;

    /// <summary>The mark of a used note (how often, a click goes to the usage); nothing for an unused one.</summary>
    private RenderFragment UsedMark(int usageCount) =>
        @<text>
            @if (Note.IsUsed)
            {
                <button type="button" class="ne-note-used" title="@L["NoteUsedTitle", usageCount]"
                        aria-label="@L["NoteUsedTitle", usageCount]" @onclick="GoToUsage">
                    <span class="ne-note-used-mark">✓</span>
                    @if (usageCount > 1)
                    {
                        <span class="ne-note-used-count">@usageCount</span>
                    }
                </button>
            }
        </text>;

    /// <summary>"Wohin damit?" for the note, while the AI is ready.</summary>
    private RenderFragment WhereToButton() =>
        @<text>
            @if (WhereToAvailable)
            {
                <button type="button" class="ne-note-whereto" title="@L["NoteWhereToTitle"]"
                        aria-expanded="@_whereTo.ContainsKey(Note.Block.Key)" @onclick="() => ToggleWhereToAsync(Note.Block)">@L["NoteWhereTo"]</button>
            }
        </text>;

    /// <summary>The hint that a read-only note cannot be adopted.</summary>
    private RenderFragment Hint() =>
        @<text>
            @if (Note.Page.IsReadOnly)
            {
                <div class="ne-note-hint">@L["NoteReadOnlyHint"]</div>
            }
        </text>;

    /// <summary>The note's own "Wohin damit?" list, while it is open.</summary>
    private RenderFragment Results() =>
        @<text>
            @if (_whereTo.TryGetValue(Note.Block.Key, out var noteList))
            {
                @WhereToResults(noteList, Note.Block)
            }
        </text>;

    /// <summary>
    /// Goes to the place where the note is used: the book of its first <c>used-in::</c> entry with a block
    /// reference (else its first entry), where the editor reveals that block (an entry without a block, or a block that
    /// is not found, only switches the book).
    /// </summary>
    private void GoToUsage()
    {
        if (State.Session is not { } session)
        {
            return;
        }

        var usages = Note.Usages;
        var entry = usages.FirstOrDefault(u => u.BookBlockId is not null) ?? usages.FirstOrDefault();
        if (entry is null || session.Vault.FindBook(entry.PageName) is not { } book)
        {
            return;
        }

        var sameBook = string.Equals(State.CurrentBook?.LinkName, book.LinkName, StringComparison.OrdinalIgnoreCase);
        var target = entry.BookBlockId is { } blockId ? TargetOf(book.Root, blockId) : null;
        State.CurrentBook = book;
        if (target is { } key)
        {
            State.RevealElement(key);
        }
        else if (!sameBook)
        {
            State.CurrentSectionKey = book.Root.Key;
            State.Cursor = null;
        }

        State.Notify();
    }

    /// <summary>
    /// Lists the text blocks of the current book that fit <paramref name="block"/> best (or closes its list): for the
    /// note its text as indexed (<see cref="EmbeddingText.ForNote"/>), for a sub-bullet its own text with its
    /// descendants (<see cref="EmbeddingText.ForNoteBlock"/>). The text and the book snapshot are taken here on the UI
    /// thread; only the embedding and comparing run in the background (the vault model is not thread-safe), and the
    /// paths and excerpts are read from that same snapshot. While the card has an open list, the tabs keep it at its
    /// place (<see cref="AppState.WhereToOpenNotes"/>); after its last list is closed they are told, so it can go.
    /// </summary>
    private async Task ToggleWhereToAsync(Block block)
    {
        if (_whereTo.Remove(block.Key, out var closed))
        {
            CancelChecks([closed]);
            StopTickingIfIdle();
            if (_whereTo.Count == 0 && State.CloseWhereTo(Note.Key))
            {
                State.Notify();
            }

            return;
        }

        if (State is not { Session: { } session, CurrentBook: { } book })
        {
            return;
        }

        var isNote = block.Key == Note.Block.Key;

        // A sub-bullet is indexed as a note of its own, with its parent's first line; an unknown key makes the
        // service embed exactly the sub-bullet's text instead.
        var noteKey = isNote ? Note.Key : Guid.Empty;
        var noteText = isNote ? EmbeddingText.ForNote(Note) : EmbeddingText.ForNoteBlock(block);
        var relevance = session.Relevance;
        var generation = ++_whereGeneration;
        _whereTo[block.Key] = new WhereToList(generation, book.LinkName, noteKey, noteText);
        State.OpenWhereTo(Note.Key);
        IReadOnlyList<PlacementHit> hits;
        Dictionary<Guid, string?> summaries;
        try
        {
            // The topics' summaries (the tooltips) are read from the store in the background as well.
            (hits, summaries) = await Task.Run(() =>
            {
                var found = relevance.Placements(noteKey, noteText, book, WhereToLimit);
                var topics = found.Select(hit => hit.SectionKey).Where(key => key != Guid.Empty).Distinct()
                    .ToDictionary(key => key, key => session.TopicSummary(book, key));
                return (found, topics);
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Finding the text blocks for a note failed");
            hits = [];
            summaries = [];
        }

        if (_disposed || !_whereTo.TryGetValue(block.Key, out var list) || list.Generation != generation)
        {
            return;
        }

        // Without the language model's understanding no hit has a topic: the entries look as before (spec 5.1).
        var best = hits.Count > 0 ? hits.Max(hit => hit.Score) : 0;
        list.Hits =
        [
            .. hits
                .Select(hit => (Hit: hit, TextBlock: book.FindTextBlock(hit.TextBlockKey)))
                .Where(found => found.TextBlock is not null)
                .Select(found => new WhereToHit(
                    found.Hit.TextBlockKey,
                    HeadingPath(found.TextBlock!.Section),
                    Excerpt.FirstLine(found.TextBlock.Text, WhereToExcerptLength),
                    SearchTab.Percent(found.Hit.Score, best),
                    found.Hit.SectionKey != Guid.Empty && book.FindNode(found.Hit.SectionKey) is { } topic ? TopicPath(topic) : null,
                    found.Hit.SectionKey,
                    summaries.GetValueOrDefault(found.Hit.SectionKey))),
        ];
        ApplyStoredPlacement(list, book);
    }

    /// <summary>The titles from the book's top level down to <paramref name="topic"/>, joined with " › "; empty for the root (prologue).</summary>
    private static string TopicPath(OutlineNode topic)
    {
        var titles = new List<string>();
        for (var node = topic; node is { Level: > 0 }; node = node.Parent)
        {
            titles.Add(node.Title);
        }

        titles.Reverse();
        return string.Join(" › ", titles);
    }

    /// <summary>
    /// "Genauer prüfen" for <paramref name="list"/> of <paramref name="block"/> (spec 5.2, 11.1): asks the language model
    /// through the session and shows the elapsed of the expected time (or that it waits behind a background request), then
    /// puts the model's choice first in the list or shows that the answer was unusable; the list stays either way. The
    /// duration of a check the model answered goes into the runtime's expectation.
    /// </summary>
    private async Task CheckAsync(WhereToList list, Block block)
    {
        if (list.Check is not null || State is not { Session: { } session, CurrentBook: { } book }
            || !string.Equals(book.LinkName, list.BookName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var run = new CheckRun(new CancellationTokenSource(), Time.GetTimestamp(),
            _language?.ExpectedCheckDuration ?? LanguageModelRuntime.FirstCheckDuration);
        list.Check = run;
        list.CheckFailed = false;
        _tick ??= Time.CreateTimer(_ => OnAiStatusChanged(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        var (verdict, failure) = await session.CheckPlacementAsync(
            list.NoteKey, list.NoteText, book, run.Cancel.Token,
            waiting: () => _ = InvokeAsync(() =>
            {
                if (!run.RequestStarted)
                {
                    run.Waiting = true;
                    StateHasChanged();
                }
            }),
            started: () =>
            {
                var at = Time.GetTimestamp();
                _ = InvokeAsync(() =>
                {
                    run.RequestStarted = true;
                    run.Waiting = false;
                    run.Started = at;
                    StateHasChanged();
                });
            });
        var answered = run.RequestStarted && failure is null or PlacementCheckFailure.Unusable;
        var duration = Time.GetElapsedTime(run.Started);
        run.Cancel.Dispose();

        // Cancelled, or the list was closed meanwhile: the result is dropped.
        if (_disposed || !ReferenceEquals(list.Check, run)
            || !_whereTo.TryGetValue(block.Key, out var current) || !ReferenceEquals(current, list))
        {
            return;
        }

        list.Check = null;
        StopTickingIfIdle();
        if (answered)
        {
            _language?.RecordCheck(duration);
        }

        if (verdict is not null && Recommend(list, book, verdict) is { } recommendation)
        {
            list.Recommendation = recommendation;
            list.RecommendationStale = false;
            list.PlacementCurrent = true;
        }
        else if (failure != PlacementCheckFailure.Cancelled)
        {
            list.CheckFailed = true;
        }
    }

    /// <summary>
    /// The list entry for the model's choice: the chosen place, or for a new place at the end of the topic the topic's
    /// last own text block (else its heading); null if the topic is not in the book.
    /// </summary>
    private WhereToRecommendation? Recommend(WhereToList list, Book book, PlacementVerdict verdict)
    {
        if (book.FindNode(verdict.SectionKey) is not { } topic)
        {
            return null;
        }

        var summary = verdict.Summary ?? list.Hits?.FirstOrDefault(hit => hit.TopicKey == verdict.SectionKey)?.Summary;
        if (verdict.AfterTextBlockKey is { } after && book.FindTextBlock(after) is { } textBlock)
        {
            return new WhereToRecommendation(after, TopicPath(topic), summary,
                L["NoteWhereToAfter", Excerpt.FirstLine(textBlock.Text, WhereToExcerptLength)], verdict.Reason, verdict.Fit);
        }

        return new WhereToRecommendation(topic.TextBlocks.LastOrDefault()?.Key ?? topic.Key, TopicPath(topic), summary,
            L["NoteWhereToNewPlace"], verdict.Reason, verdict.Fit);
    }

    /// <summary>Stops a running check; the list stays as it was.</summary>
    private void CancelCheck(WhereToList list)
    {
        CancelChecks([list]);
        StopTickingIfIdle();
    }

    /// <summary>Stops the ticking of the elapsed time once no list has a check running.</summary>
    private void StopTickingIfIdle()
    {
        if (_whereTo.Values.All(list => list.Check is null))
        {
            _tick?.Dispose();
            _tick = null;
        }
    }

    /// <summary>The titles from the book's top level down to <paramref name="section"/>, joined; empty for the root (prologue).</summary>
    private static string HeadingPath(OutlineNode section)
    {
        var titles = new List<string>();
        for (var node = section; node is { Level: > 0 }; node = node.Parent)
        {
            titles.Add(node.Title);
        }

        titles.Reverse();
        return string.Join(" / ", titles);
    }

    /// <summary>
    /// Goes to a text block (for a recommended new place without text blocks: the topic's heading) of a list: the editor
    /// saves first, then, while the list's book is still the current one, the editor reveals it (the cursor goes to its
    /// start). The list stays open.
    /// </summary>
    private async Task GoToHitAsync(WhereToList list, Guid textBlockKey)
    {
        if (State.Session is not { } session)
        {
            return;
        }

        try
        {
            if (State.FlushEditor is { } flush)
            {
                await flush();
            }
        }
        catch (Exception ex)
        {
            // The text may not be saved, so the view stays where it is.
            Logger.LogError(ex, "Saving the editor before going to a text block failed");
            return;
        }

        if (_disposed || !ReferenceEquals(session, State.Session)
            || State.CurrentBook is not { } book
            || !string.Equals(book.LinkName, list.BookName, StringComparison.OrdinalIgnoreCase)
            || (book.FindTextBlock(textBlockKey) is null && book.FindNode(textBlockKey) is null))
        {
            return;
        }

        State.RevealElement(textBlockKey);
        State.Notify();
    }

    /// <summary>
    /// Whether the text block <paramref name="textBlockKey"/> of <paramref name="list"/> already names
    /// <paramref name="block"/> in its <c>source::</c>: read from the block's current id (it gets one on its first
    /// adoption) and the current book, while that is the list's book.
    /// </summary>
    private bool IsUsed(WhereToList list, Block block, Guid textBlockKey) =>
        block.Id is { } id
        && State.CurrentBook is { } book
        && string.Equals(book.LinkName, list.BookName, StringComparison.OrdinalIgnoreCase)
        && book.FindTextBlock(textBlockKey)?.Sources.Contains(id) == true;

    /// <summary>
    /// The "Wohin damit?" list of <paramref name="block"/>: the busy hint while it searches, then its hits (with topics:
    /// topic › place with the topic's summary as tooltip, the model's recommendation first) or the hint that there are
    /// none; below the hits "Genauer prüfen", its progress or the hint that it failed.
    /// </summary>
    private RenderFragment WhereToResults(WhereToList list, Block block) =>
        @<div class="ne-note-whereto-results">
            @if (list.Hits is not { } hits)
            {
                <div class="ne-note-hint ne-note-whereto-busy" role="status">@L["NoteWhereToBusy"]</div>
            }
            else if (hits.Count == 0)
            {
                <div class="ne-note-hint ne-note-whereto-none" role="status">@L["NoteWhereToNone"]</div>
            }
            else
            {
                <ul class="ne-note-whereto-list">
                    @if (list.Recommendation is { } recommended)
                    {
                        <li @key="@("recommended")">
                            <button type="button" class="ne-note-whereto-item ne-note-whereto-recommended"
                                    title="@(recommended.Summary ?? L["NoteWhereToItemTitle"])"
                                    @onclick="() => GoToHitAsync(list, recommended.TargetKey)">
                                <span class="ne-note-whereto-recommended-label">@L["CheckRecommended"]</span>
                                <span class="@("ne-note-whereto-fit ne-note-whereto-fit-" + recommended.Fit.ToString().ToLowerInvariant())"
                                      title="@L["NoteWhereToFit" + recommended.Fit]">●</span>
                                @if (list.RecommendationStale)
                                {
                                    <span class="ne-note-whereto-stale">@L["NoteWhereToStale"]</span>
                                }
                                @if (recommended.Topic.Length > 0)
                                {
                                    <span class="ne-note-whereto-topic">@recommended.Topic</span>
                                }
                                <span class="ne-note-whereto-place">@recommended.Place</span>
                                @if (IsUsed(list, block, recommended.TargetKey))
                                {
                                    <span class="ne-note-whereto-used">✓</span>
                                }
                                <span class="ne-note-whereto-reason">@recommended.Reason</span>
                            </button>
                        </li>
                    }
                    @foreach (var hit in hits)
                    {
                        <li @key="hit.Key">
                            @if (hit.Topic is { } topic)
                            {
                                <button type="button" class="ne-note-whereto-item" title="@(hit.Summary ?? L["NoteWhereToItemTitle"])"
                                        @onclick="() => GoToHitAsync(list, hit.Key)">
                                    @if (topic.Length > 0)
                                    {
                                        <span class="ne-note-whereto-topic">@topic</span>
                                    }
                                    <span class="ne-note-whereto-place">@L["NoteWhereToAfter", hit.Excerpt]</span>
                                    @if (IsUsed(list, block, hit.Key))
                                    {
                                        <span class="ne-note-whereto-used">✓</span>
                                    }
                                    <span class="ne-note-whereto-percent">@hit.Percent %</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ne-note-whereto-item" title="@L["NoteWhereToItemTitle"]"
                                        @onclick="() => GoToHitAsync(list, hit.Key)">
                                    @if (hit.Path.Length > 0)
                                    {
                                        <span class="ne-note-whereto-path">@hit.Path</span>
                                    }
                                    <span class="ne-note-whereto-excerpt">@hit.Excerpt</span>
                                    @if (IsUsed(list, block, hit.Key))
                                    {
                                        <span class="ne-note-whereto-used">✓</span>
                                    }
                                    <span class="ne-note-whereto-percent">@hit.Percent %</span>
                                </button>
                            }
                        </li>
                    }
                </ul>
                @if (list.Check is { } run)
                {
                    @Checking(list, run)
                }
                else if (CheckAvailable && !list.PlacementCurrent)
                {
                    <button type="button" class="ne-note-whereto-check" title="@L["CheckButtonTitle"]"
                            @onclick="() => CheckAsync(list, block)">@L["CheckButton"]</button>
                }
                @if (list.CheckFailed)
                {
                    <div class="ne-note-hint ne-note-whereto-check-failed" role="status">@L["CheckUnusable"]</div>
                }
            }
        </div>;

    /// <summary>
    /// The progress of a running check: "Prüfe … 0:42 von ca. 1:20" with a bar; past the expected time the bar becomes
    /// indeterminate (pulsing) with "dauert länger als erwartet". While it waits behind a background request only that
    /// is said, with an indeterminate bar.
    /// </summary>
    private RenderFragment Checking(WhereToList list, CheckRun run)
    {
        var elapsed = Time.GetElapsedTime(run.Started);
        var longer = !run.Waiting && elapsed > run.Expected;
        var text = run.Waiting
            ? L["CheckWaiting"].Value
            : L["CheckRunning", Durations.Format(elapsed, L), Durations.Format(run.Expected, L)].Value;
        return @<div class="ne-note-whereto-checking" role="status">
            <span class="ne-note-whereto-checking-text">@text</span>
            @if (longer)
            {
                <span class="ne-note-whereto-check-longer">@L["CheckLonger"]</span>
            }
            @if (run.Waiting || longer)
            {
                <progress class="ne-note-whereto-check-bar"></progress>
            }
            else
            {
                <progress class="ne-note-whereto-check-bar" max="@WholeSeconds(run.Expected)" value="@WholeSeconds(elapsed)"></progress>
            }
            <button type="button" class="ne-note-whereto-check-cancel" @onclick="() => CancelCheck(list)">@L["CheckCancel"]</button>
        </div>;
    }

    /// <summary>A duration in whole seconds (rounded), for the bar.</summary>
    private static long WholeSeconds(TimeSpan span) => (long)Math.Round(span.TotalSeconds, MidpointRounding.AwayFromZero);

    /// <summary>
    /// The sub-bullets of <paramref name="parent"/>, each as a box with the line on its left: its own row (text and,
    /// for sub-bullets with more than one line that are no list item, its buttons), its "Wohin damit?" list, and the
    /// boxes of all its sub-blocks. The box shows what its buttons take: the sub-bullet with everything below it.
    /// </summary>
    private RenderFragment SubBullets(Block parent) =>
        @<text>
            @foreach (var child in parent.Children)
            {
                var offer = SubBulletButtons.Offer(child);
                <div @key="child.Key" class="ne-note-child">
                    <div class="ne-note-child-row">
                        <span class="ne-note-child-text">@child.Content</span>
                        @if (offer)
                        {
                            <div class="ne-adopt-column">
                                @AdoptSplit(child, "ne-note-child-adopt")
                                @if (WhereToAvailable)
                                {
                                    <button type="button" class="ne-note-child-whereto" title="@L["NoteWhereToTitle"]"
                                            aria-expanded="@_whereTo.ContainsKey(child.Key)" @onclick="() => ToggleWhereToAsync(child)">@L["NoteWhereTo"]</button>
                                }
                            </div>
                        }
                    </div>
                    @if (offer && _whereTo.TryGetValue(child.Key, out var childList))
                    {
                        @WhereToResults(childList, child)
                    }
                    @SubBullets(child)
                </div>
            }
        </text>;

    /// <summary>
    /// The key of the heading or text block with the id <paramref name="blockId"/>; for a paragraph (detail) the key of
    /// its text block.
    /// </summary>
    private static Guid? TargetOf(OutlineNode node, Guid blockId)
    {
        if (node.Block?.Id == blockId)
        {
            return node.Key;
        }

        if (node.TextBlocks.FirstOrDefault(text => text.Block.Id == blockId || text.Paragraphs.Any(p => p.Block.Id == blockId)) is { } textBlock)
        {
            return textBlock.Key;
        }

        return node.Children.Select(child => TargetOf(child, blockId)).FirstOrDefault(key => key is not null);
    }

    /// <summary>The label and tooltip of an adopt variant.</summary>
    private (string Label, string Title) Texts(AdoptVariant variant) => variant switch
    {
        AdoptVariant.After => (L["AdoptAfter"].Value, L["AdoptAfterTitle"].Value),
        AdoptVariant.Below => (L["AdoptBelow"].Value, L["AdoptBelowTitle"].Value),
        AdoptVariant.AsHeading => (L["AdoptAsHeading"].Value, L["AdoptAsHeadingTitle"].Value),
        AdoptVariant.AsSubheading => (L["AdoptAsSubheading"].Value, L["AdoptAsSubheadingTitle"].Value),
        _ => (L["AdoptAtCursor"].Value, L["AdoptAtCursorTitle"].Value),
    };

    /// <summary>
    /// "Übernehmen" for <paramref name="block"/> as a split button: the main part adopts the way used last (first "Am
    /// Cursor", see <see cref="UiSettings.LastAdoptVariant"/>) and is labelled so, unless that way is not offered for
    /// the block (<see cref="NoteAdoption.Offers"/>): then it adopts "Am Cursor"; the arrow opens the menu of the ways
    /// offered. <paramref name="cssClass"/> names the main part, the arrow gets it with <c>-more</c>.
    /// </summary>
    private RenderFragment AdoptSplit(Block block, string cssClass)
    {
        // The button adopts the way it shows, even if another card changes the choice before this one renders again.
        var variant = NoteAdoption.Offers(State, block, Settings.LastAdoptVariant) ? Settings.LastAdoptVariant : AdoptVariant.AtCursor;
        var (label, title) = Texts(variant);
        return @<span class="ne-adopt-split">
            <button type="button" class="@cssClass" title="@title"
                    disabled="@(!CanAdopt)" @onclick="() => AdoptAsync(block, variant)">@label</button>
            <button type="button" class="@(cssClass)-more" title="@L["NoteAdoptMore"]" aria-label="@L["NoteAdoptMore"]"
                    aria-haspopup="menu" aria-expanded="@(_adoptMenu == block.Key)"
                    disabled="@(!CanAdopt)" @onclick="() => ToggleAdoptMenu(block.Key)">▾</button>
            @if (_adoptMenu == block.Key)
            {
                @AdoptMenu(block)
            }
        </span>;
    }

    /// <summary>Opens the menu of adopt variants of <paramref name="blockKey"/> (closing any other), or closes it.</summary>
    private void ToggleAdoptMenu(Guid blockKey) => _adoptMenu = _adoptMenu == blockKey ? null : blockKey;

    /// <summary>The menu of the adopt variants offered for <paramref name="block"/>, each with a tooltip that explains it.</summary>
    private RenderFragment AdoptMenu(Block block) =>
        @<div class="ne-adopt-menu" role="menu">
            @foreach (var (variant, cssClass) in MenuVariants.Where(v => NoteAdoption.Offers(State, block, v.Variant)))
            {
                var (label, title) = Texts(variant);
                <button type="button" role="menuitem" class="@cssClass" title="@title"
                        @onclick="() => AdoptChosenAsync(block, variant)">@label</button>
            }
        </div>;

    private static readonly (AdoptVariant Variant, string CssClass)[] MenuVariants =
    [
        (AdoptVariant.AtCursor, "ne-adopt-at-cursor"),
        (AdoptVariant.After, "ne-adopt-after"),
        (AdoptVariant.Below, "ne-adopt-below"),
        (AdoptVariant.AsHeading, "ne-adopt-as-heading"),
        (AdoptVariant.AsSubheading, "ne-adopt-as-subheading"),
    ];

    /// <summary>
    /// A variant chosen in the menu becomes the button's way on every card (kept in <c>ui.json</c>; a failed save only
    /// costs the memory after a restart), then adopts.
    /// </summary>
    private async Task AdoptChosenAsync(Block block, AdoptVariant variant)
    {
        if (Settings.LastAdoptVariant != variant)
        {
            Settings.LastAdoptVariant = variant;
            try
            {
                Settings.Save(Platform.UserDataDirectory);
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
            {
                Logger.LogWarning(ex, "Saving the UI settings failed");
            }
        }

        await AdoptAsync(block, variant);
    }

    /// <summary>
    /// Adopts <paramref name="block"/> (the note itself or one of its sub-bullets) into the current book the way
    /// <paramref name="variant"/> says, relative to the element at the cursor (see <see cref="NoteAdoption"/>); closes
    /// the menu.
    /// </summary>
    private async Task AdoptAsync(Block block, AdoptVariant variant)
    {
        _adoptMenu = null;
        _message = null;
        _message = await NoteAdoption.AdoptAsync(State, block.Key, variant, L["OutlineUntitled"].Value, Logger);
    }
}
