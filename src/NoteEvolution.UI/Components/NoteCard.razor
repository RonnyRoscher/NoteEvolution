@using NoteEvolution.AI.Embeddings
@using NoteEvolution.AI.Relevance
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Links
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject IPlatformServices Platform
@inject IStringLocalizer<Strings> L
@inject ILogger<NoteCard> Logger

@* One note of the notes pane: origin, score, usage mark, the block text with its sub-bullets, and the actions. *@
@{
    var lineCount = LineCount;
    var usageCount = Note.Usages.Count;
    var collapsible = lineCount > CollapsedLines;
}

<article @ref="_root" class="ne-note-card @(Highlighted ? "ne-note-highlight" : null)" tabindex="-1" draggable="true" data-note-key="@Note.Key"
         @ondragstart="OnDragStart" @ondragend="OnDragEnd">
    <header class="ne-note-head">
        <span class="ne-note-origin">@Origin</span>
        @if (Percent is { } percent)
        {
            <span class="ne-note-score" title="@L["NoteScoreTitle"]">@percent %</span>
        }
        @if (Note.IsUsed)
        {
            <button type="button" class="ne-note-used" title="@L["NoteUsedTitle", usageCount]"
                    aria-label="@L["NoteUsedTitle", usageCount]" @onclick="GoToUsage">
                <span class="ne-note-used-mark">✓</span>
                @if (usageCount > 1)
                {
                    <span class="ne-note-used-count">@usageCount</span>
                }
            </button>
        }
    </header>
    @if (Note.ContextPath.Count > 0)
    {
        <div class="ne-note-context">@string.Join(" › ", Note.ContextPath)</div>
    }
    <div class="ne-note-body @(collapsible && !_expanded ? "collapsed" : null)">
        <div class="ne-note-text">@Note.Block.Content</div>
        @foreach (var (child, depth) in Descendants(Note.Block, 1))
        {
            <div class="ne-note-child" style="margin-left: @(depth * 12)px">
                <span class="ne-note-child-text">@child.Content</span>
                <button type="button" class="ne-note-child-adopt" title="@L["NoteAdoptChildTitle"]"
                        disabled="@(!CanAdopt)" @onclick="() => AdoptAsync(child)">@L["NoteAdopt"]</button>
            </div>
        }
    </div>
    @if (Note.Page.IsReadOnly)
    {
        <div class="ne-note-hint">@L["NoteReadOnlyHint"]</div>
    }
    <footer class="ne-note-actions">
        <button type="button" class="ne-note-adopt" title="@L["NoteAdoptTitle"]"
                disabled="@(!CanAdopt)" @onclick="() => AdoptAsync(Note.Block)">@L["NoteAdopt"]</button>
        @if (WhereToAvailable)
        {
            <button type="button" class="ne-note-whereto" title="@L["NoteWhereToTitle"]"
                    aria-expanded="@(_whereTo is not null || _whereBusy)" @onclick="ToggleWhereToAsync">@L["NoteWhereTo"]</button>
        }
        <button type="button" class="ne-note-logseq" @onclick="OpenInLogseq">@L["NoteOpenLogseq"]</button>
        @if (collapsible)
        {
            <button type="button" class="ne-note-more" @onclick="() => _expanded = !_expanded">@(_expanded ? L["NoteLess"] : L["NoteMore"])</button>
        }
    </footer>
    @if (_whereBusy)
    {
        <div class="ne-note-hint ne-note-whereto-busy" role="status">@L["NoteWhereToBusy"]</div>
    }
    else if (_whereTo is { } whereTo)
    {
        if (whereTo.Sections.Count == 0)
        {
            <div class="ne-note-hint ne-note-whereto-none" role="status">@L["NoteWhereToNone"]</div>
        }
        else
        {
            <ul class="ne-note-whereto-list">
                @foreach (var target in whereTo.Sections)
                {
                    var key = target.Key;
                    <li>
                        <button type="button" class="ne-note-whereto-item" title="@L["NoteWhereToItemTitle"]"
                                @onclick="() => GoToSectionAsync(key)">
                            <span class="ne-note-whereto-title">@target.Title</span>
                            <span class="ne-note-whereto-percent">@target.Percent %</span>
                        </button>
                    </li>
                }
            </ul>
        }
    }
    @if (_message is { } message)
    {
        <div class="ne-note-message @(message.IsError ? "ne-note-error" : "ne-note-info")" role="@(message.IsError ? "alert" : "status")">@L[message.Key]</div>
    }
</article>

@code {
    /// <summary>From this many lines on, the card is collapsed to three lines until "mehr" is clicked.</summary>
    private const int CollapsedLines = 3;

    private ElementReference _root;
    private int _focused;
    private bool _expanded;
    private AdoptMessage? _message;

    /// <summary>How many sections "Wohin damit?" lists.</summary>
    private const int WhereToLimit = 5;

    private VaultSession? _session;
    private bool _disposed;
    private bool _whereBusy;
    private WhereToResult? _whereTo;
    private Guid _whereNoteKey;
    private string? _whereBookName;

    /// <summary>Counts the requests and closings; a result is only applied while its request is still the newest.</summary>
    private int _whereGeneration;

    /// <summary>The sections found for the note; <see cref="Book"/> is the snapshot they were found in.</summary>
    private sealed record WhereToResult(Book Book, IReadOnlyList<(Guid Key, string Title, int Percent)> Sections);

    [Parameter, EditorRequired] public NoteBlock Note { get; set; } = default!;

    /// <summary>The hit's score in percent of the best hit; <c>null</c> outside the search.</summary>
    [Parameter] public int? Percent { get; set; }

    /// <summary>The card is marked for a moment after a source jumped to its note (see <c>JournalTab</c>).</summary>
    [Parameter] public bool Highlighted { get; set; }

    /// <summary>
    /// A new (positive) number puts the focus on the card after it rendered, which scrolls it into view; 0 asks for
    /// nothing.
    /// </summary>
    [Parameter] public int FocusRequest { get; set; }

    /// <summary>The button is offered while the AI is ready and there is a book to place the note in.</summary>
    private bool WhereToAvailable => State is { Session: { } session, CurrentBook: not null } && session.Relevance.IsAvailable;

    private string Origin => Note.Date is { } date
        ? date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)
        : Note.Page.Name;

    /// <summary>Lines of the note's text and all its sub-bullets.</summary>
    private int LineCount =>
        Lines(Note.Block.Content) + Descendants(Note.Block, 1).Sum(entry => Lines(entry.Block.Content));

    /// <summary>
    /// A note can be adopted into the current book: it is safely readable (R13: adopting from a read-only page
    /// throws before any change) and so is the book page.
    /// </summary>
    private bool CanAdopt =>
        State is { Session: not null, CurrentBook.Page.IsReadOnly: false } && !Note.Page.IsReadOnly;

    /// <summary>
    /// The list belongs to one note, session and book: when any of them changes (the card is reused for another note, a
    /// book switch) it is closed and a request still running is dropped.
    /// </summary>
    protected override void OnParametersSet()
    {
        var sessionChanged = TrackSession();
        var bookChanged = (_whereTo is not null || _whereBusy)
            && !string.Equals(State.CurrentBook?.LinkName, _whereBookName, StringComparison.OrdinalIgnoreCase);
        if (sessionChanged || bookChanged || Note.Key != _whereNoteKey)
        {
            _whereGeneration++;
            _whereTo = null;
            _whereBusy = false;
            _whereNoteKey = Note.Key;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRequest > 0 && FocusRequest != _focused)
        {
            _focused = FocusRequest;
            await _root.FocusAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _whereGeneration++;
        Unsubscribe();
    }

    /// <summary>Follows the AI status of the current session: the button appears when the AI becomes ready.</summary>
    private bool TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return false;
        }

        Unsubscribe();
        _session = State.Session;
        if (_session is not null)
        {
            _session.AiStatusChanged += OnAiStatusChanged;
        }

        return true;
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.AiStatusChanged -= OnAiStatusChanged;
        }
    }

    private void OnAiStatusChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    private static int Lines(string text) => text.Count(c => c == '\n') + 1;

    private static IEnumerable<(Block Block, int Depth)> Descendants(Block block, int depth) =>
        block.Children.SelectMany(child => Descendants(child, depth + 1).Prepend((child, depth)));

    private void OnDragStart() => State.DraggedNoteKey = Note.Key;

    private void OnDragEnd() => State.DraggedNoteKey = null;

    private void OpenInLogseq()
    {
        if (State.Session is not { } session)
        {
            return;
        }

        var graph = Uri.EscapeDataString(Path.GetFileName(Path.TrimEndingDirectorySeparator(session.Vault.Root)));
        var target = Note.Block.Id is { } id
            ? $"block-id={Uri.EscapeDataString(id.ToString("D"))}"
            : $"page={Uri.EscapeDataString(Note.Page.Name)}";
        Platform.OpenExternal($"logseq://graph/{graph}?{target}");
    }

    /// <summary>
    /// Goes to the place where the note is used: the book of its first <c>used-in::</c> entry with a block
    /// reference (else its first entry), where the editor reveals that block (an entry without a block, or a block that
    /// is not found, only switches the book).
    /// </summary>
    private void GoToUsage()
    {
        if (State.Session is not { } session)
        {
            return;
        }

        var usages = Note.Usages;
        var entry = usages.FirstOrDefault(u => u.BookBlockId is not null) ?? usages.FirstOrDefault();
        if (entry is null || session.Vault.FindBook(entry.PageName) is not { } book)
        {
            return;
        }

        var sameBook = string.Equals(State.CurrentBook?.LinkName, book.LinkName, StringComparison.OrdinalIgnoreCase);
        var target = entry.BookBlockId is { } blockId ? TargetOf(book.Root, blockId) : null;
        State.CurrentBook = book;
        if (target is { } key)
        {
            State.RevealElement(key);
        }
        else if (!sameBook)
        {
            State.CurrentSectionKey = book.Root.Key;
            State.Cursor = null;
        }

        State.Notify();
    }

    /// <summary>
    /// Lists the sections of the current book that fit the note best (or closes the list). The note's text and the book
    /// snapshot are taken here on the UI thread; only the embedding and comparing run in the background (the vault model
    /// is not thread-safe), and the section titles are read from that same snapshot.
    /// </summary>
    private async Task ToggleWhereToAsync()
    {
        var generation = ++_whereGeneration;
        if (_whereTo is not null || _whereBusy)
        {
            _whereTo = null;
            _whereBusy = false;
            return;
        }

        if (State is not { Session: { } session, CurrentBook: { } book })
        {
            return;
        }

        _whereBookName = book.LinkName;
        var noteKey = Note.Key;
        var noteText = EmbeddingText.ForNote(Note);
        var relevance = session.Relevance;
        _whereBusy = true;
        IReadOnlyList<SectionHit> hits;
        try
        {
            hits = await Task.Run(() => relevance.WhereTo(noteKey, noteText, book, WhereToLimit));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Finding the sections for a note failed");
            hits = [];
        }

        if (_disposed || generation != _whereGeneration)
        {
            return;
        }

        var best = hits.Count > 0 ? hits.Max(hit => hit.Score) : 0;
        _whereTo = new WhereToResult(book, [.. hits
            .Where(hit => book.FindNode(hit.SectionKey) is not null)
            .Select(hit => (hit.SectionKey, SectionTitle(book, book.FindNode(hit.SectionKey)!), SearchTab.Percent(hit.Score, best)))]);
        _whereBusy = false;
    }

    private static string SectionTitle(Book book, OutlineNode section) => section.Level == 0 ? book.Title : section.Title;

    /// <summary>
    /// Goes to a section of the list: the editor saves first, then the book (if the current one changed since) is
    /// selected and the editor reveals the section's heading (the book root: the start of the book).
    /// </summary>
    private async Task GoToSectionAsync(Guid sectionKey)
    {
        if (_whereTo is not { } result || State.Session is not { } session)
        {
            return;
        }

        try
        {
            if (State.FlushEditor is { } flush)
            {
                await flush();
            }
        }
        catch (Exception ex)
        {
            // The text may not be saved, so the view stays where it is.
            Logger.LogError(ex, "Saving the editor before going to a section failed");
            return;
        }

        if (_disposed || !ReferenceEquals(session, State.Session))
        {
            return;
        }

        if (!string.Equals(State.CurrentBook?.LinkName, result.Book.LinkName, StringComparison.OrdinalIgnoreCase))
        {
            if (session.Vault.FindBook(result.Book.LinkName) is not { } book)
            {
                return;
            }

            State.CurrentBook = book;
        }

        if (State.CurrentBook?.FindNode(sectionKey) is null)
        {
            return;
        }

        State.RevealElement(sectionKey);
        State.Notify();
    }

    /// <summary>
    /// The key of the heading or text block with the id <paramref name="blockId"/>; for a paragraph (detail) the key of
    /// its text block.
    /// </summary>
    private static Guid? TargetOf(OutlineNode node, Guid blockId)
    {
        if (node.Block?.Id == blockId)
        {
            return node.Key;
        }

        if (node.TextBlocks.FirstOrDefault(text => text.Block.Id == blockId || text.Paragraphs.Any(p => p.Block.Id == blockId)) is { } textBlock)
        {
            return textBlock.Key;
        }

        return node.Children.Select(child => TargetOf(child, blockId)).FirstOrDefault(key => key is not null);
    }

    /// <summary>
    /// Adopts <paramref name="block"/> (the note itself or one of its sub-bullets) into the current book: after the
    /// text block under the cursor, else at the end of the current section (see <see cref="NoteAdoption"/>).
    /// </summary>
    private async Task AdoptAsync(Block block)
    {
        _message = null;
        _message = await NoteAdoption.AdoptAsync(
            State,
            block.Key,
            book => State.CursorTextBlockKey is { } cursor && book.FindTextBlock(cursor) is not null
                ? new InsertPosition.After(cursor)
                : new InsertPosition.SectionEnd(State.CurrentSectionKey),
            Logger);
    }
}
