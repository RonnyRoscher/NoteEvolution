@using Microsoft.JSInterop
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject UiSettings Settings
@inject IStringLocalizer<Strings> L
@inject ILogger<NoteCard> Logger
@inject IJSRuntime JS

@* One note of the notes pane: origin, score, usage mark, the block text with its sub-bullets. A click on a block makes
   it the active block: its range gets a frame and the bar with the actions (NoteBar) below. *@
@{
    // Only the card that was clicked is framed when the card on top shows the same note as a list.
    var range = State.ActiveNote is { } selection && selection.NoteKey == Note.Key && selection.InFocusedCard == Focused
        ? State.ActiveNoteRange
        : null;
}
<article @ref="_root" class="ne-note-card @(InDay ? "ne-note-in-day" : null) @(Highlighted ? "ne-note-highlight" : null)" tabindex="-1" data-note-key="@Note.Key">
    @if (!InDay)
    {
        <header class="ne-note-head">
            <span class="ne-note-origin">@Origin</span>
            @if (Percent is { } percent)
            {
                <span class="ne-note-score" title="@L["NoteScoreTitle"]">@percent %</span>
            }
            <ProgressDot Status="@State.Session?.NoteStatus(Note.Key)" Used="@Note.IsUsed" />
            <UsedMark Block="Note.Block" />
        </header>
    }
    @if (Note.ContextPath.Count > 0)
    {
        <div class="ne-note-context">@string.Join(" › ", Note.ContextPath)</div>
    }
    <div class="@BoxClass(range, Note.Block, "ne-note-body")">
        <div class="@BlockClass(range, Note.Block, UsedTextClass(Note.Block, "ne-note-text"))" @onclick="() => SelectAsync(Note.Block)">@Note.Block.Content</div>
        @* In a day the status marks stand at the right of the text; elsewhere they stay in the head. *@
        @if (InDay)
        {
            <div class="ne-note-marks">
                <ProgressDot Status="@State.Session?.NoteStatus(Note.Key)" Used="@Note.IsUsed" />
                <UsedMark Block="Note.Block" />
            </div>
        }
        @Bar(range, Note.Block, ownOnly: true)
        @if (InDay)
        {
            @Hint()
        }
        @SubBullets(range, Note.Block)
        @Bar(range, Note.Block, ownOnly: false)
    </div>
    @if (!InDay)
    {
        @Hint()
    }
</article>

@code {
    private ElementReference _root;
    private int _focused;
    private VaultSession? _session;
    private bool _disposed;

    [Parameter, EditorRequired] public NoteBlock Note { get; set; } = default!;

    /// <summary>The hit's score in percent of the best hit; <c>null</c> outside the search.</summary>
    [Parameter] public int? Percent { get; set; }

    /// <summary>The card is marked for a moment after a source jumped to its note (see <c>JournalTab</c>).</summary>
    [Parameter] public bool Highlighted { get; set; }

    /// <summary>
    /// The card stands in the card of its journal day (<c>JournalTab</c>), which shows the date, the day's marks and opens
    /// the page in Logseq: drawn as a box with the line on its left, without an origin; its status marks stand at the right
    /// of its text.
    /// </summary>
    [Parameter] public bool InDay { get; set; }

    /// <summary>
    /// A new (positive) number puts the focus on the card after it rendered, which scrolls it into view; 0 asks for
    /// nothing.
    /// </summary>
    [Parameter] public int FocusRequest { get; set; }

    /// <summary>The card stands on top of the notes pane (<see cref="AppState.FocusedNoteKey"/>), apart from the lists.</summary>
    [Parameter] public bool Focused { get; set; }

    private string Origin => Note.Date is { } date
        ? date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)
        : Note.Page.Name;

    protected override void OnParametersSet() => TrackSession();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusRequest > 0 && FocusRequest != _focused)
        {
            _focused = FocusRequest;
            try
            {
                await _root.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or InvalidOperationException)
            {
                // The focus is only a help for the keyboard (the card may be gone or the window closing).
                Logger.LogDebug(ex, "Focusing the note card failed");
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Unsubscribe();
    }

    /// <summary>Follows the status of the current session's notes: the status dot changes with it.</summary>
    private void TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return;
        }

        Unsubscribe();
        _session = State.Session;
        if (_session is not null)
        {
            _session.AiStatusChanged += OnStatusChanged;
            _session.NoteStatusChanged += OnStatusChanged;
        }
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.AiStatusChanged -= OnStatusChanged;
            _session.NoteStatusChanged -= OnStatusChanged;
        }
    }

    private void OnStatusChanged() => _ = InvokeAsync(() =>
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    /// <summary>
    /// Makes <paramref name="block"/> the active note block (Review Focus 4): not when the click marked text in the notes
    /// pane, so marking and copying stay possible. If the page cannot tell, the click counts as one without a marking.
    /// </summary>
    private async Task SelectAsync(Block block)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("neNotes.hasSelection"))
            {
                return;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Reading the text selection failed");
        }

        if (!_disposed)
        {
            State.SelectNoteBlock(Note.Key, block.Key, Focused);
        }
    }

    /// <summary>The hint that a read-only note cannot be adopted.</summary>
    private RenderFragment Hint() =>
        @<text>
            @if (Note.Page.IsReadOnly)
            {
                <div class="ne-note-hint">@L["NoteReadOnlyHint"]</div>
            }
        </text>;

    /// <summary>
    /// The bar of <paramref name="range"/> if <paramref name="block"/> is its head: right below the head's own row for the
    /// block alone (<paramref name="ownOnly"/>), else at the end of the head's box, below the last block of the range.
    /// </summary>
    private RenderFragment Bar(NoteRange? range, Block block, bool ownOnly) =>
        @<text>
            @if (range is { } r && r.HeadKey == block.Key && r.OwnOnly == ownOnly)
            {
                <NoteBar Note="Note" Range="r" Changed="StateHasChanged" />
            }
        </text>;

    /// <summary>
    /// The class of a block's own row: <paramref name="rowClass"/>, the class every clickable block has, and the frame's
    /// mark while it is in <paramref name="range"/>; for the block alone (level −1) the row is the frame itself.
    /// </summary>
    private static string BlockClass(NoteRange? range, Block block, string rowClass)
    {
        var css = $"{rowClass} ne-note-block";
        if (range is { } r && r.Keys.Contains(block.Key))
        {
            css += r.OwnOnly ? " ne-note-in-range ne-note-range-frame" : " ne-note-in-range";
        }

        return css;
    }

    /// <summary>The class of a block's text: <paramref name="textClass"/>, and greyed if the block is used (own or inherited usage).</summary>
    private static string UsedTextClass(Block block, string textClass) => UsedMark.IsUsed(block) ? $"{textClass} ne-note-used-text" : textClass;

    /// <summary>The class of a block's box (its row and its sub-points): <paramref name="boxClass"/>, framed while it holds the whole range.</summary>
    private static string BoxClass(NoteRange? range, Block block, string boxClass) =>
        range is { OwnOnly: false } r && r.HeadKey == block.Key ? $"{boxClass} ne-note-range-frame" : boxClass;

    /// <summary>
    /// The sub-bullets of <paramref name="parent"/>, each as a box with the line on its left: its own row (text and usage
    /// mark) and the boxes of all its sub-blocks; with "Verwendete ausblenden" a used one is left out with all below it
    /// (<see cref="NoteBlock.IsHiddenWhenUsedHidden"/>: not one adopted without its sub-points while one of them is shown).
    /// </summary>
    private RenderFragment SubBullets(NoteRange? range, Block parent) =>
        @<text>
            @foreach (var child in parent.Children.Where(child => !(Settings.HideUsed && NoteBlock.IsHiddenWhenUsedHidden(child))))
            {
                <div @key="child.Key" class="@BoxClass(range, child, "ne-note-child")">
                    <div class="@BlockClass(range, child, "ne-note-child-row")" @onclick="() => SelectAsync(child)">
                        <span class="@UsedTextClass(child, "ne-note-child-text")">@child.Content</span>
                        <UsedMark Block="child" />
                    </div>
                    @Bar(range, child, ownOnly: true)
                    @SubBullets(range, child)
                    @Bar(range, child, ownOnly: false)
                </div>
            }
        </text>;
}
