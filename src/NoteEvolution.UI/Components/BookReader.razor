@using Microsoft.JSInterop
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Repetitions
@using NoteEvolution.UI.Editor
@using NoteEvolution.UI.State
@inject IJSRuntime JS

@* The whole book read-only (repetitions tab spec 4): headings and text blocks in book order without the appendix. Compared
   blocks show their literal repetitions underlined (with the switch „Wiederholungen zeigen“ on); the side of the current
   hit is highlighted and scrolled to. Renders again only for a new revision, another hit or the switch, so the tab's other
   changes do not redraw the book; scrolls only for another hit or side, so a new analysis result with the same hit leaves
   the reader where the user scrolled it. *@
<div class="ne-reader" @ref="_container">
    @foreach (var item in Book.Root.Items)
    {
        @RenderItem(item)
    }
</div>

@code {
    private ElementReference _container;
    private bool _rendered;
    private int _renderedRevision;
    private (RepetitionKind, Guid, Guid)? _renderedHit;
    private Guid? _renderedSide;
    private bool _renderedUnderline;
    private bool _scrolled;
    private (RepetitionKind, Guid, Guid)? _scrolledHit;
    private Guid? _scrolledSide;

    /// <summary>The reader's scrolling element (for the viewport frame of the minimap); valid after the first render.</summary>
    public ElementReference Container => _container;

    [Parameter, EditorRequired] public Book Book { get; set; } = default!;

    [Parameter, EditorRequired] public RepetitionSet Set { get; set; } = RepetitionSet.Empty;

    /// <summary>The current repetition of the tab; its <see cref="Side"/> is highlighted.</summary>
    [Parameter] public Repetition? Current { get; set; }

    /// <summary>The block of the current repetition that is highlighted and scrolled to.</summary>
    [Parameter] public Guid? Side { get; set; }

    /// <summary>The new state of the book: a different value means the book or its repetitions changed.</summary>
    [Parameter] public int Revision { get; set; }

    /// <summary>Whether the repetitions are underlined (the switch „Wiederholungen zeigen“); the current hit is highlighted anyway.</summary>
    [Parameter] public bool Underline { get; set; } = true;

    /// <summary>
    /// The identity of the current hit. A new analysis result builds the same hit anew (new lists, so not equal as a
    /// record); its new marks come with the new <see cref="Revision"/>.
    /// </summary>
    private (RepetitionKind, Guid, Guid)? Hit => Current is { } current ? (current.Kind, current.A, current.B) : null;

    protected override bool ShouldRender() =>
        !_rendered || Revision != _renderedRevision || Hit != _renderedHit || Side != _renderedSide
        || Underline != _renderedUnderline;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _rendered = true;
        _renderedRevision = Revision;
        _renderedHit = Hit;
        _renderedSide = Side;
        _renderedUnderline = Underline;

        if (_scrolled && Hit == _scrolledHit && Side == _scrolledSide)
        {
            return;
        }

        _scrolled = true;
        _scrolledHit = Hit;
        _scrolledSide = Side;
        if (Side is { } side)
        {
            await JS.InvokeVoidAsync("neLayout.scrollReaderTo", _container, $"ne-reader-{side}");
        }
    }

    private RenderFragment RenderItem(BookItem item) => item switch
    {
        OutlineNode { AppendixKind: not AppendixKind.None } => @<text></text>,
        OutlineNode node => @<text>
            @if (node.Block is not null)
            {
                <div class="@($"ne-reader-heading ne-reader-h{node.Level}")">@node.Title</div>
            }
            @foreach (var child in node.Items)
            {
                @RenderItem(child)
            }
        </text>,
        TextBlock text => RenderBlock(text),
        _ => @<text></text>,
    };

    private RenderFragment RenderBlock(TextBlock text)
    {
        var compared = Set.Block(text.Key);
        var current = Side == text.Key;
        var css = "ne-reader-block" + (current ? " ne-rep-current-block" : "");
        return @<div class="@css" id="@($"ne-reader-{text.Key}")">
            @if (compared is not null)
            {
                <RepetitionText Block="compared" Spans="SpansOf(text.Key)" />
            }
            else
            {
                <p class="ne-rep-para"><EmphasizedText Text="@text.Text" /></p>
                @if (!BlockStatuses.IsExcluded(text.Status))
                {
                    foreach (var paragraph in text.ExportedParagraphs)
                    {
                        <p class="ne-rep-para" style="@($"margin-left: {paragraph.Depth * 24}px")"><EmphasizedText Text="@paragraph.Text" /></p>
                    }
                }
            }
        </div>;
    }

    /// <summary>
    /// The marks of a compared block: with <see cref="Underline"/> its open literal repetitions underlined; for the side
    /// of the current hit that hit's stretches highlighted (and, with <see cref="Underline"/>, underlined: semantic ones
    /// dotted, only for the current hit).
    /// </summary>
    private IReadOnlyList<(int Paragraph, int Start, int Length, RepetitionMarkKind Kind)> SpansOf(Guid key)
    {
        var spans = new List<(int Paragraph, int Start, int Length, RepetitionMarkKind Kind)>();
        foreach (var repetition in Set.Of(key).Where(r => Underline && r.Kind == RepetitionKind.Literal))
        {
            spans.AddRange(RepetitionMarks.Spans(repetition, key, Set)
                .Select(span => (span.Paragraph, span.Start, span.Length, RepetitionMarkKind.Literal)));
        }

        if (Current is { } current && Side == key)
        {
            var kind = current.Kind == RepetitionKind.Literal ? RepetitionMarkKind.Literal : RepetitionMarkKind.Semantic;
            foreach (var span in RepetitionMarks.Spans(current, key, Set))
            {
                if (Underline)
                {
                    spans.Add((span.Paragraph, span.Start, span.Length, kind));
                }

                spans.Add((span.Paragraph, span.Start, span.Length, RepetitionMarkKind.Current));
            }
        }

        return spans;
    }
}
