@using NoteEvolution.AI.Embeddings
@using NoteEvolution.AI.Relevance
@using NoteEvolution.Core.Assistants
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Storage
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject IStringLocalizer<Strings> L
@inject ILogger<HandledWizard> Logger

<Modal Title="@L["HandledTitle"]" CssClass="ne-handled" OnClose="OnClose">
<ChildContent>
    @if (_ran)
    {
        <p class="ne-handled-done" role="status">@(_failed > 0 ? L["HandledDoneFailed", _converted, _failed] : L["HandledDone", _converted])</p>
    }
    @if (State.Session is null)
    {
        <p>@L["LinkCheckNoVault"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="ne-handled-none">@L["HandledNone"]</p>
    }
    else
    {
        <p class="ne-dialog-hint">@L["HandledIntro"]</p>
        @if (_error is not null)
        {
            <p class="ne-dialog-error" role="alert">@_error</p>
        }
        <label class="ne-handled-book">
            @L["HandledBook"]
            <select class="ne-handled-book-select" value="@_bookName" disabled="@_confirming" @onchange="ChangeBook">
                @foreach (var book in State.Session.Vault.Books)
                {
                    <option value="@book.LinkName">@book.Title</option>
                }
            </select>
        </label>
        <ul class="ne-handled-list">
            @foreach (var note in _items)
            {
                var key = note.Key;
                <li class="ne-handled-item">
                    <label>
                        <input type="checkbox" checked="@_selected.Contains(key)" disabled="@(_confirming || note.Page.IsReadOnly)"
                               @onchange="e => Select(key, (bool)(e.Value ?? false))" />
                        <span class="ne-handled-text">@Excerpt.FirstLine(note.Block.Content)</span>
                        <span class="ne-handled-page">@note.Page.Name</span>
                        @if (note.Page.IsReadOnly)
                        {
                            <span class="ne-handled-readonly">@L["HandledReadOnly"]</span>
                        }
                    </label>
                    @if (_placeOptions.TryGetValue(key, out var places) && places.Count > 0)
                    {
                        <select class="ne-handled-place" aria-label="@L["HandledPlaceLabel"]" value="@PlaceValue(key)"
                                disabled="@(_confirming || note.Page.IsReadOnly)" @onchange="e => ChoosePlace(key, e.Value as string)">
                            <option value="">@L["HandledPlaceUnknown"]</option>
                            @foreach (var place in places)
                            {
                                <option value="@place.TextBlockKey.ToString("D")">@place.Label</option>
                            }
                        </select>
                    }
                    <div class="ne-handled-detail">
                        <details class="ne-handled-note" open>
                            <summary>@L["HandledNote"]</summary>
                            <div class="ne-handled-note-text">@NoteText(note.Block)</div>
                        </details>
                        @if (PreviewOf(key) is { } preview)
                        {
                            <div class="ne-handled-preview">
                                <div class="ne-handled-preview-path">@preview.Path</div>
                                <div class="ne-handled-preview-text">@preview.Text</div>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (_confirming)
        {
            <p class="ne-handled-confirm-text" role="alert">@L["HandledConfirm", _selected.Count, BookTitle]</p>
        }
    }
    </ChildContent>
    <Footer>
        @if (_items.Count > 0 && State.Session is not null)
        {
            @if (_confirming)
            {
                <button type="button" class="ne-handled-yes" disabled="@_busy" @onclick="ConvertAsync">@L["HandledConfirmYes"]</button>
                <button type="button" class="ne-handled-no" disabled="@_busy" @onclick="() => _confirming = false">@L["Cancel"]</button>
            }
            else
            {
                <button type="button" class="ne-handled-convert" disabled="@(_selected.Count == 0 || _bookName is null || _placesPending)"
                        @onclick="() => _confirming = true">@L["HandledConvert"]</button>
            }
        }
        <button type="button" class="ne-handled-close" disabled="@_busy" @onclick="OnClose">@L["Close"]</button>
    </Footer>
</Modal>

@code {
    private IReadOnlyList<NoteBlock> _items = [];
    private readonly HashSet<Guid> _selected = [];
    private string? _bookName;
    private bool _confirming;
    private bool _busy;
    private string? _error;

    /// <summary>Whether a conversion ran in this dialog, and how many notes it converted / could not convert.</summary>
    private bool _ran;
    private int _converted;
    private int _failed;

    /// <summary>How many suggested places each note gets.</summary>
    private const int PlacementLimit = 3;

    /// <summary>The longest text excerpt of a suggested place.</summary>
    private const int ExcerptLength = 60;

    /// <summary>The suggested places per note (key of the note), computed for the chosen book; empty without AI.</summary>
    private Dictionary<Guid, List<PlaceOption>> _placeOptions = [];

    /// <summary>The place the user chose per note (key of the note): a text block of the chosen book. Absent: place unknown.</summary>
    private readonly Dictionary<Guid, Guid> _placeChoice = [];

    private CancellationTokenSource? _placePending;
    private int _placeGeneration;
    private bool _disposed;

    /// <summary>Whether suggestions are being computed: "Umwandeln" waits, so a checked note never goes in with a place not yet carried over.</summary>
    private bool _placesPending;

    private sealed record PlaceOption(Guid TextBlockKey, string Label);

    [Parameter] public EventCallback OnClose { get; set; }

    private string BookTitle => State.Session?.Vault.FindBook(_bookName ?? "")?.Title ?? "";

    protected override void OnInitialized()
    {
        if (State.Session is not { } session)
        {
            return;
        }

        // Nothing is checked at first: the user picks the notes to convert (a chosen place checks its note).
        _items = session.Handled.Find();

        _bookName = State.CurrentBook?.LinkName ?? session.Vault.Books.FirstOrDefault()?.LinkName;
        StartPlacements();
    }

    public void Dispose()
    {
        _disposed = true;
        _placeGeneration++;
        _placePending?.Cancel();
        _placePending?.Dispose();
    }

    private void ChangeBook(ChangeEventArgs e)
    {
        _bookName = e.Value as string;
        StartPlacements();
    }

    private string PlaceValue(Guid noteKey) =>
        _placeChoice.TryGetValue(noteKey, out var textBlockKey) ? textBlockKey.ToString("D") : "";

    private void ChoosePlace(Guid noteKey, string? value)
    {
        if (Guid.TryParse(value, out var textBlockKey) && _placeOptions.GetValueOrDefault(noteKey)?.Any(p => p.TextBlockKey == textBlockKey) == true)
        {
            _placeChoice[noteKey] = textBlockKey;
            _selected.Add(noteKey);
        }
        else
        {
            _placeChoice.Remove(noteKey);
            _selected.Remove(noteKey);
        }
    }

    /// <summary>
    /// Suggests places in the chosen book for the notes, if the AI is available: forgets the places of the previous book
    /// and computes them in the background (latest wins). The notes' texts and the book snapshot are taken here on the
    /// UI thread, since the vault model is not thread-safe; the labels are read from that snapshot.
    /// </summary>
    private void StartPlacements(IReadOnlyDictionary<Guid, Guid>? keepChoices = null)
    {
        _placeGeneration++;
        _placePending?.Cancel();
        _placePending?.Dispose();
        _placePending = null;
        _placeOptions = [];
        _placeChoice.Clear();
        _placesPending = false;
        if (State.Session is not { } session || !session.Relevance.IsAvailable || session.Vault.FindBook(_bookName ?? "") is not { } book)
        {
            return;
        }

        var requests = _items.Where(n => !n.Page.IsReadOnly).Select(n => (n.Key, Text: EmbeddingText.ForNote(n))).ToList();
        var source = _placePending = new CancellationTokenSource();
        _placesPending = true;
        _ = ComputePlacementsAsync(session.Relevance, book, requests, keepChoices, _placeGeneration, source.Token);
    }

    private async Task ComputePlacementsAsync(
        IRelevanceService relevance, Book book, List<(Guid Key, string Text)> requests,
        IReadOnlyDictionary<Guid, Guid>? keepChoices, int generation, CancellationToken cancel)
    {
        try
        {
            var found = await Task.Run(
                () =>
                {
                    var hits = new List<(Guid Key, IReadOnlyList<PlacementHit> Hits)>();
                    foreach (var (key, text) in requests)
                    {
                        cancel.ThrowIfCancellationRequested();
                        hits.Add((key, relevance.Placements(key, text, book, PlacementLimit)));
                    }

                    return hits;
                },
                cancel);
            await InvokeAsync(() =>
            {
                if (_disposed || generation != _placeGeneration)
                {
                    return;
                }

                _placesPending = false;
                _placeOptions = found
                    .Where(entry => entry.Hits.Count > 0)
                    .ToDictionary(entry => entry.Key, entry => PlaceOptions(book, entry.Hits));
                foreach (var (noteKey, textBlockKey) in keepChoices ?? new Dictionary<Guid, Guid>())
                {
                    // A choice made before a run stays if its place is still suggested.
                    if (_placeOptions.GetValueOrDefault(noteKey)?.Any(p => p.TextBlockKey == textBlockKey) == true)
                    {
                        _placeChoice[noteKey] = textBlockKey;
                    }
                }

                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            // The suggestions are an aid: without them every place stays unknown.
            Logger.LogWarning(ex, "Computing the places for [handled] notes failed");
            await InvokeAsync(() =>
            {
                if (!_disposed && generation == _placeGeneration)
                {
                    _placesPending = false;
                    StateHasChanged();
                }
            });
        }
    }

    /// <summary>The excerpt of each text block and its score in percent of the best hit's.</summary>
    private static List<PlaceOption> PlaceOptions(Book book, IReadOnlyList<PlacementHit> hits)
    {
        var best = hits.Max(hit => hit.Score);
        return
        [
            .. hits
                .Where(hit => book.FindTextBlock(hit.TextBlockKey) is not null)
                .Select(hit => new PlaceOption(
                    hit.TextBlockKey,
                    $"{Excerpt.FirstLine(book.FindTextBlock(hit.TextBlockKey)!.Text, ExcerptLength)} – {SearchTab.Percent(hit.Score, best)} %")),
        ];
    }

    /// <summary>The longest text of the chosen place that is shown.</summary>
    private const int PreviewLength = 400;

    private sealed record Preview(string Path, string Text);

    /// <summary>The text and section path of the place chosen for the note, from the chosen book; none for an unknown place.</summary>
    private Preview? PreviewOf(Guid noteKey)
    {
        if (!_placeChoice.TryGetValue(noteKey, out var textBlockKey)
            || State.Session?.Vault.FindBook(_bookName ?? "")?.FindTextBlock(textBlockKey) is not { } textBlock)
        {
            return null;
        }

        var text = textBlock.Text.Trim();
        return new Preview(HeadingPath(textBlock.Section), text.Length <= PreviewLength ? text : text[..(PreviewLength - 1)] + "…");
    }

    /// <summary>The titles from the book's top level down to <paramref name="section"/>, joined; empty for the root (prologue).</summary>
    private static string HeadingPath(OutlineNode section)
    {
        var titles = new List<string>();
        for (var node = section; node is { Level: > 0 }; node = node.Parent)
        {
            titles.Add(node.Title);
        }

        titles.Reverse();
        return string.Join(" / ", titles);
    }

    /// <summary>The content of a note block and, indented, of its sub-points.</summary>
    private static RenderFragment NoteText(Block block) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "ne-handled-note-line");
        builder.AddContent(2, block.Content);
        builder.CloseElement();
        if (block.Children.Count > 0)
        {
            builder.OpenElement(3, "div");
            builder.AddAttribute(4, "class", "ne-handled-note-children");
            foreach (var child in block.Children)
            {
                builder.AddContent(5, NoteText(child));
            }

            builder.CloseElement();
        }
    };

    private void Select(Guid key, bool on)
    {
        if (on)
        {
            _selected.Add(key);
        }
        else
        {
            _selected.Remove(key);
        }
    }

    /// <summary>
    /// Converts the selected notes (R26): the editor saves first, nothing is written for a page with an open conflict,
    /// and a failure leaves the pages as their files are. The notes are looked up again, since a page may have been
    /// reloaded after an external change since the list was made.
    /// </summary>
    private async Task ConvertAsync()
    {
        if (_busy || State.Session is not { } session)
        {
            return;
        }

        _busy = true;
        _error = null;
        _ran = false;
        _converted = 0;
        _failed = 0;
        try
        {
            try
            {
                if (State.FlushEditor is { } flush)
                {
                    await flush();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Saving the editor before converting [handled] notes failed");
                _error = L["AssistantFlushFailed"];
                return;
            }

            if (!ReferenceEquals(session, State.Session) || session.Vault.FindBook(_bookName ?? "") is not { } book)
            {
                _error = L["AssistantStale"];
                return;
            }

            var notes = session.Handled.Find().Where(n => _selected.Contains(n.Key)).ToList();
            var pages = notes.Where(n => !n.Page.IsReadOnly).Select(n => n.Page).Distinct().ToList();
            var placements = notes
                .Where(n => !n.Page.IsReadOnly && _placeChoice.ContainsKey(n.Key))
                .ToDictionary(n => n.Key, n => _placeChoice[n.Key]);
            if (placements.Count > 0)
            {
                // A confirmed place changes the book page too (id:: and source::).
                pages.Add(book.Page);
            }

            if (pages.Any(p => session.HasOpenConflict(p.FilePath)))
            {
                _error = L["AssistantConflict"];
                _confirming = false;
                return;
            }

            // Note by note, so that a note that cannot be converted (its page cannot be written, its place vanished) leaves
            // the others converted: it stays in the list. The note and the book are looked up anew each time: a failed save
            // replaces the page in the vault, and a stale snapshot would be written to a detached page.
            var converted = 0;
            var failed = notes.Count(n => n.Page.IsReadOnly);
            foreach (var key in notes.Where(n => !n.Page.IsReadOnly).Select(n => n.Key).ToList())
            {
                var note = session.Handled.Find().FirstOrDefault(n => n.Key == key);
                var current = session.Vault.FindBook(_bookName ?? "");
                if (note is null || current is null)
                {
                    failed++;
                    continue;
                }

                try
                {
                    converted += session.Handled.Apply([note], current, placements).Converted;
                }
                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
                {
                    // What was saved before the failure stays saved; the pages left unsaved are taken from their files again.
                    Logger.LogWarning(ex, "Converting a [handled] note failed");
                    failed++;
                    foreach (var page in new[] { note.Page, current.Page }.Distinct().Where(p => p.IsDirty).ToList())
                    {
                        PageReload.FromDisk(session, page);
                    }

                    _error = ex switch
                    {
                        FileChangedExternallyException => L["AssistantExternalChange"],
                        ArgumentException => L["HandledPlacementFailed"],
                        _ => L["HandledFailed"],
                    };
                }
            }

            _ran = converted > 0 || failed > 0;
            _converted = converted;
            _failed = failed;
            _confirming = false;
            UpdateSearch(session, pages);
            _items = session.Handled.Find();
            var remaining = _items.Select(n => n.Key).ToHashSet();
            _selected.IntersectWith(remaining);

            if (placements.Count > 0)
            {
                // The book page was linked into (or reloaded after a failure): the suggested places belong to the old
                // snapshot. The choices of the notes that are still listed are carried over where the place is still suggested.
                var keep = _placeChoice.Where(c => remaining.Contains(c.Key)).ToDictionary(c => c.Key, c => c.Value);
                StartPlacements(keep);
            }
        }
        finally
        {
            _busy = false;
            State.RefreshBook();
            State.Notify();
        }
    }

    private void UpdateSearch(VaultSession session, IEnumerable<Page> pages)
    {
        foreach (var page in pages)
        {
            try
            {
                session.Search.UpdatePage(session.Notes, page.FilePath);
            }
            catch (Exception ex)
            {
                // The index is an aid, rebuilt on opening; it must not hide the conversion.
                Logger.LogWarning(ex, "Updating the search index after converting [handled] notes failed");
            }
        }
    }
}
