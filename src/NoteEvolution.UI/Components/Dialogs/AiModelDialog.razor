@using NoteEvolution.AI.Model
@implements IDisposable
@inject AiRuntime Ai
@inject AppState State
@inject UiSettings Settings
@inject IPlatformServices Platform
@inject IStringLocalizer<Strings> L
@inject ILogger<AiModelDialog> Logger

@* The download starts only here, after the user confirmed it; it ends with the dialog (Cancel, or a vault switch). *@
<Modal Title="@L["AiModelTitle"]" CssClass="ne-ai-model-dialog">
    <ChildContent>
        <p class="ne-ai-model-text">@L["AiModelText"]</p>
        <div class="ne-ai-model-list" role="radiogroup">
            @foreach (var model in Ai.Models)
            {
                var candidate = model;
                <label class="ne-ai-model-option">
                    <input type="radio" name="ne-ai-model" checked="@(candidate.Id == Selected.Id)" disabled="@Busy"
                           @onchange="() => _selected = candidate" />
                    <span class="ne-ai-model-name">@candidate.DisplayName</span>
                    @if (Ai.ModelInstalled && candidate.Id == Ai.Model.Id)
                    {
                        <span class="ne-ai-model-active">@L["AiModelActive"]</span>
                    }
                    <span class="ne-ai-model-size">@L["AiModelOption", ModelSizes.Megabytes(candidate.TotalSize), ModelSizes.Gigabytes(candidate.MemoryEstimate)]</span>
                    @if (Note(candidate) is { } note)
                    {
                        <span class="ne-ai-model-note">@note</span>
                    }
                </label>
            }
        </div>
        <p class="ne-dialog-hint">@L["AiModelOffline"]</p>
        @if (Ai.ModelInstalled)
        {
            <p class="ne-dialog-hint ne-ai-switch-hint">@L["AiModelSwitchHint"]</p>
            @if (SwitchBlocked)
            {
                <p class="ne-dialog-error ne-ai-switch-conflict" role="alert">@L["AiModelSwitchConflict"]</p>
            }
        }
        @if (_progress is { } progress)
        {
            <progress class="ne-ai-progress" max="@progress.BytesTotal" value="@progress.BytesDone"></progress>
            <span class="ne-dialog-hint">@L["AiModelProgress", ModelSizes.Megabytes(progress.BytesDone), ModelSizes.Megabytes(progress.BytesTotal)]</span>
        }
        @if (_error is not null)
        {
            <p class="ne-dialog-error" role="alert">@L["AiModelDownloadFailed"] <span class="ne-ai-model-error">@_error</span></p>
        }
    </ChildContent>
    <Footer>
        @if (_download is not null)
        {
            <button type="button" class="ne-ai-cancel" @onclick="CancelDownload">@L["Cancel"]</button>
        }
        else if (!Ai.ModelInstalled)
        {
            <button type="button" class="ne-ai-download" disabled="@Busy" @onclick="LoadFirstAsync">@L["AiDownload"]</button>
            <button type="button" class="ne-ai-not-now" disabled="@Busy" @onclick="NotNowAsync">@L["AiNotNow"]</button>
        }
        else
        {
            <button type="button" class="ne-ai-switch" disabled="@(Busy || SwitchBlocked || Selected.Id == Ai.Model.Id)" @onclick="SwitchAsync">@L["AiSwitch"]</button>
            <button type="button" class="ne-ai-close" disabled="@Busy" @onclick="OnClose">@L["Close"]</button>
        }
    </Footer>
</Modal>

@code {
    /// <summary>The running download; <c>null</c> while none runs.</summary>
    private CancellationTokenSource? _download;

    private DownloadProgress? _progress;
    private string? _error;
    private ModelInfo? _selected;

    /// <summary>The download ended and <see cref="OnSwitch"/> runs: nothing can be started or changed meanwhile.</summary>
    private bool _switching;

    /// <summary>The dialog is done: the model was downloaded and activated, or the user chose "not now" or closed it.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// The selected model was downloaded while another model is installed; the owner makes it the active one (it closes
    /// the vault session first, as the embedder is replaced).
    /// </summary>
    [Parameter] public EventCallback<ModelInfo> OnSwitch { get; set; }

    /// <summary>The chosen model; the active one until the user chooses another.</summary>
    private ModelInfo Selected => _selected ?? Ai.Model;

    private bool Busy => _download is not null || _switching || Ai.IsDownloading;

    /// <summary>A conflict is open: the vault must not be opened again (R26), so the model cannot be switched.</summary>
    private bool SwitchBlocked => State.Session is { HasAnyOpenConflict: true };

    /// <summary>The note on the model (data of the app's catalog); none for a model without one.</summary>
    private string? Note(ModelInfo model)
    {
        var note = L["AiModelNote_" + model.Id];
        return note.ResourceNotFound ? null : note.Value;
    }

    /// <summary>No model is installed yet: the chosen one is downloaded, becomes the active model and is remembered.</summary>
    private async Task LoadFirstAsync()
    {
        var model = Selected;
        if (!await DownloadSelectedAsync(model))
        {
            return;
        }

        try
        {
            Ai.Activate(model);
            Settings.AiModelId = model.Id;
            SaveSettings();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Activating the AI model failed");
            _error = ex.Message;
            return;
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>Another model is installed: the chosen one is downloaded; the owner switches to it unless a conflict has opened meanwhile.</summary>
    private async Task SwitchAsync()
    {
        var model = Selected;
        if (Busy || SwitchBlocked || model.Id == Ai.Model.Id)
        {
            return;
        }

        if (!await DownloadSelectedAsync(model) || SwitchBlocked)
        {
            return;
        }

        _switching = true;
        try
        {
            await OnSwitch.InvokeAsync(model);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Switching the AI model failed");
            _error = ex.Message;
        }
        finally
        {
            _switching = false;
        }
    }

    /// <summary>Downloads <paramref name="model"/> and tells whether it worked (not when cancelled or failed; an error is shown).</summary>
    private async Task<bool> DownloadSelectedAsync(ModelInfo model)
    {
        if (_download is not null)
        {
            return false;
        }

        _error = null;
        _progress = new DownloadProgress(0, model.TotalSize);
        var download = _download = new CancellationTokenSource();
        try
        {
            await Ai.DownloadAsync(model, new Progress(this), download.Token);
            return true;
        }
        catch (OperationCanceledException) when (download.IsCancellationRequested)
        {
            // cancelled by the user (or by closing the dialog): nothing to report
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Downloading the AI model failed");
            _error = ex.Message;
            return false;
        }
        finally
        {
            _download = null;
            _progress = null;
            download.Dispose();
        }
    }

    /// <summary>Not now: the dialog no longer appears after opening a vault; the settings still offer the download.</summary>
    private async Task NotNowAsync()
    {
        Settings.AiModelDeclined = true;
        SaveSettings();
        await OnClose.InvokeAsync();
    }

    private void SaveSettings()
    {
        try
        {
            Settings.Save(Platform.UserDataDirectory);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Saving the UI settings failed");
        }
    }

    private void CancelDownload() => _download?.Cancel();

    public void Dispose() => CancelDownload();

    /// <summary>Shows the download's progress; reports come from the download's thread.</summary>
    private sealed class Progress(AiModelDialog dialog) : IProgress<DownloadProgress>
    {
        public void Report(DownloadProgress value) => _ = dialog.InvokeAsync(() =>
        {
            if (dialog._download is not null)
            {
                dialog._progress = value;
                dialog.StateHasChanged();
            }
        });
    }
}
