@using NoteEvolution.Core.Assistants
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Links
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Storage
@using NoteEvolution.Core.Vaults
@inject AppState State
@inject IStringLocalizer<Strings> L
@inject ILogger<SubPointLinkDialog> Logger

@* „Verknüpfungen der Unterpunkte nachtragen“ (spec 7.2), opened from the assistants menu: the preview counts the details
   that get a link to the sub-point they were copied from; „Nachtragen“ writes them as one undo step. *@
<Modal Title="@L["SubPointsTitle"]" CssClass="ne-subpoints" OnClose="OnClose">
<ChildContent>
    @if (State.Session is null)
    {
        <p>@L["LinkCheckNoVault"]</p>
    }
    else
    {
        @if (_error is not null)
        {
            <p class="ne-dialog-error" role="alert">@_error</p>
        }
        @if (_plan.Matches.Count == 0)
        {
            <p class="ne-subpoints-none">@(_plan.Unmatched > 0 ? L["SubPointsNoneUnmatched", _plan.Unmatched] : L["SubPointsNone"])</p>
            @if (_plan.PerBook.Count > 0)
            {
                <ul class="ne-subpoints-list">
                    @foreach (var book in _plan.PerBook)
                    {
                        <li class="ne-subpoints-book">@L["SubPointsBook", book.BookLinkName, book.Linked, book.Unmatched]</li>
                    }
                </ul>
            }
        }
        else
        {
            <p class="ne-dialog-hint">@L["SubPointsIntro"]</p>
            <p class="ne-subpoints-summary">@L["SubPointsSummary", _plan.Matches.Count, _plan.PerBook.Count(book => book.Linked > 0), _plan.Unmatched]</p>
            <ul class="ne-subpoints-list">
                @foreach (var book in _plan.PerBook)
                {
                    <li class="ne-subpoints-book">@L["SubPointsBook", book.BookLinkName, book.Linked, book.Unmatched]</li>
                }
            </ul>
        }
    }
</ChildContent>
<Footer>
    @if (State.Session is not null && _plan.Matches.Count > 0)
    {
        <button type="button" class="ne-subpoints-apply" disabled="@_busy" @onclick="ApplyAsync">@L["SubPointsApply"]</button>
    }
    <button type="button" class="ne-subpoints-close" disabled="@_busy" @onclick="OnClose">@L["Close"]</button>
</Footer>
</Modal>

@code {
    private SubPointPlan _plan = new([], []);
    private bool _busy;
    private string? _error;

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized()
    {
        if (State.Session is { } session)
        {
            _plan = new SubPointLinker(session.Vault, session.Links).Find();
        }
    }

    /// <summary>
    /// Writes the links (spec 7.2): the editor saves first, nothing is written while a page of the run has an open
    /// conflict, and a failure leaves the pages as their files are. The plan is made anew; if it differs from the
    /// preview the vault changed meanwhile, and nothing is written (the preview then shows the new plan).
    /// </summary>
    private async Task ApplyAsync()
    {
        if (_busy || State.Session is not { } session)
        {
            return;
        }

        _busy = true;
        _error = null;
        var wrote = false;
        try
        {
            try
            {
                if (State.FlushEditor is { } flush)
                {
                    await flush();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Saving the editor before adding sub-point links failed");
                _error = L["AssistantFlushFailed"];
                return;
            }

            if (!ReferenceEquals(session, State.Session))
            {
                _error = L["AssistantStale"];
                return;
            }

            var linker = new SubPointLinker(session.Vault, session.Links);
            var plan = linker.Find();
            var pages = plan.Matches.Concat(_plan.Matches)
                .Select(match => match.Book.Page)
                .Concat(plan.Matches.Concat(_plan.Matches).Select(match => session.Vault.FindBlockByKey(match.NoteBlockKey)?.Page).OfType<Page>())
                .Distinct()
                .ToList();
            if (pages.Any(page => session.HasOpenConflict(page.FilePath)))
            {
                _error = L["AssistantConflict"];
                return;
            }

            if (!SamePlan(plan, _plan))
            {
                // The vault changed since the preview: the user confirmed other numbers than would be written.
                _error = L["AssistantStale"];
                _plan = plan;
                return;
            }

            try
            {
                linker.Apply(plan);
                wrote = plan.Matches.Count > 0;
            }
            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
            {
                // What was saved before the failure stays saved; the pages left unsaved are taken from their files again.
                Logger.LogWarning(ex, "Adding sub-point links failed");
                wrote = true;
                foreach (var page in pages.Where(page => page.IsDirty).ToList())
                {
                    PageReload.FromDisk(session, page);
                }

                _error = ex is FileChangedExternallyException ? L["AssistantExternalChange"] : L["SubPointsFailed"];
                _plan = linker.Find();
                return;
            }

            UpdateSearch(session, pages.Where(page => !Book.IsBook(page)));
            _plan = new SubPointPlan([], []);
        }
        finally
        {
            _busy = false;
            if (wrote)
            {
                // Outline counts and the ✓ of the notes follow the new links.
                State.RefreshBook();
                State.NotifyNotesChanged();
                State.Notify();
            }
        }

        if (_error is null)
        {
            await OnClose.InvokeAsync();
        }
    }

    private static bool SamePlan(SubPointPlan a, SubPointPlan b) =>
        a.Matches.Select(Identity).ToHashSet().SetEquals(b.Matches.Select(Identity));

    private static (string Book, Guid Detail, Guid Note) Identity(SubPointMatch match) =>
        (match.Book.LinkName, match.DetailKey, match.NoteBlockKey);

    private void UpdateSearch(VaultSession session, IEnumerable<Page> pages)
    {
        foreach (var page in pages)
        {
            try
            {
                session.Search.UpdatePage(session.Notes, page.FilePath);
            }
            catch (Exception ex)
            {
                // The index is an aid, rebuilt on opening; it must not hide the links.
                Logger.LogWarning(ex, "Updating the search index after adding sub-point links failed");
            }
        }
    }
}
