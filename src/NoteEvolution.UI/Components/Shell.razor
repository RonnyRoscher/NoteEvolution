@using NoteEvolution.AI.Model
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Storage
@using NoteEvolution.UI.Components.Dialogs
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceProvider Services
@inject AppState State
@inject UiSettings Settings
@inject IPlatformServices Platform
@inject IClock Clock
@inject TimeProvider Time
@inject ILoggerFactory LoggerFactory
@inject IStringLocalizer<Strings> L

<div class="ne-shell" data-theme="@ThemeAttribute" style="--font-size: @(Settings.FontSizePt)pt; --line-width: @(Settings.LineWidthCh)ch;">
    <HeaderBar OnOpenVault="PickVaultAsync" OnPdfExport="() => Show(Dialog.Pdf)" OnLinkCheck="() => Show(Dialog.LinkCheck)"
               OnSettings="() => Show(Dialog.Settings)" OnHandledWizard="() => Show(Dialog.Handled)" OnDraftWizard="() => ShowDraft(null)"
               OnBookSelected="RememberBook" OnConvertPage="ShowDraft" />

    @if (_hintVisible)
    {
        <div class="ne-hint" role="status">
            <span>@L["LogseqHint"]</span>
            <button type="button" class="ne-hint-ok" @onclick="DismissHint">@L["HintOk"]</button>
        </div>
    }
    @if (_failedRoot is not null)
    {
        <div class="ne-error" role="alert">@L["VaultOpenFailed", _failedRoot]</div>
    }

    <main class="ne-main">
        <section class="ne-pane ne-outline @(Settings.OutlineCollapsed ? "collapsed" : null)" style="@PaneStyle(Settings.OutlineWidth, Settings.OutlineCollapsed)">
            <div class="ne-pane-head">
                @if (!Settings.OutlineCollapsed)
                {
                    <span class="ne-pane-title">@L["Outline"]</span>
                }
                <button type="button" class="ne-collapse" title="@(Settings.OutlineCollapsed ? L["Expand"] : L["Collapse"])"
                        @onclick="ToggleOutline">@(Settings.OutlineCollapsed ? "›" : "‹")</button>
            </div>
            @if (!Settings.OutlineCollapsed)
            {
                <OutlinePane />
            }
        </section>
        @if (!Settings.OutlineCollapsed)
        {
            <Splitter Width="Settings.OutlineWidth" WidthChanged="w => Settings.OutlineWidth = w" DragEnded="SaveSettings" />
        }

        <section class="ne-pane ne-editor" aria-label="@L["Editor"]">
            @if (_opening)
            {
                <div class="ne-placeholder">@L["VaultOpening"]</div>
            }
            else if (State.Session is null)
            {
                <div class="ne-welcome">
                    <p>@L["NoVaultOpen"]</p>
                    <button type="button" class="ne-open-vault" @onclick="PickVaultAsync">@L["OpenVault"]</button>
                </div>
            }
            else
            {
                <EditorPane />
            }
        </section>

        @if (!Settings.NotesCollapsed)
        {
            <Splitter Width="Settings.NotesWidth" WidthChanged="w => Settings.NotesWidth = w" DragEnded="SaveSettings" PaneOnRight="true" />
        }
        <section class="ne-pane ne-notes @(Settings.NotesCollapsed ? "collapsed" : null)" style="@PaneStyle(Settings.NotesWidth, Settings.NotesCollapsed)">
            <div class="ne-pane-head">
                <button type="button" class="ne-collapse" title="@(Settings.NotesCollapsed ? L["Expand"] : L["Collapse"])"
                        @onclick="ToggleNotes">@(Settings.NotesCollapsed ? "‹" : "›")</button>
                @if (!Settings.NotesCollapsed)
                {
                    <span class="ne-pane-title">@L["Notes"]</span>
                }
            </div>
            @if (!Settings.NotesCollapsed)
            {
                <NotesPane />
            }
        </section>
    </main>

    @switch (_dialog)
    {
        case Dialog.Pdf:
            <PdfExportDialog OnClose="CloseDialog" />
            break;
        case Dialog.LinkCheck:
            <LinkCheckDialog OnClose="CloseDialog" />
            break;
        case Dialog.Settings:
            <SettingsDialog OnClose="CloseDialog" OnNoteFoldersChanged="ReopenVaultAsync" />
            break;
        case Dialog.Handled:
            <HandledWizard OnClose="CloseDialog" />
            break;
        case Dialog.Draft:
            <DraftWizard OnClose="CloseDialog" InitialPage="_draftPage" OnConverted="OnDraftConverted" />
            break;
    }

    @* Above the other dialogs: it may be asked for from the settings, which stay open underneath. *@
    @if (_aiDialogOpen && _ai is not null)
    {
        <AiModelDialog OnClose="CloseAiDialog" OnSwitch="SwitchAiModelAsync" />
    }

    <ConflictDialog />
    <UndoToast />
</div>

@code {
    private ILogger _logger = default!;
    private VaultSession? _subscribed;
    private bool _opening;
    private bool _hintVisible;
    private string? _failedRoot;
    private Dialog _dialog;

    /// <summary>The page the draft assistant starts with (chosen in the book selection); null when opened from the menu.</summary>
    private Page? _draftPage;

    /// <summary>The app's AI runtime; <c>null</c> when none is registered (the AI is off).</summary>
    private AiRuntime? _ai;

    private bool _aiDialogOpen;

    /// <summary>The AI model dialog waits for the dialog shown after opening the vault (the link check) to close.</summary>
    private bool _aiDialogPending;

    private enum Dialog
    {
        None,
        Pdf,
        LinkCheck,
        Settings,
        Handled,
        Draft,
    }

    private void Show(Dialog dialog) => _dialog = dialog;

    private void CloseDialog()
    {
        _dialog = Dialog.None;
        if (_aiDialogPending)
        {
            _aiDialogPending = false;
            _aiDialogOpen = _ai is { ModelInstalled: false };
        }
    }

    private void CloseAiDialog() => _aiDialogOpen = false;

    /// <summary>
    /// The model dialog downloaded <paramref name="target"/>: it becomes the active model. The vault session shares the
    /// embedder that is replaced, so it is closed first (after the editor's text is saved into it) and opened again
    /// afterwards, with the remembered book. An exception of the activation reaches the dialog, which stays open and
    /// shows it; the vault is opened again in any case.
    /// </summary>
    private async Task SwitchAiModelAsync(ModelInfo target)
    {
        var session = State.Session;
        var root = session?.Vault.Root;
        if (session is not null)
        {
            if (State.FlushEditor is { } flush)
            {
                try
                {
                    await flush();
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Saving the editor's text before switching the AI model failed");
                }
            }

            // A conflict opened meanwhile (the flush yields, or its save found one): the vault must not be opened again
            // (R26), so nothing is switched; the dialog shows the conflict hint.
            if (session.HasAnyOpenConflict)
            {
                State.Notify();
                return;
            }

            if (_subscribed is not null)
            {
                _subscribed.PagesChanged -= OnPagesChanged;
            }

            State.Session = null;
            State.CurrentBook = null;
            _subscribed = null;
            session.Dispose();
        }

        try
        {
            _ai!.Activate(target);
            Settings.AiModelId = target.Id;
            SaveSettings();
            _aiDialogOpen = false;
        }
        finally
        {
            if (root is not null)
            {
                await OpenVaultAsync(root);
            }
            else
            {
                State.Notify();
            }
        }
    }

    /// <summary>Raised by whoever asks for the AI model dialog (the settings, the "Relevant" tab).</summary>
    private void OnAiModelDialogRequested() => _ = InvokeAsync(() =>
    {
        _aiDialogOpen = _ai is not null;
        StateHasChanged();
    });

    /// <summary>
    /// After a vault was opened: the model is offered once, unless the user said "not now" before (the settings still
    /// offer it). A dialog that is already shown (the link check) goes first.
    /// </summary>
    private void OfferAiModel()
    {
        if (_ai is not { ModelInstalled: false, IsDownloading: false } || Settings.AiModelDeclined || _aiDialogOpen)
        {
            return;
        }

        if (_dialog == Dialog.None)
        {
            _aiDialogOpen = true;
        }
        else
        {
            _aiDialogPending = true;
        }
    }

    private void ShowDraft(Page? page)
    {
        _draftPage = page;
        _dialog = Dialog.Draft;
    }

    /// <summary>A page was turned into a book: it becomes the current book and is remembered for the next start.</summary>
    private void OnDraftConverted(Page page)
    {
        if (State.Session?.Vault.Books.FirstOrDefault(b => ReferenceEquals(b.Page, page)) is not { } book)
        {
            return;
        }

        State.CurrentBook = book;
        State.CurrentSectionKey = book.Root.Key;
        State.CursorTextBlockKey = null;
        RememberBook(book);
        State.Notify();
    }

    private void RememberBook(Book book)
    {
        if (State.Session is { } session)
        {
            Settings.RememberBook(session.Vault.Root, book.Page.FilePath);
            SaveSettings();
        }
    }

    /// <summary>The note folders changed: the vault is opened again with them.</summary>
    private async Task ReopenVaultAsync()
    {
        if (State.Session is { } session)
        {
            await OpenVaultAsync(session.Vault.Root);
        }
    }

    private string? ThemeAttribute => Settings.Theme switch
    {
        ThemeChoice.Light => "light",
        ThemeChoice.Dark => "dark",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        _logger = LoggerFactory.CreateLogger<Shell>();
        _ai = Services.GetService<AiRuntime>();
        State.Changed += OnStateChanged;
        State.AiModelDialogRequested += OnAiModelDialogRequested;
        if (Settings.LastVault is { } last && Directory.Exists(last))
        {
            await OpenVaultAsync(last);
        }
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        State.AiModelDialogRequested -= OnAiModelDialogRequested;
        if (_subscribed is not null)
        {
            _subscribed.PagesChanged -= OnPagesChanged;
        }
    }

    private static string PaneStyle(double width, bool collapsed) =>
        collapsed ? "" : $"width: {width.ToString(CultureInfo.InvariantCulture)}px";

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task PickVaultAsync()
    {
        if (await Platform.PickFolderAsync() is { } root)
        {
            await OpenVaultAsync(root);
        }
    }

    /// <summary>
    /// Opens <paramref name="root"/> in the background and makes it the app's session, replacing the old one. The
    /// editor's pending text is saved into the old vault first, while the editor still shows it.
    /// </summary>
    private async Task OpenVaultAsync(string root)
    {
        if (State.FlushEditor is { } flush)
        {
            try
            {
                await flush();
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Saving the editor's text before opening {Root} failed", root);
            }
        }

        _opening = true;
        _failedRoot = null;
        _dialog = Dialog.None;
        StateHasChanged();
        try
        {
            var session = await VaultSession.OpenAsync(
                root, Clock, LoggerFactory.CreateLogger<VaultSession>(), Time, action => InvokeAsync(action), _ai);
            Activate(session);
            Settings.LastVault = root;
            _hintVisible = !Settings.LogseqHintShown;
            SaveSettings();
            if (session.StartupReport is { } report && (report.Missing.Count + report.Orphans.Count + report.Broken.Count) > 0)
            {
                _logger.LogInformation(
                    "Link check on opening: {Missing} missing, {Orphans} orphaned, {Broken} broken",
                    report.Missing.Count, report.Orphans.Count, report.Broken.Count);
                _dialog = Dialog.LinkCheck;
            }

            OfferAiModel();
        }
        catch (Exception ex)
        {
            // Whatever went wrong, the app stays usable; the details go to the log.
            _logger.LogError(ex, "Opening the vault {Root} failed", root);
            _failedRoot = root;
        }
        finally
        {
            _opening = false;
            State.Notify();
        }
    }

    private void Activate(VaultSession session)
    {
        var old = State.Session;
        if (_subscribed is not null)
        {
            _subscribed.PagesChanged -= OnPagesChanged;
        }

        session.PagesChanged += OnPagesChanged;
        _subscribed = session;
        State.Session = session;
        State.CurrentBook = BookChoices.Remembered(session.Vault, Settings.LastBookOf(session.Vault.Root))
            ?? BookChoices.Books(session.Vault).FirstOrDefault();
        State.CurrentSectionKey = State.CurrentBook?.Root.Key ?? Guid.Empty;
        State.CursorTextBlockKey = null;
        State.FocusedNoteKey = null;
        old?.Dispose();
    }

    /// <summary>Raised on the UI thread (the session dispatches through <c>InvokeAsync</c>).</summary>
    private void OnPagesChanged(string path)
    {
        State.RefreshBook();
        State.Notify();
    }

    private void DismissHint()
    {
        _hintVisible = false;
        Settings.LogseqHintShown = true;
        SaveSettings();
    }

    private void ToggleOutline()
    {
        Settings.OutlineCollapsed = !Settings.OutlineCollapsed;
        SaveSettings();
    }

    private void ToggleNotes()
    {
        Settings.NotesCollapsed = !Settings.NotesCollapsed;
        SaveSettings();
    }

    private void SaveSettings()
    {
        try
        {
            Settings.Save(Platform.UserDataDirectory);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _logger.LogWarning(ex, "Saving the UI settings failed");
        }
    }
}
