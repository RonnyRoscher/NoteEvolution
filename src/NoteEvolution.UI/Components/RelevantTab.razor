@using NoteEvolution.AI.Relevance
@using NoteEvolution.AI.Understanding
@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L
@inject ILogger<RelevantTab> Logger

@* The "Relevant" tab: the notes that fit the marked range (package B, spec 2) the user is working on. *@
<div class="ne-relevant">
    @if (State.Session is { } session)
    {
        var status = session.AiStatus;
        if (!session.Relevance.IsAvailable)
        {
            switch (status.State)
            {
                case AiState.ModelMissing:
                    <p class="ne-relevant-hint">@L["NotesRelevantModelMissing"]</p>
                    <button type="button" class="ne-relevant-download" @onclick="State.RequestAiModelDialog">@L["NotesRelevantDownload"]</button>
                    break;
                case AiState.Failed:
                    <p class="ne-relevant-hint" title="@status.Error">@L["NotesRelevantFailed"]</p>
                    break;
                case AiState.Off:
                    <p class="ne-relevant-hint">@L["NotesRelevantOff"]</p>
                    break;
                default:
                    <p class="ne-relevant-hint">@L["NotesRelevantPreparing"]</p>
                    break;
            }
        }
        else if (State.CurrentBook is null)
        {
            <p class="ne-relevant-hint">@L["NotesRelevantNoBook"]</p>
        }
        else
        {
            if (_computed && _hits.Count == 0 && _placed.Count == 0)
            {
                <div class="ne-search-empty">@L["NotesSearchEmpty"]</div>
            }

            <CascadingValue Name="FromRelevant" Value="true" IsFixed="true">
                <div class="ne-relevant-list">
                    @if (_placed.Count > 0)
                    {
                        <h4 class="ne-relevant-group-heading ne-relevant-group-placed">@L["NotesRelevantPlaced"]</h4>
                        @foreach (var placed in _placed)
                        {
                            if (session.Notes.Get(placed.Key) is { } placedNote)
                            {
                                <div @key="placed.Key" class="ne-relevant-placed-item" title="@PlacedTitle(placed)">
                                    @if (placed.Stale)
                                    {
                                        <span class="ne-relevant-stale">@L["NoteWhereToStale"]</span>
                                    }
                                    <NoteCard Note="placedNote" />
                                </div>
                            }
                        }

                        @if (_hits.Count > 0)
                        {
                            <h4 class="ne-relevant-group-heading ne-relevant-group-similar">@L["NotesRelevantSimilar"]</h4>
                        }
                    }

                    @foreach (var hit in _hits)
                    {
                        // Read live (not kept): a page replaced after an external change gives new views; keys may be stale.
                        if (session.Notes.Get(hit.Key) is { } note)
                        {
                            <NoteCard @key="hit.Key" Note="note" Percent="hit.Percent" />
                        }
                    }
                </div>
            </CascadingValue>
        }
    }
</div>

@code {
    /// <summary>
    /// The list is computed this long after the last change of what it depends on (R4: measured with the injected
    /// <see cref="TimeProvider"/>); the first computation does not wait.
    /// </summary>
    internal static readonly TimeSpan Debounce = TimeSpan.FromMilliseconds(1500);

    /// <summary>How many notes the tab shows.</summary>
    private const int Limit = 30;

    private VaultSession? _session;
    private CancellationTokenSource? _pending;
    private bool _disposed;

    /// <summary>Counts the requests; a result is only applied while its request is still the newest.</summary>
    private int _generation;

    /// <summary>
    /// Counts the changes of the index while the AI is ready (a page's notes embedded again under new keys): the list is
    /// computed again then. Progress during indexing is not counted; the tab does not wait for it.
    /// </summary>
    private int _indexVersion;

    private (VaultSession?, Book?, Guid, Guid?, bool, int, NoteFilter Filter, int, AiState, bool, int)? _last;
    private List<(Guid Key, int Percent)> _hits = [];

    /// <summary>The notes the model placed into the current section (newest first); they are not in <see cref="_hits"/>.</summary>
    private List<PlacedNote> _placed = [];

    private sealed record PlacedNote(Guid Key, string Reason, PlacementFit Fit, bool Stale);

    /// <summary>The notes in <see cref="_hits"/> only because their "Wohin damit?" list is open (see <see cref="WhereToPins"/>).</summary>
    private HashSet<Guid> _keptOnly = [];

    /// <summary>True once a result was applied for the current topic (to tell "nothing found" from "not computed yet").</summary>
    private bool _computed;

    /// <summary>
    /// True once the list stayed as it was because it was frozen (<see cref="Frozen"/>) or held
    /// (<see cref="AppState.RelevantHold"/>): the first refresh after that computes it again, also if nothing it depends
    /// on changed.
    /// </summary>
    private bool _heldBack;

    /// <summary>The notes that left the list while it was held (see <see cref="DropFilteredOut"/>).</summary>
    private readonly HashSet<Guid> _droppedWhileHeld = [];

    [Parameter, EditorRequired] public NoteFilter Filter { get; set; } = default!;

    /// <summary>Changes whenever the vault's pages or the session changed, so the notes are looked up again.</summary>
    [Parameter] public int Revision { get; set; }

    /// <remarks>
    /// The pane renders again on every <see cref="AppState.Changed"/>, which calls this: book, section, cursor and range
    /// level are read from <see cref="AppState"/> here, and a note kept only for its open "Wohin damit?" list goes once
    /// that list is closed.
    /// </remarks>
    protected override void OnParametersSet()
    {
        TrackSession();
        WhereToPins.Release(_hits, _keptOnly, hit => hit.Key, State.WhereToOpenNotes);
        Refresh();
    }

    /// <summary>
    /// Tells the session which notes the list shows (placed here first, then the similar ones): the background work
    /// computes their core statements and placement checks before those of other notes.
    /// </summary>
    private void ReportShown() =>
        State.Session?.SetShownNotes([.. _placed.Select(p => p.Key), .. _hits.Select(hit => hit.Key)]);

    public void Dispose()
    {
        _disposed = true;
        State.Session?.SetShownNotes([]);
        State.RelevantHold = null;
        Unsubscribe();
        _generation++;
        _pending?.Cancel();
        _pending?.Dispose();
    }

    private void TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return;
        }

        Unsubscribe();
        _session = State.Session;
        if (_session is not null)
        {
            _session.AiStatusChanged += OnAiStatusChanged;
            _session.PlacementsChanged += OnPlacementsChanged;
        }
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.AiStatusChanged -= OnAiStatusChanged;
            _session.PlacementsChanged -= OnPlacementsChanged;
        }
    }

    /// <summary>
    /// The stored placements changed: only the placed group is put together again, at once (it is read on the UI thread
    /// anyway); the similar notes stay, without the ones placed here now, and a search in flight goes on (its result is
    /// sorted the same way when it arrives). Nothing while the list is frozen or held or before the first computation.
    /// </summary>
    private void OnPlacementsChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed || _last is null || Frozen || State.RelevantHold is not null
            || State is not { Session: { Relevance.IsAvailable: true } session, CurrentBook: { } book })
        {
            return;
        }

        _placed = PlacedHere(session, book, Filter);
        var placedKeys = _placed.Select(p => p.Key).ToHashSet();
        _hits.RemoveAll(hit => placedKeys.Contains(hit.Key));
        ReportShown();
        StateHasChanged();
    });

    private void OnAiStatusChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        if (_session?.AiStatus.State == AiState.Ready)
        {
            _indexVersion++;
        }

        Refresh();
        StateHasChanged();
    });

    /// <summary>
    /// The list is frozen (status spec 4) while a note it shows has its "Wohin damit?" list open: it is not computed
    /// again, whatever changes (a jump to a hit, adopting), so the cards keep their order. A note that is gone (its page
    /// was read again, another session) no longer holds it.
    /// </summary>
    private bool Frozen =>
        _hits.Select(hit => hit.Key).Concat(_placed.Select(placed => placed.Key))
            .Any(key => State.WhereToOpenNotes.Contains(key) && State.Session?.Notes.Get(key) is not null);

    /// <summary>
    /// Ends the hold (<see cref="AppState.RelevantHold"/>) when the list is no longer to stay: the cursor left the area,
    /// another book, the filter changed, the AI went, a shown note is gone (its page was read again under new keys) or a
    /// note that left the list is back (the adoption was undone or its text deleted). While the editor has yet to reveal
    /// the adopted text the cursor does not count: loading the new document, it reports a place near the old cursor first.
    /// </summary>
    private void ReleaseHold()
    {
        if (State.RelevantHold is not { } hold)
        {
            return;
        }

        var stays = _last?.Filter == Filter && State is { Session.Relevance.IsAvailable: true, CurrentBook: { } book } && hold.IsFor(book)
                    && (State.PendingReveal == hold.RevealKey || hold.Covers(book, State.CurrentSectionKey))
                    && !ShownNoteGone() && !DroppedNoteBack();
        if (!stays)
        {
            State.RelevantHold = null;
            _droppedWhileHeld.Clear();
            _heldBack = true;
        }
    }

    private bool ShownNoteGone() =>
        _hits.Select(hit => hit.Key).Concat(_placed.Select(placed => placed.Key)).Any(key => State.Session?.Notes.Get(key) is null);

    private bool DroppedNoteBack() =>
        _droppedWhileHeld.Any(key => State.Session?.Notes.Get(key) is { } note && State.Session.Notes.Matches(note, Filter));

    /// <summary>While the list is held, only the notes the filter no longer lets through (the adopted one) leave it.</summary>
    private void DropFilteredOut(VaultSession session)
    {
        bool FilteredOut(Guid key)
        {
            var filteredOut = session.Notes.Get(key) is { } note && !session.Notes.Matches(note, Filter);
            if (filteredOut)
            {
                _droppedWhileHeld.Add(key);
            }

            return filteredOut;
        }

        _hits.RemoveAll(hit => FilteredOut(hit.Key));
        _placed.RemoveAll(placed => FilteredOut(placed.Key));
    }

    /// <summary>
    /// Starts a new computation if something the list depends on has changed since the last one; nothing while the list
    /// is frozen (<see cref="Frozen"/>) or held (<see cref="AppState.RelevantHold"/>), and once after it was, at once with
    /// the current state.
    /// </summary>
    private void Refresh()
    {
        ReleaseHold();
        if (Frozen)
        {
            _heldBack = true;
            return;
        }

        if (State is { RelevantHold: not null, Session: { } held })
        {
            DropFilteredOut(held);
            _heldBack = true;
            return;
        }

        var session = State.Session;
        var status = session?.AiStatus;
        var available = session?.Relevance.IsAvailable == true;
        var current = (session, State.CurrentBook, State.CurrentSectionKey, State.CursorTextBlockKey, State.CursorTextBlockKey is not null,
            State.RangeLevel, Filter, Revision, status?.State ?? AiState.Off, available, _indexVersion);
        if (_last == current && !_heldBack)
        {
            return;
        }

        var first = _last is null || _heldBack;
        _heldBack = false;
        _last = current;
        _computed = false;
        _generation++;
        _pending?.Cancel();
        _pending?.Dispose();
        _pending = null;
        if (!available || State.CurrentBook is null)
        {
            _hits = [];
            _placed = [];
            _keptOnly = [];
            ReportShown();
            return;
        }

        var source = _pending = new CancellationTokenSource();
        _ = ComputeAsync(_generation, first, source.Token);
    }

    private async Task ComputeAsync(int generation, bool immediately, CancellationToken cancel)
    {
        try
        {
            if (!immediately)
            {
                await Task.Delay(Debounce, Time, cancel);
            }

            // The vault model belongs to the UI thread: everything the background work needs is read here.
            (VaultSession Session, Book Book, TopicRequest Topic, HashSet<Guid> Allowed)? snapshot = null;
            await InvokeAsync(() => snapshot = TakeSnapshot());
            if (snapshot is null)
            {
                return;
            }

            var (session, book, topic, allowed) = snapshot.Value;
            var found = await Task.Run(() => session.Relevance.Relevant(topic, allowed.Contains, Limit), cancel);
            var best = found.Count > 0 ? found.Max(hit => hit.Score) : 0;
            await InvokeAsync(() =>
            {
                if (_disposed || generation != _generation)
                {
                    return;
                }

                // A list opened or a text adopted while this ran: the result is dropped, the list is computed after that.
                if (Frozen || State.RelevantHold is not null)
                {
                    _heldBack = true;
                    return;
                }

                // The placed group as the placements are now (they may have changed while the search ran).
                var placed = PlacedHere(session, book, Filter);
                var placedKeys = placed.Select(p => p.Key).ToHashSet();
                var hits = found.Where(hit => !placedKeys.Contains(hit.NoteBlockKey))
                    .Select(hit => (Key: hit.NoteBlockKey, Percent: SearchTab.Percent(hit.Score, best))).ToList();

                // The pins of package B (a card with an open "Wohin damit?" list stays where it is) have nothing to keep
                // here, as such a card freezes the list; they are kept as the common way of the tabs.
                (_hits, _keptOnly) = WhereToPins.Merge(_hits, hits, hit => hit.Key, State.WhereToOpenNotes);
                _placed = placed;
                _computed = true;
                ReportShown();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Computing the relevant notes failed");
        }
    }

    private (VaultSession, Book, TopicRequest, HashSet<Guid>)? TakeSnapshot()
    {
        if (_disposed || State is not { Session: { } session, CurrentBook: { } book })
        {
            return null;
        }

        var topic = TopicOf(book);
        var filter = Filter;
        var allowed = session.Notes.All()
            .Where(note => session.Notes.Matches(note, filter))
            .Select(note => note.Key)
            .ToHashSet();
        return (session, book, topic, allowed);
    }

    /// <summary>
    /// The unused top-level notes that match the filter and that the model placed into the current section or one of its
    /// sub-sections (by the verdict's section, or the section holding its "after" text block), newest first. UI thread only.
    /// </summary>
    private List<PlacedNote> PlacedHere(VaultSession session, Book book, NoteFilter filter)
    {
        if (book.FindNode(State.CurrentSectionKey) is not { } section)
        {
            return [];
        }

        var sections = new HashSet<Guid>();
        var textBlocks = new HashSet<Guid>();
        void Collect(OutlineNode node)
        {
            sections.Add(node.Key);
            textBlocks.UnionWith(node.TextBlocks.Select(tb => tb.Key));
            foreach (var child in node.Children)
            {
                Collect(child);
            }
        }

        Collect(section);
        var placed = new List<(NoteBlock Note, PlacedNote Entry)>();
        foreach (var note in session.Notes.All())
        {
            if (note.Block.Parent is not null || note.IsUsed || !session.Notes.Matches(note, filter)
                || session.Placement(note.Key) is not { } placement)
            {
                continue;
            }

            var verdict = placement.Verdict;
            if (sections.Contains(verdict.SectionKey) || (verdict.AfterTextBlockKey is { } after && textBlocks.Contains(after)))
            {
                placed.Add((note, new PlacedNote(note.Key, verdict.Reason, verdict.Fit, placement.Stale)));
            }
        }

        // Newest first (stable: file order within a day); undated notes last.
        return [.. placed.OrderByDescending(p => p.Note.Date ?? DateOnly.MinValue).Select(p => p.Entry)];
    }

    /// <summary>The tooltip of a placed note: the model's reason and how well it fits.</summary>
    private string PlacedTitle(PlacedNote placed) => $"{placed.Reason} ({L["NoteFit" + placed.Fit]})";

    /// <summary>
    /// What the list is about (package B, spec 2): at level 0 in a text block or detail (and without a range) that text
    /// block and its neighbours, at level −1 of a heading its own text blocks, at level −1 of a text block or detail only
    /// its own text; otherwise (a heading at level 0, any range at level ≥ 1) all text blocks of the range.
    /// </summary>
    private TopicRequest TopicOf(Book book)
    {
        var cursorTopic = new TopicRequest(book, State.CurrentSectionKey, State.CursorTextBlockKey, Manuscript: State.CursorTextBlockKey is not null);
        return State.CurrentRange switch
        {
            null or { Level: 0, Head.Kind: not ElementKind.Heading } => cursorTopic,
            { Level: -1, Head: { Kind: ElementKind.Heading } head } => new TopicRequest(book, head.Key, null, Manuscript: false),
            // The own text as the book holds it (a detail's without #notiz); the topic unescapes it (EmbeddingText.ForOwnText).
            { Level: -1, Head: { Kind: ElementKind.TextBlock } head } range =>
                new TopicRequest(book, range.SectionKey, null, Manuscript: false, OwnText: book.FindTextBlock(head.Key)!.Text),
            { Level: -1, Head: { } head } range =>
                new TopicRequest(book, range.SectionKey, null, Manuscript: false, OwnText: DetailOf(book, head).Text),
            { } range => new TopicRequest(book, range.SectionKey, null, Manuscript: false, RangeTextBlockKeys: range.TextBlockKeys),
        };
    }

    /// <summary>The paragraph of the detail <paramref name="detail"/>, which is in <paramref name="book"/>.</summary>
    private static Paragraph DetailOf(Book book, BookElement detail) =>
        BookElements.TextBlockOf(book, detail)!.Paragraphs.First(p => p.Block.Key == detail.Key);
}
