@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Vaults
@using NoteEvolution.UI.Editor
@inject AppState State
@inject IStringLocalizer<Strings> L

@* The bar at the bottom of the marking (spec 2, 3): the range buttons with the range head, the structure commands of
   the cursor element, the commands on the marked range, „Bemerkung anfügen“, „Verweis einfügen“ (cross references
   spec 2.2) and the status selection of the cursor element (status spec 2) and the notes the range is based on (package B, spec 2, 4, 5).
   EditorPane places it where the editor reports the marking's bottom; the bar renders with every render of EditorPane
   (its element is an object parameter), which follows the state and the conflicts. *@
<div class="ne-section-bar" hidden="@(!Visible)" style="top: @(Top.ToString(CultureInfo.InvariantCulture))px">
    @* The bar may render on its own (the list toggled) before EditorPane passes the element of a changed book. *@
    @if (State.CurrentBook is { } book && Element is { } element && BookElements.Find(book, element.Key) == element
         && State.CurrentRange is { } range)
    {
        var sources = SourcesOf(book, range);
        var backRefs = BackRefsOf(book, element);
        <div class="ne-sec-buttons">
            @* Moving the range changes no file, so it stays possible while the book is locked. *@
            <button type="button" class="ne-range-up" title="@L["RangeUpTitle"]" disabled="@(!State.CanRangeUp)"
                    @onclick="() => OnCommand.InvokeAsync(SectionCommand.RangeUp)">@L["RangeUp"]</button>
            <button type="button" class="ne-range-down" title="@L["RangeDownTitle"]" disabled="@(!State.CanRangeDown)"
                    @onclick="() => OnCommand.InvokeAsync(SectionCommand.RangeDown)">@L["RangeDown"]</button>
            @* Only the head may be cut off; the suffix of level −1 always stays visible, the title shows the full label. *@
            @{
                var head = RangeHead(book, range);
                var ownOnly = range.Level == -1;
            }
            <span class="ne-range-label" title="@(ownOnly ? head + L["RangeOwnOnly"] : head)"><span class="ne-range-head">@head</span>@if (ownOnly) {<span class="ne-range-own">@L["RangeOwnOnly"]</span>}</span>
            @foreach (var (css, command, key, headingOnly) in Commands)
            {
                if (headingOnly && element.Kind != ElementKind.Heading)
                {
                    continue;
                }

                <button type="button" class="@css" disabled="@(Locked || !ManuscriptCommands.CanRun(State, command))"
                        @onclick="() => OnCommand.InvokeAsync(command)">@L[key]</button>
            }
            @* A cross reference goes in at the cursor of a text block or detail; the search opens above the bar. *@
            @{
                var canReference = !Locked && ManuscriptCommands.CanInsertReference(State);
            }
            <span class="ne-sec-ref-area">
                <button type="button" class="ne-sec-ref" title="@L["SectionInsertRefTitle"]" disabled="@(!canReference)"
                        aria-expanded="@(_picking && canReference ? "true" : "false")"
                        @onclick="() => _picking = !_picking">@L["SectionInsertRef"]</button>
                @if (_picking && canReference)
                {
                    <ReferencePicker Book="book" ExcludeKey="State.Cursor?.Key" OnPick="PickAsync" OnCancel="() => _picking = false" />
                }
            </span>
            @* A heading has no status; it shows as a draft there, greyed out. The key renders the selection anew after
               each change, so a refused change does not leave the chosen status on display. *@
            @{
                var status = ManuscriptCommands.StatusAt(State) ?? BlockStatus.Draft;
            }
            <select @key="_statusChanges" class="ne-sec-status" title="@L["SectionStatus"]"
                    disabled="@(Locked || !ManuscriptCommands.CanSetStatus(State))" @onchange="ChangeStatusAsync">
                @foreach (var (value, statusKey) in Statuses)
                {
                    <option value="@value" selected="@(value == status)">@L[statusKey]</option>
                }
            </select>
        </div>
        <div class="ne-sec-sources-area">
            @* The places referring to the heading or text block at the cursor (cross references spec 2.3). *@
            @if (backRefs.Count > 0)
            {
                <span class="ne-sec-backrefs-area">
                    <button type="button" class="ne-sec-backrefs" aria-expanded="@(_backExpanded ? "true" : "false")"
                            @onclick="() => _backExpanded = !_backExpanded">@BackRefsText(backRefs.Count)</button>
                    @if (_backExpanded)
                    {
                        <div class="ne-sec-source-list ne-sec-backref-list">
                            @foreach (var back in backRefs)
                            {
                                var label = BackRefLabel(book, back);
                                <button type="button" class="ne-sec-source ne-sec-backref" title="@label"
                                        @onclick="() => RevealBackRef(back)">@label</button>
                            }
                        </div>
                    }
                </span>
            }
            @if (sources.Count == 0)
            {
                <span class="ne-sec-no-sources">@L["SectionNoSources"]</span>
            }
            else
            {
                <button type="button" class="ne-sec-sources" aria-expanded="@(_expanded ? "true" : "false")"
                        @onclick="() => _expanded = !_expanded">@SourcesText(sources.Count)</button>
                @if (_expanded)
                {
                    <div class="ne-sec-source-list">
                        @foreach (var source in Sorted(sources))
                        {
                            if (source.IsBroken)
                            {
                                <span class="ne-sec-source-broken">@L["SectionSourceMissing"]</span>
                            }
                            else
                            {
                                <button type="button" class="ne-sec-source" @onclick="() => State.RevealNote(source.NoteId)">@source.Label</button>
                            }
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>The buttons in their order: class, command, resource key, and whether only a heading has it.</summary>
    private static readonly (string Css, SectionCommand Command, string Key, bool HeadingOnly)[] Commands =
    [
        ("ne-sec-after", SectionCommand.InsertAfter, "SectionInsertAfter", false),
        ("ne-sec-child", SectionCommand.InsertChild, "SectionInsertChild", false),
        ("ne-sec-indent", SectionCommand.Indent, "SectionIndent", true),
        ("ne-sec-outdent", SectionCommand.Outdent, "SectionOutdent", true),
        ("ne-sec-remove-heading", SectionCommand.RemoveHeading, "SectionRemoveHeading", true),
        ("ne-sec-delete", SectionCommand.Delete, "SectionDelete", false),
        ("ne-sec-merge", SectionCommand.Merge, "SectionMerge", false),
        ("ne-sec-wrap", SectionCommand.Wrap, "SectionWrap", false),
        ("ne-sec-remark", SectionCommand.AddRemark, "SectionAddRemark", false),
    ];

    /// <summary>The options of the status selection in their order: the status and its resource key.</summary>
    private static readonly (BlockStatus Status, string Key)[] Statuses =
    [
        (BlockStatus.Draft, "StatusDraft"),
        (BlockStatus.Relevant, "StatusRelevant"),
        (BlockStatus.Remark, "StatusRemark"),
        (BlockStatus.Wording, "StatusWording"),
        (BlockStatus.Done, "StatusDone"),
    ];

    /// <summary>Whether the list of sources is open; it stays so while the range changes.</summary>
    private bool _expanded;

    /// <summary>Whether the list of places referring to the element at the cursor is open.</summary>
    private bool _backExpanded;

    /// <summary>The cross reference index of <see cref="_indexBook"/>; the book is an immutable snapshot, so it is kept until the instance changes.</summary>
    private CrossRefIndex? _index;

    private Book? _indexBook;

    /// <summary>Whether the search for the target of a cross reference is open.</summary>
    private bool _picking;

    /// <summary>Counts the changes in the status selection; the selection is rendered anew after each one.</summary>
    private int _statusChanges;

    /// <summary>Where the bar's top is, in pixels from the top of <c>.ne-editor-pane</c>.</summary>
    [Parameter]
    public double Top { get; set; }

    /// <summary>Whether the marking is in view; the bar is hidden otherwise.</summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>The cursor element (<see cref="AppState.CurrentElement"/>) of the current book; <c>null</c> shows nothing.</summary>
    [Parameter]
    public BookElement? Element { get; set; }

    /// <summary>The book cannot be changed now (read-only, or a conflict is open): all commands are disabled.</summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>Runs a structure command on the cursor element or the range, or moves the range, the same way as its shortcut.</summary>
    [Parameter]
    public EventCallback<SectionCommand> OnCommand { get; set; }

    /// <summary>Sets the status of the text block or detail at the cursor to the one chosen in the selection.</summary>
    [Parameter]
    public EventCallback<BlockStatus> OnStatus { get; set; }

    /// <summary>
    /// Inserts a cross reference to the chosen heading or text block (its key) at the cursor of the text block or detail
    /// at the cursor.
    /// </summary>
    [Parameter]
    public EventCallback<Guid> OnReference { get; set; }

    /// <summary>
    /// The search closes once a reference is not possible (the cursor on a heading, the book locked), so it does not
    /// open again by itself and take the focus when it is possible again.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Locked || !ManuscriptCommands.CanInsertReference(State))
        {
            _picking = false;
        }
    }

    /// <summary>Closes the search and passes the chosen target on.</summary>
    private async Task PickAsync(Guid targetKey)
    {
        _picking = false;
        await OnReference.InvokeAsync(targetKey);
    }

    /// <summary>Passes the chosen status on; afterwards the selection shows the status the element has then.</summary>
    private async Task ChangeStatusAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<BlockStatus>(args.Value?.ToString(), out var status))
        {
            await OnStatus.InvokeAsync(status);
        }

        _statusChanges++;
    }

    /// <summary>The distinct notes (their <c>id::</c>) the text blocks of <paramref name="range"/> refer to, in order.</summary>
    private static IReadOnlyList<Guid> SourcesOf(Book book, RangeInfo range) =>
        [.. range.TextBlockKeys.Select(book.FindTextBlock).OfType<TextBlock>().SelectMany(textBlock => textBlock.Sources).Distinct()];

    /// <summary>
    /// The range head as the label names it: a heading with its level marks and title (or that it has none), e.g.
    /// "## Vertrauen" (spec 2), a text block, a detail, or the whole book.
    /// </summary>
    private string RangeHead(Book book, RangeInfo range) => range.Head switch
    {
        null => L["RangeBook"],
        { Kind: ElementKind.Heading } head => book.FindNode(head.Key) is { } node
            ? L["RangeHeading", $"{new string('#', node.Level)} {(node.Title.Length > 0 ? node.Title : L["OutlineUntitled"].Value)}"]
            : L["RangeHeading", L["OutlineUntitled"].Value],
        { Kind: ElementKind.TextBlock } => L["RangeTextBlock"],
        _ => L["RangeDetail"],
    };

    /// <summary>The references to the heading or text block <paramref name="element"/> (by its <c>id::</c>), in book order.</summary>
    private IReadOnlyList<CrossRefSource> BackRefsOf(Book book, BookElement element)
    {
        Guid? id = element.Kind switch
        {
            ElementKind.Heading => book.FindNode(element.Key)?.Block?.Id,
            ElementKind.TextBlock => book.FindTextBlock(element.Key)?.Block.Id,
            _ => null,
        };
        if (id is not { } targetId)
        {
            return [];
        }

        if (!ReferenceEquals(_indexBook, book))
        {
            _index = CrossRefIndex.Of(book);
            _indexBook = book;
        }

        return _index!.To(targetId);
    }

    /// <summary>"Abschnitt › Textanfang" of the text block holding the reference.</summary>
    private string BackRefLabel(Book book, CrossRefSource source) =>
        RefLabels.SectionTitle(book, source.TextBlock.Section, L) + RefLabels.Separator
        + RefLabels.Excerpt(source.TextBlock.Text, RefLabels.TitleExcerptLength);

    private void RevealBackRef(CrossRefSource source)
    {
        // history: record the jump from the cursor's element to the referring place here (Task 7).
        State.RevealElement(source.ElementKey);
        State.Notify();
    }

    private string BackRefsText(int count) => (count, _backExpanded) switch
    {
        (1, false) => L["SectionBackRefsOne"],
        (1, true) => L["SectionBackRefsOneOpen"],
        (_, false) => L["SectionBackRefs", count],
        _ => L["SectionBackRefsOpen", count],
    };

    private string SourcesText(int count) => (count, _expanded) switch
    {
        (1, false) => L["SectionSourcesOne"],
        (1, true) => L["SectionSourcesOneOpen"],
        (_, false) => L["SectionSources", count],
        _ => L["SectionSourcesOpen", count],
    };

    /// <summary>
    /// The sources (<see cref="BookSnapshot.SourceOf"/>) by the date of their note's journal day, then by label; notes
    /// without a date, and missing ones, come last by label.
    /// </summary>
    private IEnumerable<SourceInfo> Sorted(IReadOnlyList<Guid> noteIds)
    {
        if (State.Session?.Vault is not { } vault)
        {
            return [];
        }

        return noteIds
            .Select(id => (
                Source: BookSnapshot.SourceOf(id, vault),
                Date: vault.FindBlockById(id) is { } found ? NoteRepository.DateOf(found.Page) : null))
            .OrderBy(entry => entry.Date is null)
            .ThenBy(entry => entry.Date)
            .ThenBy(entry => entry.Source.Label, StringComparer.CurrentCulture)
            .Select(entry => entry.Source);
    }
}
