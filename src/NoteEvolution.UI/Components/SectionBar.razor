@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Text
@using NoteEvolution.Core.Vaults
@using NoteEvolution.UI.Editor
@inject AppState State
@inject IStringLocalizer<Strings> L

@* The bar at the bottom of the marking (spec 2, 3): the range buttons with the range head, the structure commands of
   the cursor element with „⇤ Ausrücken“ / „Einrücken ⇥“ (Einordnen spec 4), the commands on the marked range,
   „Bemerkung anfügen“, the level buttons „Text · H1 … H6“ and
   „Verweis einfügen“ (cross references spec 4, 2.2) and the status selection of the cursor element (status spec 2) and the notes the range is based on (package B, spec 2, 4, 5).
   EditorPane places it where the editor reports the marking's bottom; the bar renders with every render of EditorPane
   (its element is an object parameter), which follows the state and the conflicts. *@
<div class="ne-section-bar" hidden="@(!Visible)" style="top: @(Top.ToString(CultureInfo.InvariantCulture))px">
    @* The locator of the citation double-clicked in the editor (appendix spec 3.2): Enter saves, Escape cancels. *@
    @if (CitationLocator is not null)
    {
        <div class="ne-citation-edit" role="dialog" aria-label="@L["CitationEditTitle"]">
            <label>@L["SourcePickerLocator"]
                <input type="text" class="ne-citation-locator" @ref="_citationInput" value="@_citationText"
                       @oninput="args => _citationText = args.Value?.ToString() ?? string.Empty" @onkeydown="CitationKeyDownAsync" />
            </label>
            <button type="button" class="ne-citation-save" @onclick="() => OnCitationSave.InvokeAsync(_citationText)">@L["CitationEditSave"]</button>
            <button type="button" class="ne-citation-cancel" @onclick="() => OnCitationCancel.InvokeAsync()">@L["CitationEditCancel"]</button>
        </div>
    }
    @* The bar may render on its own (the list toggled) before EditorPane passes the element of a changed book. *@
    @if (State.CurrentBook is { } book && Element is { } element && BookElements.Find(book, element.Key) == element
         && State.CurrentRange is { } range)
    {
        var sources = SourcesOf(book, range);
        var backRefs = BackRefsOf(book, element);
        <div class="ne-sec-buttons">
            @* Moving the range changes no file, so it stays possible while the book is locked. *@
            <button type="button" class="ne-range-up" title="@L["RangeUpTitle"]" disabled="@(!State.CanRangeUp)"
                    @onclick="() => OnCommand.InvokeAsync(SectionCommand.RangeUp)">@L["RangeUp"]</button>
            <button type="button" class="ne-range-down" title="@L["RangeDownTitle"]" disabled="@(!State.CanRangeDown)"
                    @onclick="() => OnCommand.InvokeAsync(SectionCommand.RangeDown)">@L["RangeDown"]</button>
            @* Only the head may be cut off; the suffix of level −1 always stays visible, the title shows the full label. *@
            @{
                var head = RangeHead(book, range);
                var ownOnly = range.Level == -1;
            }
            <span class="ne-range-label" title="@(ownOnly ? head + L["RangeOwnOnly"] : head)"><span class="ne-range-head">@head</span>@if (ownOnly) {<span class="ne-range-own">@L["RangeOwnOnly"]</span>}</span>
            @foreach (var (css, command, key, headingOnly) in Commands)
            {
                if (headingOnly && element.Kind != ElementKind.Heading)
                {
                    continue;
                }

                <button type="button" class="@css" disabled="@(Locked || !ManuscriptCommands.CanRun(State, command))"
                        @onclick="() => OnCommand.InvokeAsync(command)">@L[key]</button>
                @if (command == SectionCommand.InsertChild)
                {
                    @* One step out or in for every kind of element, as Shift+Tab and Tab (Einordnen spec 4); a step it
                       cannot take is greyed out and names the reason. *@
                    var outdentBlocked = ManuscriptCommands.OutdentBlocked(State);
                    var indentBlocked = ManuscriptCommands.IndentBlocked(State);
                    <button type="button" class="ne-sec-outdent-any" title="@L[outdentBlocked ?? "SectionOutdentTitle"]"
                            disabled="@(Locked || !ManuscriptCommands.CanOutdent(State))" @onclick="() => OnOutdent.InvokeAsync()">@L["SectionOutdent"]</button>
                    <button type="button" class="ne-sec-indent-any" title="@L[indentBlocked ?? "SectionIndentTitle"]"
                            disabled="@(Locked || !ManuscriptCommands.CanIndent(State))" @onclick="() => OnIndent.InvokeAsync()">@L["SectionIndent"]</button>
                }
            }
            @* The level of the element at the cursor (cross references spec 4): the current one is pressed, a level it
               cannot take is greyed out and names the reason. *@
            @{
                var current = ManuscriptCommands.LevelAt(State);
                // The current level places a heading whose place does not match it (Einordnen spec 2).
                var canPlace = !Locked && ManuscriptCommands.CanPlace(State);
            }
            <span class="ne-sec-levels" role="group" aria-label="@L["SectionLevels"]">
                @for (var level = 0; level <= OutlineEditor.MaxLevel; level++)
                {
                    var target = level;
                    var reason = ManuscriptCommands.LevelBlocked(State, target);
                    var places = canPlace && current == target;
                    <button type="button" class="@(places ? "ne-sec-level ne-sec-level-place" : "ne-sec-level")" aria-pressed="@(current == target ? "true" : "false")"
                            title="@(reason is null ? LevelTitle(target, current, places) : L[reason])"
                            disabled="@(Locked || (current != target && !ManuscriptCommands.CanSetLevel(State, target)))"
                            @onclick="() => LevelChosenAsync(target, current, places)">@LevelLabel(target)</button>
                }
            </span>
            @* A cross reference goes in at the cursor of a text block or detail; the search opens above the bar. *@
            @{
                var canReference = !Locked && ManuscriptCommands.CanInsertReference(State);
            }
            <span class="ne-sec-ref-area">
                <button type="button" class="ne-sec-ref" title="@L["SectionInsertRefTitle"]" disabled="@(!canReference)"
                        aria-expanded="@(_picking && canReference ? "true" : "false")"
                        @onclick="ToggleReferencePicker">@L["SectionInsertRef"]</button>
                @if (_picking && canReference)
                {
                    <ReferencePicker Book="book" ExcludeKey="State.Cursor?.Key" OnPick="PickAsync" OnCancel="() => _picking = false" />
                }
            </span>
            @* People and sources of the appendix go in at the cursor like a cross reference (appendix spec 3). *@
            @foreach (var (css, kind, labelKey, titleKey) in AppendixButtons)
            {
                <span class="ne-sec-ref-area">
                    <button type="button" class="@css" title="@L[titleKey]" disabled="@(!canReference)"
                            aria-expanded="@(_appendixPicking == kind && canReference ? "true" : "false")"
                            @onclick="() => ToggleAppendixPicker(kind)">@L[labelKey]</button>
                    @if (_appendixPicking == kind && canReference)
                    {
                        <AppendixPicker Book="book" Kind="kind" OnPick="PickAppendixAsync" OnCancel="() => _appendixPicking = null" />
                    }
                </span>
            }
            @* Notes that may be where the text block at the cursor came from (with the local AI only); the list follows
               the cursor to another text block. *@
            @if (CanFindSources)
            {
                @* Not positioned itself: the list opens over the whole width of the bar, to show more of each note. *@
                <span class="ne-sec-find-sources-area">
                    <button type="button" class="ne-sec-find-sources" title="@L["SectionFindSourcesTitle"]"
                            aria-expanded="@(_findingSources ? "true" : "false")"
                            @onclick="() => _findingSources = !_findingSources">@L["SectionFindSources"]</button>
                    @if (_findingSources && State.CursorTextBlockKey is { } sourceBlock)
                    {
                        <SourceFinder Book="book" TextBlockKey="sourceBlock" OnLink="OnSource" />
                    }
                </span>
            }
            @* A heading has no status; it shows as a draft there, greyed out. The key renders the selection anew after
               each change, so a refused change does not leave the chosen status on display. *@
            @{
                var status = ManuscriptCommands.StatusAt(State) ?? BlockStatus.Draft;
            }
            <select @key="_statusChanges" class="ne-sec-status" title="@L["SectionStatus"]"
                    disabled="@(Locked || !ManuscriptCommands.CanSetStatus(State))" @onchange="ChangeStatusAsync">
                @foreach (var (value, statusKey) in Statuses)
                {
                    <option value="@value" selected="@(value == status)">@L[statusKey]</option>
                }
            </select>
        </div>
        <div class="ne-sec-sources-area">
            @* The places referring to the heading or text block at the cursor (cross references spec 2.3). *@
            @if (backRefs.Count > 0)
            {
                <span class="ne-sec-backrefs-area">
                    <button type="button" class="ne-sec-backrefs" aria-expanded="@(_backExpanded ? "true" : "false")"
                            @onclick="() => _backExpanded = !_backExpanded">@BackRefsText(backRefs.Count)</button>
                    @if (_backExpanded)
                    {
                        <div class="ne-sec-source-list ne-sec-backref-list">
                            @foreach (var back in backRefs)
                            {
                                var label = BackRefLabel(book, back);
                                <button type="button" class="ne-sec-source ne-sec-backref" title="@label"
                                        @onclick="() => RevealBackRef(back)">@label</button>
                            }
                        </div>
                    }
                </span>
            }
            @if (sources.Count == 0)
            {
                <span class="ne-sec-no-sources">@L["SectionNoSources"]</span>
            }
            else
            {
                <button type="button" class="ne-sec-sources" aria-expanded="@(_expanded ? "true" : "false")"
                        @onclick="() => _expanded = !_expanded">@SourcesText(sources.Count)</button>
                @if (_expanded)
                {
                    <div class="ne-sec-source-list">
                        @foreach (var source in Sorted(sources))
                        {
                            if (source.IsBroken)
                            {
                                <span class="ne-sec-source-broken">@L["SectionSourceMissing"]</span>
                            }
                            else
                            {
                                <button type="button" class="ne-sec-source" @onclick="() => RevealSource(source.NoteId)">@source.Label</button>
                            }
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>The buttons in their order: class, command, resource key, and whether only a heading has it.</summary>
    private static readonly (string Css, SectionCommand Command, string Key, bool HeadingOnly)[] Commands =
    [
        ("ne-sec-after", SectionCommand.InsertAfter, "SectionInsertAfter", false),
        ("ne-sec-child", SectionCommand.InsertChild, "SectionInsertChild", false),
        ("ne-sec-remove-heading", SectionCommand.RemoveHeading, "SectionRemoveHeading", true),
        ("ne-sec-delete", SectionCommand.Delete, "SectionDelete", false),
        ("ne-sec-merge", SectionCommand.Merge, "SectionMerge", false),
        ("ne-sec-split", SectionCommand.Split, "SectionSplit", false),
        ("ne-sec-wrap", SectionCommand.Wrap, "SectionWrap", false),
        ("ne-sec-remark", SectionCommand.AddRemark, "SectionAddRemark", false),
    ];

    /// <summary>The options of the status selection in their order: the status and its resource key.</summary>
    private static readonly (BlockStatus Status, string Key)[] Statuses =
    [
        (BlockStatus.Draft, "StatusDraft"),
        (BlockStatus.Relevant, "StatusRelevant"),
        (BlockStatus.Remark, "StatusRemark"),
        (BlockStatus.Wording, "StatusWording"),
        (BlockStatus.Done, "StatusDone"),
    ];

    /// <summary>Whether the list of sources is open; it stays so while the range changes.</summary>
    private bool _expanded;

    /// <summary>Whether the list of places referring to the element at the cursor is open.</summary>
    private bool _backExpanded;

    /// <summary>The element the list of references was opened for.</summary>
    private Guid? _backKey;

    /// <summary>The cross reference index of <see cref="_indexBook"/>; the book is an immutable snapshot, so it is kept until the instance changes.</summary>
    private CrossRefIndex? _index;

    private Book? _indexBook;

    /// <summary>Whether the search for the target of a cross reference is open.</summary>
    private bool _picking;

    /// <summary>Counts the changes in the status selection; the selection is rendered anew after each one.</summary>
    private int _statusChanges;

    /// <summary>Where the bar's top is, in pixels from the top of <c>.ne-editor-pane</c>.</summary>
    [Parameter]
    public double Top { get; set; }

    /// <summary>Whether the marking is in view; the bar is hidden otherwise.</summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>The cursor element (<see cref="AppState.CurrentElement"/>) of the current book; <c>null</c> shows nothing.</summary>
    [Parameter]
    public BookElement? Element { get; set; }

    /// <summary>The book cannot be changed now (read-only, or a conflict is open): all commands are disabled.</summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>Runs a structure command on the cursor element or the range, or moves the range, the same way as its shortcut.</summary>
    [Parameter]
    public EventCallback<SectionCommand> OnCommand { get; set; }

    /// <summary>Sets the status of the text block or detail at the cursor to the one chosen in the selection.</summary>
    [Parameter]
    public EventCallback<BlockStatus> OnStatus { get; set; }

    /// <summary>
    /// Inserts a cross reference to the chosen heading or text block (its key) at the cursor of the text block or detail
    /// at the cursor.
    /// </summary>
    [Parameter]
    public EventCallback<Guid> OnReference { get; set; }

    /// <summary>
    /// Converts the element at the cursor to the chosen level (0 = Text, 1–6 = H1–H6); the heading's own level places
    /// a heading whose place does not match it.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnLevel { get; set; }

    /// <summary>„Einrücken ⇥“: the element at the cursor one step in, as Tab (<see cref="ManuscriptCommands.IndentAsync"/>).</summary>
    [Parameter]
    public EventCallback OnIndent { get; set; }

    /// <summary>„⇤ Ausrücken“: the element at the cursor one step out, as Shift+Tab (<see cref="ManuscriptCommands.OutdentAsync"/>).</summary>
    [Parameter]
    public EventCallback OnOutdent { get; set; }

    /// <summary>A note was chosen in „Quellen suchen“: link it as a source of the text block at the cursor.</summary>
    [Parameter]
    public EventCallback<Guid> OnSource { get; set; }

    /// <summary>A person or source (or „Neu anlegen …“) was chosen in „Mensch einfügen“ or „Quelle einfügen“.</summary>
    [Parameter]
    public EventCallback<AppendixPick> OnAppendixPick { get; set; }

    /// <summary>The locator of the citation being changed (an empty one: none); <c>null</c> shows no field.</summary>
    [Parameter]
    public string? CitationLocator { get; set; }

    /// <summary>The locator field's text is to be saved.</summary>
    [Parameter]
    public EventCallback<string> OnCitationSave { get; set; }

    /// <summary>The locator field was closed without saving.</summary>
    [Parameter]
    public EventCallback OnCitationCancel { get; set; }

    /// <summary>The insert buttons of the appendix: class, kind, label and tooltip.</summary>
    private static readonly (string Css, AppendixKind Kind, string Label, string Title)[] AppendixButtons =
    [
        ("ne-sec-person", AppendixKind.People, "SectionInsertPerson", "SectionInsertPersonTitle"),
        ("ne-sec-insert-source", AppendixKind.Sources, "SectionInsertSource", "SectionInsertSourceTitle"),
    ];

    /// <summary>Which appendix picker is open; <c>null</c>: none.</summary>
    private AppendixKind? _appendixPicking;

    private ElementReference _citationInput;

    /// <summary>The text of the locator field.</summary>
    private string _citationText = "";

    /// <summary>The locator the field was opened with; a new one fills the field anew and takes the focus.</summary>
    private string? _citationShown;

    private bool _citationFocusPending;

    /// <summary>Whether „Quellen suchen“ is open.</summary>
    private bool _findingSources;

    /// <summary>„Quellen suchen“ is offered on a text block or detail of a writable book, with the local AI ready.</summary>
    private bool CanFindSources => !Locked && State.CursorTextBlockKey is not null && State.Session?.Relevance.IsAvailable == true;

    /// <summary>
    /// The search closes once a reference is not possible (the cursor on a heading, the book locked), so it does not
    /// open again by itself and take the focus when it is possible again.
    /// </summary>
    protected override void OnParametersSet()
    {
        // The list of references belongs to one element: it closes when the marked element changes.
        if (Element?.Key != _backKey)
        {
            _backKey = Element?.Key;
            _backExpanded = false;
        }

        if (Locked || !ManuscriptCommands.CanInsertReference(State))
        {
            _picking = false;
            _appendixPicking = null;
        }

        if (CitationLocator != _citationShown)
        {
            _citationShown = CitationLocator;
            _citationText = CitationLocator ?? "";
            _citationFocusPending = CitationLocator is not null;
        }

        if (!CanFindSources)
        {
            _findingSources = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_citationFocusPending)
        {
            _citationFocusPending = false;
            await _citationInput.FocusAsync();
        }
    }

    /// <summary>Opens the search for a cross reference target (closing an appendix picker), or closes it.</summary>
    private void ToggleReferencePicker()
    {
        _picking = !_picking;
        if (_picking)
        {
            _appendixPicking = null;
        }
    }

    /// <summary>Opens the picker of <paramref name="kind"/> (closing the other searches), or closes it.</summary>
    private void ToggleAppendixPicker(AppendixKind kind)
    {
        _appendixPicking = _appendixPicking == kind ? null : kind;
        if (_appendixPicking is not null)
        {
            _picking = false;
        }
    }

    /// <summary>Closes the picker and passes the choice on.</summary>
    private async Task PickAppendixAsync(AppendixPick pick)
    {
        _appendixPicking = null;
        await OnAppendixPick.InvokeAsync(pick);
    }

    private async Task CitationKeyDownAsync(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
                await OnCitationSave.InvokeAsync(_citationText);
                break;
            case "Escape":
                await OnCitationCancel.InvokeAsync();
                break;
        }
    }

    /// <summary>Closes the search and passes the chosen target on.</summary>
    private async Task PickAsync(Guid targetKey)
    {
        _picking = false;
        await OnReference.InvokeAsync(targetKey);
    }

    /// <summary>Passes a chosen level on; the current level does nothing, unless it places the heading (<paramref name="places"/>).</summary>
    private Task LevelChosenAsync(int level, int? current, bool places) =>
        level == current && !places ? Task.CompletedTask : OnLevel.InvokeAsync(level);

    private string LevelLabel(int level) => level == 0 ? L["SectionLevelText"] : L["SectionLevelHeading", level];

    /// <summary>The tooltip of a level button the element can take, or of its current level (which may place it).</summary>
    private string LevelTitle(int level, int? current, bool places) => (level == current, level) switch
    {
        (true, _) when places => L["SectionLevelPlace"],
        (true, _) => L["SectionLevelCurrent"],
        (false, 0) => L["SectionLevelTextTitle"],
        _ => L["SectionLevelHeadingTitle", level],
    };

    /// <summary>Passes the chosen status on; afterwards the selection shows the status the element has then.</summary>
    private async Task ChangeStatusAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<BlockStatus>(args.Value?.ToString(), out var status))
        {
            await OnStatus.InvokeAsync(status);
        }

        _statusChanges++;
    }

    /// <summary>The distinct notes (their <c>id::</c>) the text blocks of <paramref name="range"/> refer to, in order.</summary>
    private static IReadOnlyList<Guid> SourcesOf(Book book, RangeInfo range) =>
        [.. range.TextBlockKeys.Select(book.FindTextBlock).OfType<TextBlock>().SelectMany(textBlock => textBlock.Sources).Distinct()];

    /// <summary>
    /// The range head as the label names it: a heading with its level marks and title (or that it has none), e.g.
    /// "## Vertrauen" (spec 2), a text block, a detail, or the whole book.
    /// </summary>
    private string RangeHead(Book book, RangeInfo range) => range.Head switch
    {
        null => L["RangeBook"],
        { Kind: ElementKind.Heading } head => book.FindNode(head.Key) is { } node
            ? L["RangeHeading", $"{new string('#', node.Level)} {(node.Title.Length > 0 ? node.Title : L["OutlineUntitled"].Value)}"]
            : L["RangeHeading", L["OutlineUntitled"].Value],
        { Kind: ElementKind.TextBlock } => L["RangeTextBlock"],
        _ => L["RangeDetail"],
    };

    /// <summary>The elements referring to the heading or text block <paramref name="element"/> (by its <c>id::</c>), once each, in book order.</summary>
    private IReadOnlyList<CrossRefSource> BackRefsOf(Book book, BookElement element)
    {
        Guid? id = element.Kind switch
        {
            ElementKind.Heading => book.FindNode(element.Key)?.Block?.Id,
            ElementKind.TextBlock => book.FindTextBlock(element.Key)?.Block.Id,
            _ => null,
        };
        if (id is not { } targetId)
        {
            return [];
        }

        if (!ReferenceEquals(_indexBook, book))
        {
            _index = CrossRefIndex.Of(book);
            _indexBook = book;
        }

        // Each referring element once, in book order, however often it names the target.
        return [.. _index!.To(targetId).DistinctBy(source => source.ElementKey)];
    }

    /// <summary>
    /// "Abschnitt › Textanfang" of the element holding the reference: the text block's text, or a sub-point's own text
    /// (without its <c>#notiz</c> tag).
    /// </summary>
    private string BackRefLabel(Book book, CrossRefSource source)
    {
        var text = source.TextBlock.Paragraphs.FirstOrDefault(p => p.Block.Key == source.ElementKey) is { } paragraph
            ? NoteTag.Remove(paragraph.Block.Content)
            : source.TextBlock.Text;
        return RefLabels.SectionTitle(book, source.TextBlock.Section, L) + RefLabels.Separator
               + RefLabels.Excerpt(text, RefLabels.TitleExcerptLength);
    }

    /// <summary>A jump to the referring element, in the back/forward history.</summary>
    private void RevealBackRef(CrossRefSource source)
    {
        State.JumpTo(source.ElementKey);
        State.Notify();
    }

    /// <summary>
    /// Brings the source's note into view in the notes pane. A jump (spec 3) that leaves the active block where it is:
    /// the block goes into the back/forward history at once.
    /// </summary>
    private void RevealSource(Guid noteId)
    {
        if (State.Position is { } here)
        {
            State.RecordJump(here);
        }

        State.RevealNote(noteId);
        State.Notify();
    }

    private string BackRefsText(int count) => (count, _backExpanded) switch
    {
        (1, false) => L["SectionBackRefsOne"],
        (1, true) => L["SectionBackRefsOneOpen"],
        (_, false) => L["SectionBackRefs", count],
        _ => L["SectionBackRefsOpen", count],
    };

    private string SourcesText(int count) => (count, _expanded) switch
    {
        (1, false) => L["SectionSourcesOne"],
        (1, true) => L["SectionSourcesOneOpen"],
        (_, false) => L["SectionSources", count],
        _ => L["SectionSourcesOpen", count],
    };

    /// <summary>
    /// The sources (<see cref="BookSnapshot.SourceOf"/>) by the date of their note's journal day, then by label; notes
    /// without a date, and missing ones, come last by label.
    /// </summary>
    private IEnumerable<SourceInfo> Sorted(IReadOnlyList<Guid> noteIds)
    {
        if (State.Session?.Vault is not { } vault)
        {
            return [];
        }

        return noteIds
            .Select(id => (
                Source: BookSnapshot.SourceOf(id, vault),
                Date: vault.FindBlockById(id) is { } found ? NoteRepository.DateOf(found.Page) : null))
            .OrderBy(entry => entry.Date is null)
            .ThenBy(entry => entry.Date)
            .ThenBy(entry => entry.Source.Label, StringComparer.CurrentCulture)
            .Select(entry => entry.Source);
    }
}
