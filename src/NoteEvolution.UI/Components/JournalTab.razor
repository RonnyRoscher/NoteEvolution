@using NoteEvolution.Core.Model
@using NoteEvolution.Core.Storage
@using NoteEvolution.Core.Vaults
@implements IDisposable
@inject AppState State
@inject IPlatformServices Platform
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L

@* The "Journal" tab: one card per journal page (a day), newest first, from a chosen day on; its root blocks inside. *@
@{
    var visible = VisibleDays(_entries.Where(note => Jump is not { } jump || note.Date <= jump));
    var book = Marks.Book;

    // A day with a card whose "Wohin damit?" list is open stays, also beyond the days shown so far.
    var shown = visible.Where((day, index) => index < _shown || day.Any(note => State.WhereToOpenNotes.Contains(note.Key)));
}

<div class="ne-journal">
    @if (visible.Count == 0)
    {
        <div class="ne-search-empty">@L["NotesJournalEmpty"]</div>
    }
    <div class="ne-journal-list">
        @foreach (var day in shown)
        {
            var page = day[0].Page;
            <section @key="page.FilePath" class="ne-journal-day">
                <header class="ne-journal-day-head">
                    <span class="ne-journal-day-date">@DayLabel(day[0])</span>
                    @* The day's marks, stored as page properties of its file (DayMarks); "nicht relevant" is per book. *@
                    <label class="ne-day-mark" title="@(book is null ? L["JournalDayNotRelevantNoBook"] : L["JournalDayNotRelevantTitle"])">
                        <input @key="(page.FilePath, _markRefresh)" data-mark-refresh="@_markRefresh" type="checkbox" class="ne-day-not-relevant" checked="@(book is not null && DayMarks.IsNotRelevant(page, book))"
                               disabled="@(book is null)" @onchange="e => Mark(page, p => DayMarks.SetNotRelevant(p, book!, e.Value is true))" />
                        @L["JournalDayNotRelevant"]
                    </label>
                    <label class="ne-day-mark" title="@L["JournalDayLaterTitle"]">
                        <input @key="(page.FilePath, _markRefresh)" data-mark-refresh="@_markRefresh" type="checkbox" class="ne-day-later" checked="@DayMarks.IsLater(page)"
                               @onchange="e => Mark(page, p => DayMarks.SetLater(p, e.Value is true))" />
                        @L["JournalDayLater"]
                    </label>
                    <button type="button" class="ne-journal-day-logseq" title="@L["JournalDayLogseqTitle", DayLabel(day[0])]"
                            aria-label="@L["JournalDayLogseqTitle", DayLabel(day[0])]" @onclick="() => OpenInLogseq(day)">@L["NoteOpenLogseq"]</button>
                </header>
                @if (_message is { } message && string.Equals(message.Path, page.FilePath, StringComparison.OrdinalIgnoreCase))
                {
                    <div class="ne-note-message ne-note-error" role="alert">@L[message.Key]</div>
                }
                @foreach (var note in day)
                {
                    <NoteCard @key="note.Key" Note="note" InDay="true" Highlighted="note.Key == _highlightKey"
                              FocusRequest="note.Key == _highlightKey ? _focusRequest : 0" />
                }
            </section>
        }
    </div>
    @if (visible.Count > _shown)
    {
        <button type="button" class="ne-journal-more" @onclick="() => _shown += PageSize">@L["NotesShowMore"]</button>
    }
</div>

@code {
    /// <summary>How many days are shown at first and added by each "Weitere anzeigen".</summary>
    private const int PageSize = 20;

    private (NoteFilter Filter, int Revision)? _last;
    private List<NoteBlock> _entries = [];

    /// <summary>The notes in <see cref="_entries"/> only because their "Wohin damit?" list is open (see <see cref="WhereToPins"/>).</summary>
    private HashSet<Guid> _keptOnly = [];
    private DateOnly? _lastJump;
    private int _shown = PageSize;
    private (Guid? Key, int Sequence) _lastReveal;
    private Guid? _highlightKey;
    private int _focusRequest;
    private ITimer? _highlightTimer;
    private bool _disposed;

    /// <summary>
    /// The day whose mark was refused or failed last, with the message key; it goes when the entries are read again for a
    /// <see cref="Revision"/> after <c>ClearAfter</c> (a merged external change brings one revision of its own).
    /// </summary>
    private (string Path, string Key, int ClearAfter)? _message;

    /// <summary>
    /// Counts the toggles that were not saved as clicked. The mark inputs are keyed by it, so they are created again: a
    /// <c>checked</c> value that did not change in the model would otherwise leave the clicked state in the DOM.
    /// </summary>
    private int _markRefresh;

    [Parameter, EditorRequired] public NoteFilter Filter { get; set; } = default!;

    /// <summary>Which marked days are hidden; its book is the one "nicht relevant" is set for (none: that mark is disabled).</summary>
    [Parameter, EditorRequired] public DayMarkFilter Marks { get; set; } = default!;

    /// <summary>The day the list starts at (newer days are hidden); the date field sits in the notes pane's filter row.</summary>
    [Parameter] public DateOnly? Jump { get; set; }

    /// <summary>Changes whenever the vault's pages or the session changed, so the entries are read again.</summary>
    [Parameter] public int Revision { get; set; }

    /// <summary>
    /// The note a source jumped to: the pane sets the date jump to the note's day, the tab makes sure the note is among the shown
    /// entries, marks its card and focuses it. <see cref="RevealSequence"/> tells a new request from the same one again.
    /// </summary>
    [Parameter] public Guid? RevealKey { get; set; }

    /// <summary>Counts the jump requests; the same note can be asked for again.</summary>
    [Parameter] public int RevealSequence { get; set; }

    /// <summary>How long a card stays marked after a jump (R4: measured with the injected <see cref="TimeProvider"/>).</summary>
    public static readonly TimeSpan HighlightDuration = TimeSpan.FromSeconds(2);

    /// <remarks>
    /// The pane renders again on every <see cref="AppState.Changed"/>, which calls this: a note kept only for its open
    /// "Wohin damit?" list goes once that list is closed. Reading the entries again keeps a card with an open list where
    /// it is, with its note as the notes have it now (gone if they no longer have it).
    /// </remarks>
    protected override void OnParametersSet()
    {
        WhereToPins.Release(_entries, _keptOnly, note => note.Key, State.WhereToOpenNotes);
        if (_last != (Filter, Revision))
        {
            _last = (Filter, Revision);
            _shown = PageSize;
            if (_message is { } message && Revision > message.ClearAfter)
            {
                _message = null;
            }

            ReadEntries();
        }

        if (Jump != _lastJump)
        {
            _lastJump = Jump;
            _shown = PageSize;
        }

        if (RevealKey is { } key && (key, RevealSequence) != _lastReveal)
        {
            _lastReveal = (key, RevealSequence);
            Reveal(key);
        }
    }

    private void ReadEntries()
    {
        var notes = State.Session?.Notes;
        (_entries, _keptOnly) = WhereToPins.Merge(_entries, notes?.Journal(Filter) ?? [], note => note.Key, State.WhereToOpenNotes);
        _entries = [.. _entries.Select(note => _keptOnly.Contains(note.Key) ? notes?.Get(note.Key) : note).OfType<NoteBlock>()];
    }

    public void Dispose()
    {
        _disposed = true;
        _highlightTimer?.Dispose();
    }

    private void Reveal(Guid key)
    {
        if (_entries.FirstOrDefault(note => note.Key == key) is not { Date: { } day })
        {
            return;
        }

        _shown = Math.Max(_shown, VisibleDays(_entries.Where(note => note.Date <= day)).FindIndex(d => d.Any(note => note.Key == key)) + 1);
        _highlightKey = key;
        _focusRequest++;
        _highlightTimer?.Dispose();
        _highlightTimer = Time.CreateTimer(_ => _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                _highlightKey = null;
                StateHasChanged();
            }
        }), null, HighlightDuration, Timeout.InfiniteTimeSpan);
    }

    /// <summary>
    /// The notes grouped by their journal page, newest day first, the root blocks of a day in their order (also when a
    /// note kept for its open "Wohin damit?" list stands at another place of the list).
    /// </summary>
    private static List<List<NoteBlock>> Days(IEnumerable<NoteBlock> notes) =>
    [
        .. notes.GroupBy(note => note.Page.FilePath, StringComparer.OrdinalIgnoreCase)
            .Select(day => day.ToList())
            .OrderByDescending(day => day[0].Date ?? DateOnly.MinValue),
    ];

    /// <summary>The <see cref="Days"/> that <see cref="Marks"/> does not hide.</summary>
    private List<List<NoteBlock>> VisibleDays(IEnumerable<NoteBlock> notes) => [.. Days(notes).Where(day => !Marks.Hides(day[0].Page))];

    /// <summary>
    /// Sets or clears a mark of the day's page (<paramref name="change"/> returns <c>true</c> if it changed the page) and saves
    /// it through the session like other note writes. A read-only page or an open conflict is refused before anything
    /// changes; an external change is merged by the session; after any other failure the page is read from its file again.
    /// </summary>
    private void Mark(Page shown, Func<Page, bool> change)
    {
        _message = null;
        if (State.Session is not { } session)
        {
            return;
        }

        var page = session.Vault.FindPageByPath(shown.FilePath) ?? shown;
        if (page.IsReadOnly)
        {
            Refused(page, "JournalDayReadOnly");
            return;
        }

        if (session.HasOpenConflict(page.FilePath))
        {
            Refused(page, "NoteAdoptConflict");
            return;
        }

        if (!change(page))
        {
            // The file already has the clicked state (the view was behind): show the page's state.
            _markRefresh++;
            return;
        }

        if (session.TrySave(page, out var error))
        {
            return;
        }

        if (session.HasOpenConflict(page.FilePath))
        {
            Refused(page, "NoteAdoptConflict");
        }
        else if (error is FileChangedExternallyException)
        {
            Refused(page, "JournalDayExternalChange", ownRevisions: 1);
        }
        else
        {
            PageReload.FromDisk(session, page);
            ReadEntries();
            Refused(page, "JournalDayFailed");
        }
    }

    /// <summary>Shows <paramref name="key"/> at the day and recreates the mark inputs (see <see cref="_markRefresh"/>).</summary>
    private void Refused(Page page, string key, int ownRevisions = 0)
    {
        _message = (page.FilePath, key, Revision + ownRevisions);
        _markRefresh++;
    }

    private static string DayLabel(NoteBlock note) =>
        note.Date is { } date ? date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) : note.Page.Name;

    /// <summary>
    /// Opens the day in Logseq: through its first root block with an id (Logseq names journal pages by its own title
    /// format, not by the file), else by the page's name.
    /// </summary>
    private void OpenInLogseq(List<NoteBlock> day)
    {
        if (State.Session is { } session)
        {
            var id = day.Select(note => note.Block.Id).FirstOrDefault(id => id is not null);
            Platform.OpenExternal(LogseqLink.For(session.Vault.Root, id, day[0].Page.Name));
        }
    }
}
