@using NoteEvolution.Core.Books
@using NoteEvolution.Core.Links
@using NoteEvolution.Core.Model
@using Microsoft.Extensions.DependencyInjection
@using NoteEvolution.AI.Understanding
@using Microsoft.JSInterop
@implements IDisposable
@inject AppState State
@inject IJSRuntime JS
@inject UiSettings Settings
@inject IPlatformServices Platform
@inject IStringLocalizer<Strings> L
@inject ILogger<HeaderBar> Logger
@inject IServiceProvider Services

<header class="ne-header">
    <button type="button" class="ne-open-vault" @onclick="OnOpenVault">@L["OpenVault"]</button>

    @if (State.Session is { } session)
    {
        var books = BookChoices.Books(session.Vault);
        var pages = BookChoices.ConvertiblePages(session.Vault);
        @* Re-created when a page was chosen, so the select shows the current book again (see SelectBook). *@
        <select @key="_selectVersion" class="ne-book-select" aria-label="@L["Book"]" value="@(State.CurrentBook?.LinkName ?? "")"
                @onchange="SelectBook">
            @if (State.CurrentBook is null)
            {
                <option class="ne-book-placeholder" value="" disabled selected>@L["ChooseBookPlaceholder"]</option>
            }
            @if (books.Count > 0)
            {
                <optgroup label="@L["BooksGroup"]">
                    @foreach (var book in books)
                    {
                        <option class="ne-book-option" value="@book.LinkName">@book.Title</option>
                    }
                </optgroup>
            }
            @if (pages.Count > 0)
            {
                <optgroup label="@L["PagesGroup"]">
                    @foreach (var candidate in pages)
                    {
                        <option class="ne-page-option" value="@(PageValuePrefix + candidate.FilePath)">@candidate.Name</option>
                    }
                </optgroup>
            }
        </select>
    }

    @* Back and forward between the active blocks (spec 3); Alt+Left/Right in the whole window (index.html). *@
    <button type="button" class="ne-nav-back" disabled="@(!State.CanGoBack)" title="@L["NavBack"]" aria-label="@L["NavBack"]"
            @onclick="GoBack">◀</button>
    <button type="button" class="ne-nav-forward" disabled="@(!State.CanGoForward)" title="@L["NavForward"]" aria-label="@L["NavForward"]"
            @onclick="GoForward">▶</button>
    <button type="button" class="ne-undo" disabled="@(!CanUndo)" title="@_session?.Undo.NextDescription"
            @onclick="Undo">@L["Undo"]</button>
    @if (_undoError is not null)
    {
        <span class="ne-undo-error" role="alert">@_undoError</span>
    }

    @* The commands next to undo; the indicators (read-only files, AI, language model, system meter) at the right end. *@
    @if (OnHandledWizard.HasDelegate || OnDraftWizard.HasDelegate)
    {
        <div class="ne-assistants">
            <button type="button" class="ne-assistants-toggle" disabled="@(State.Session is null)" aria-expanded="@(_assistantsOpen ? "true" : "false")"
                    @onclick="() => _assistantsOpen = !_assistantsOpen">@L["Assistants"]</button>
            @if (_assistantsOpen && State.Session is not null)
            {
                <div class="ne-assistants-popup">
                    <button type="button" class="ne-assistant-handled" @onclick="OpenHandled">@L["AssistantHandled"]</button>
                    <button type="button" class="ne-assistant-draft" @onclick="OpenDraft">@L["AssistantDraft"]</button>
                </div>
            }
        </div>
    }

    <button type="button" class="ne-pdf" disabled="@(State.CurrentBook is null || !OnPdfExport.HasDelegate)"
            @onclick="OnPdfExport">@L["PdfExport"]</button>
    <button type="button" class="ne-linkcheck" disabled="@(State.Session is null || !OnLinkCheck.HasDelegate)"
            @onclick="OnLinkCheck">@L["LinkCheck"]</button>
    <button type="button" class="ne-settings" disabled="@(!OnSettings.HasDelegate)" @onclick="OnSettings">@L["Settings"]</button>
    <button type="button" class="ne-shortcuts" disabled="@(!OnShortcuts.HasDelegate)" @onclick="OnShortcuts">@L["Shortcuts"]</button>

    <span class="ne-header-spacer"></span>

    @if (ReadOnlyPages() is { Count: > 0 } readOnly)
    {
        <div class="ne-readonly">
            <button type="button" class="ne-readonly-toggle" title="@L["ReadOnlyFiles"]" aria-expanded="@(_readOnlyOpen ? "true" : "false")"
                    @onclick="() => _readOnlyOpen = !_readOnlyOpen">⚠ @readOnly.Count</button>
            @if (_readOnlyOpen)
            {
                <div class="ne-readonly-popup">
                    <div class="ne-readonly-title">@L["ReadOnlyFiles"]</div>
                    <ul class="ne-readonly-list">
                        @foreach (var broken in readOnly)
                        {
                            <li><span class="ne-readonly-file">@Path.GetFileName(broken.FilePath)</span><span class="ne-readonly-error">@broken.ParseError</span></li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    @{ var ai = AiStatusNow; }
    @* Also the fallback hint of spec 9: without a usable model the search is full text only. *@
    <span class="ne-ai ne-ai-@ai.State.ToString().ToLowerInvariant()" title="@(ai.State == AiState.Failed ? ai.Error : null)">@AiText(ai)</span>
    @if (LanguageModelNow() is { } llm)
    {
        @* The language model's background work (spec 4, 11.1): count, bar and remaining time, or why it waits. *@
        <span class="ne-llm" @onkeydown="OnLlmKey">
            @if (llm.Progress is { } progress)
            {
                <button type="button" class="ne-llm-text" aria-expanded="@(_breakdownOpen ? "true" : "false")"
                        @onclick="() => _breakdownOpen = !_breakdownOpen">@llm.Text</button>
                @if (progress.Done < progress.Total)
                {
                    <progress class="ne-llm-progress" max="@progress.Total" value="@progress.Done"></progress>
                }
                <button type="button" class="ne-llm-pause" title="@L[Settings.LanguageModelPaused ? "LlmResume" : "LlmPause"]"
                        aria-label="@L[Settings.LanguageModelPaused ? "LlmResume" : "LlmPause"]"
                        aria-pressed="@(Settings.LanguageModelPaused ? "true" : "false")" @onclick="TogglePause">@(Settings.LanguageModelPaused ? "▶" : "⏸")</button>
                @if (_breakdownOpen)
                {
                    @* A click anywhere else closes the popup (the backdrop lies under the popup, over the rest of the page). *@
                    <div class="ne-llm-backdrop" @onclick="() => _breakdownOpen = false"></div>
                    <div class="ne-llm-breakdown" role="group" aria-label="@L["LlmBreakdownTitle"]">
                        @if (State.Session?.EmbeddingProgress is { } embedding)
                        {
                            <div class="ne-llm-row ne-llm-row-embedding">
                                <span class="ne-llm-row-label">@L["LlmBreakdownEmbedding"]</span>
                                <span class="ne-llm-row-count">@L["LlmBreakdownCount", embedding.Done, embedding.Total]</span>
                                <progress max="@embedding.Total" value="@embedding.Done"></progress>
                            </div>
                        }
                        @foreach (var (kind, css, label) in BreakdownKinds)
                        {
                            @if (progress.Kinds?.GetValueOrDefault(kind) is { Total: > 0 } row)
                            {
                                <div class="ne-llm-row ne-llm-row-@css">
                                    <span class="ne-llm-row-label">@L[label]</span>
                                    <span class="ne-llm-row-count">@L["LlmBreakdownCount", row.Done, row.Total]</span>
                                    <progress max="@row.Total" value="@row.Done"></progress>
                                    @if (row.Total - row.Done > 0)
                                    {
                                        <span class="ne-llm-row-remaining">@(row.Remaining is { } remaining ? L["LlmHeaderRemaining", Durations.Format(remaining, L)] : L["LlmHeaderRemainingUnknown"])</span>
                                    }
                                    @if (row.Failed > 0)
                                    {
                                        <span class="ne-llm-row-failed">@L["LlmBreakdownSkipped", row.Failed]</span>
                                    }
                                </div>
                            }
                        }
                        @if (progress.Pause != UnderstandingPause.None)
                        {
                            <div class="ne-llm-breakdown-pause">@L["LlmBreakdownPaused", PauseText(progress.Pause, L)]</div>
                        }
                    </div>
                }
            }
            else
            {
                <span class="ne-llm-text">@llm.Text</span>
            }
        </span>
    }
    <SystemMeter />
</header>

@code {
    /// <summary>Marks a page option's value; a file name cannot contain <c>|</c>, so no book link name starts with it.</summary>
    private const string PageValuePrefix = "page|";

    private VaultSession? _session;
    private AiRuntime? _ai;

    /// <summary>The app's language model; <c>null</c> when none is registered.</summary>
    private LanguageModelRuntime? _language;
    private bool _readOnlyOpen;
    private bool _assistantsOpen;
    private bool _breakdownOpen;
    private int _selectVersion;

    /// <summary>Why the last undo was refused or failed; shown until the next undoable operation.</summary>
    private string? _undoError;

    /// <summary>The header as index.html calls it for Alt+Left/Right; created on the first render.</summary>
    private DotNetObjectReference<HeaderBar>? _self;

    [Parameter] public EventCallback OnOpenVault { get; set; }

    /// <summary>Raised when a page that is no book yet was chosen; the current book stays until it is converted.</summary>
    [Parameter] public EventCallback<Page> OnConvertPage { get; set; }

    /// <summary>Opens the <c>[handled]</c> assistant; the assistants menu is hidden while both assistants are unset.</summary>
    [Parameter] public EventCallback OnHandledWizard { get; set; }

    /// <summary>Opens the draft assistant; the assistants menu is hidden while both assistants are unset.</summary>
    [Parameter] public EventCallback OnDraftWizard { get; set; }

    /// <summary>Opens the PDF export dialog; the button is disabled while unset.</summary>
    [Parameter] public EventCallback OnPdfExport { get; set; }

    /// <summary>Opens the link check dialog; the button is disabled while unset.</summary>
    [Parameter] public EventCallback OnLinkCheck { get; set; }

    /// <summary>Opens the settings dialog; the button is disabled while unset.</summary>
    [Parameter] public EventCallback OnSettings { get; set; }

    /// <summary>Opens the legend of the keyboard shortcuts.</summary>
    [Parameter] public EventCallback OnShortcuts { get; set; }

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        TrackSession();

        // Without an AI runtime (not registered) the AI is off.
        _ai = Services.GetService<AiRuntime>();
        if (_ai is not null)
        {
            _ai.ModelChanged += OnSessionChanged;
        }

        _language = Services.GetService<LanguageModelRuntime>();
        if (_language is not null)
        {
            _language.Changed += OnSessionChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("neNav.register", _self);
        }
    }

    public void Dispose()
    {
        _self?.Dispose();
        State.Changed -= OnStateChanged;
        Unsubscribe();
        if (_ai is not null)
        {
            _ai.ModelChanged -= OnSessionChanged;
        }

        if (_language is not null)
        {
            _language.Changed -= OnSessionChanged;
        }
    }

    /// <summary>
    /// What the header shows of the language model: the open vault's background work, or without it what keeps the
    /// switched-on model from working; <c>null</c> when there is nothing to show (switched off, or ready without a vault).
    /// </summary>
    private (string Text, UnderstandingProgress? Progress)? LanguageModelNow()
    {
        if (_language is null || _language.State == LanguageModelState.Off)
        {
            _breakdownOpen = false;
            return null;
        }

        if (State.Session?.Understanding is { } progress)
        {
            return (LanguageModelText(progress, L), progress);
        }

        // The breakdown belongs to the progress: without it the popup closes, so it does not open again by itself.
        _breakdownOpen = false;

        return _language.State switch
        {
            LanguageModelState.Unreachable => (L["LlmHeaderUnreachable"], null),
            LanguageModelState.ModelMissing => (L["LlmHeaderModelMissing"], null),
            LanguageModelState.Pulling => (L["LlmHeaderPulling"], null),
            _ => null,
        };
    }

    /// <summary>
    /// The text of the background work: "Sprachmodell 34/120 · noch ca. 1 h 10 min" (before the third answer "Restzeit
    /// wird ermittelt"), why it waits instead of the time, or "Sprachmodell bereit" when all is done; "Sprachmodell prüft …"
    /// before the worker looked at its first work (nothing is known yet).
    /// </summary>
    public static string LanguageModelText(UnderstandingProgress progress, IStringLocalizer<Strings> l)
    {
        if (!progress.Planned)
        {
            return l["LlmHeaderChecking"];
        }

        var away = progress.Pause is UnderstandingPause.Unreachable or UnderstandingPause.ModelMissing;
        if (progress.Done >= progress.Total && !away)
        {
            return l["LlmHeaderReady"];
        }

        string detail = progress.Pause != UnderstandingPause.None ? PauseText(progress.Pause, l)
            : progress.Remaining is { } remaining ? l["LlmHeaderRemaining", Durations.Format(remaining, l)]
            : l["LlmHeaderRemainingUnknown"];
        return $"{l["LlmHeaderProgress", progress.Done, progress.Total]} · {detail}";
    }

    /// <summary>Why the work waits (<paramref name="pause"/> is not <see cref="UnderstandingPause.None"/>).</summary>
    private static string PauseText(UnderstandingPause pause, IStringLocalizer<Strings> l) => pause switch
    {
        UnderstandingPause.User => l["LlmPauseUser"],
        UnderstandingPause.Typing => l["LlmPauseTyping"],
        UnderstandingPause.Battery => l["LlmPauseBattery"],
        UnderstandingPause.Unreachable => l["LlmPauseUnreachable"],
        _ => l["LlmPauseModelMissing"],
    };

    private static readonly (UnderstandingKind Kind, string Css, string Label)[] BreakdownKinds =
    [
        (UnderstandingKind.Heading, "headings", "LlmBreakdownHeadings"),
        (UnderstandingKind.Note, "cores", "LlmBreakdownCores"),
        (UnderstandingKind.Placement, "placements", "LlmBreakdownPlacements"),
    ];

    /// <summary>Escape closes the breakdown (like clicking outside).</summary>
    private void OnLlmKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _breakdownOpen = false;
        }
    }

    /// <summary>The pause switch: saved, and passed to the open vault's work at once (through the runtime's change).</summary>
    private void TogglePause()
    {
        if (_language is null)
        {
            return;
        }

        _language.SetPaused(!Settings.LanguageModelPaused);
        try
        {
            Settings.Save(Platform.UserDataDirectory);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogWarning(ex, "Saving the UI settings failed");
        }
    }

    /// <summary>The open vault's AI status; without one the runtime's (model missing, downloading).</summary>
    private AiStatus AiStatusNow => State.Session?.AiStatus ?? _ai?.Status ?? AiStatus.Off;

    private string AiText(AiStatus ai) => ai.State switch
    {
        AiState.Ready => L["AiLocal"],
        AiState.Indexing => L["AiIndexing", ai.Done, ai.Total],
        AiState.ModelMissing => L["AiModelMissing"],
        AiState.Downloading => L["AiDownloading"],
        AiState.Failed => L["AiFailed"],
        _ => L["AiOff"],
    };

    /// <summary>Undo is refused while a conflict is open (R26): it writes pages directly.</summary>
    private bool CanUndo => _session is { HasAnyOpenConflict: false } session && session.Undo.CanUndo;

    private void OnStateChanged() => _ = InvokeAsync(() =>
    {
        TrackSession();
        StateHasChanged();
    });

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnUndoPushed(IUndoAction action) => _ = InvokeAsync(() =>
    {
        _undoError = null;
        StateHasChanged();
    });

    /// <summary>Follows the undo stack and the conflicts of the current session (a vault switch brings a new one).</summary>
    private void TrackSession()
    {
        if (ReferenceEquals(State.Session, _session))
        {
            return;
        }

        Unsubscribe();
        _session = State.Session;
        _undoError = null;
        if (_session is not null)
        {
            _session.Undo.Changed += OnSessionChanged;
            _session.Undo.Pushed += OnUndoPushed;
            _session.ConflictsChanged += OnSessionChanged;
            _session.AiStatusChanged += OnSessionChanged;
            _session.UnderstandingChanged += OnSessionChanged;
            _session.NoteStatusChanged += OnSessionChanged;
        }
    }

    private void Unsubscribe()
    {
        if (_session is not null)
        {
            _session.Undo.Changed -= OnSessionChanged;
            _session.Undo.Pushed -= OnUndoPushed;
            _session.ConflictsChanged -= OnSessionChanged;
            _session.AiStatusChanged -= OnSessionChanged;
            _session.UnderstandingChanged -= OnSessionChanged;
            _session.NoteStatusChanged -= OnSessionChanged;
        }
    }

    private List<Page> ReadOnlyPages() => State.Session?.Vault.Pages.Where(p => p.IsReadOnly).ToList() ?? [];

    private async Task SelectBook(ChangeEventArgs e)
    {
        if (State.Session is not { } session || e.Value is not string value)
        {
            return;
        }

        if (value.StartsWith(PageValuePrefix, StringComparison.Ordinal))
        {
            // The select keeps showing the current book: the page only becomes one once the assistant converted it.
            _selectVersion++;
            if (session.Vault.FindPageByPath(value[PageValuePrefix.Length..]) is { } page)
            {
                await OnConvertPage.InvokeAsync(page);
            }

            return;
        }

        if (session.Vault.FindBook(value) is not { } book)
        {
            return;
        }

        // A jump in the back/forward history; the shell remembers the book (AppState.BookSelected).
        State.SelectBook(book);
        State.Notify();
    }

    /// <summary>Alt+Left (<c>back</c>) or Alt+Right (<c>forward</c>), caught by index.html in the whole window; others are ignored.</summary>
    [JSInvokable]
    public Task Navigate(string direction) => direction switch
    {
        "back" => InvokeAsync(GoBack),
        "forward" => InvokeAsync(GoForward),
        _ => Task.CompletedTask,
    };

    private Task GoBack() => GoAsync(State.GoBackAsync, State.CanGoBack);

    private Task GoForward() => GoAsync(State.GoForwardAsync, State.CanGoForward);

    private async Task GoAsync(Func<Task> go, bool can)
    {
        if (!can)
        {
            return;
        }

        try
        {
            await go();
        }
        catch (Exception ex)
        {
            // The editor's text could not be saved: the view stays where it is.
            Logger.LogError(ex, "Saving the editor before going back or forward failed");
        }
    }

    private async Task OpenHandled()
    {
        _assistantsOpen = false;
        await OnHandledWizard.InvokeAsync();
    }

    private async Task OpenDraft()
    {
        _assistantsOpen = false;
        await OnDraftWizard.InvokeAsync();
    }

    private async Task Undo()
    {
        if (_session is null)
        {
            return;
        }

        // The editor's pending text is saved first: undo writes the book page directly.
        try
        {
            if (State.FlushEditor is { } flush)
            {
                await flush();
            }
        }
        catch (Exception ex)
        {
            // The text may not be saved, so nothing is undone behind it.
            Logger.LogError(ex, "Saving the editor before undoing failed");
            return;
        }

        if (_session is not { } session || !ReferenceEquals(session, State.Session))
        {
            return;
        }

        // Refused while a conflict is open, or when the action no longer fits (e.g. the editor already brought a
        // deleted block back); the session logs the details, the header says that nothing was undone.
        _undoError = session.TryUndo(out _) ? null : L[session.HasAnyOpenConflict ? "UndoConflict" : "UndoFailed"].Value;

        // The undone operation changed (and saved) the book page, or a failed one left the vault with the page as it
        // is on disk; views take it from the vault again.
        State.RefreshBook();
        State.Notify();
    }
}
