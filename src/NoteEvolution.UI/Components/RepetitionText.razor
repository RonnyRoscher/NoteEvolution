@using NoteEvolution.Core.Repetitions
@using NoteEvolution.Core.Text
@using NoteEvolution.UI.Editor

@* One block of the repetitions views: its own text and its sub-points (indented by depth) with **bold** and *italic* shown
   as such, and the marked stretches underlined or highlighted the way the editor does (the classes of app.css). The text
   is not editable. *@
<div class="ne-rep-text">
    @for (var index = 0; index < Block.Paragraphs.Count; index++)
    {
        var paragraph = Block.Paragraphs[index];
        <p class="ne-rep-para" style="@Indent(paragraph.Depth)">
            @foreach (var piece in Pieces(index, paragraph))
            {
                if (piece.Kinds.Count > 0)
                {
                    <span class="@ClassOf(piece.Kinds)">@foreach (var run in piece.Runs)
                    {
                        @Emphasized(run)
                    }</span>
                }
                else
                {
                    foreach (var run in piece.Runs)
                    {
                        @Emphasized(run)
                    }
                }
            }
        </p>
    }
</div>

@code {
    private const int IndentPixels = 24;

    /// <summary>A stretch of a paragraph's runs that is marked in one way (or not marked, with no kinds).</summary>
    private sealed record Piece(IReadOnlyList<RepetitionMarkKind> Kinds, List<InlineRun> Runs);

    [Parameter, EditorRequired] public ComparedBlock Block { get; set; } = default!;

    /// <summary>
    /// The marked stretches as <see cref="ComparedParagraph.Plain"/> offsets of the compared paragraphs (paragraph, start,
    /// length) with the way they are marked; stretches may overlap and then show both ways.
    /// </summary>
    [Parameter] public IReadOnlyList<(int Paragraph, int Start, int Length, RepetitionMarkKind Kind)> Spans { get; set; } = [];

    private static string? Indent(int depth) => depth == 0 ? null : $"margin-left: {depth * IndentPixels}px";

    private static string ClassOf(IReadOnlyList<RepetitionMarkKind> kinds) => string.Join(' ', kinds.Select(kind => kind switch
    {
        RepetitionMarkKind.Literal => "ne-rep-literal",
        RepetitionMarkKind.Semantic => "ne-rep-semantic",
        _ => "ne-rep-current",
    }));

    private static RenderFragment Emphasized(InlineRun run) => run switch
    {
        { Bold: true, Italic: true } => @<strong><em>@run.Text</em></strong>,
        { Bold: true } => @<strong>@run.Text</strong>,
        { Italic: true } => @<em>@run.Text</em>,
        _ => @<text>@run.Text</text>,
    };

    /// <summary>The ways the character at <paramref name="at"/> of the paragraph is marked, in a fixed order.</summary>
    private IReadOnlyList<RepetitionMarkKind> KindsAt(int paragraph, int at) =>
        [.. Spans
            .Where(span => span.Paragraph == paragraph && span.Start <= at && at < span.Start + span.Length)
            .Select(span => span.Kind)
            .Distinct()
            .OrderBy(kind => kind)];

    /// <summary>
    /// The next offset after <paramref name="at"/> where the marking of the paragraph may change (a span starts or ends).
    /// </summary>
    private int NextEdge(int paragraph, int at) =>
        Spans.Where(span => span.Paragraph == paragraph)
            .SelectMany(span => new[] { span.Start, span.Start + span.Length })
            .Where(edge => edge > at)
            .DefaultIfEmpty(int.MaxValue)
            .Min();

    /// <summary>
    /// The runs of the paragraph cut at the marked stretches' edges; neighbours that are marked the same way (a mark
    /// across a bold run) form one piece, so they get one element.
    /// </summary>
    private List<Piece> Pieces(int index, ComparedParagraph paragraph)
    {
        var pieces = new List<Piece>();
        var position = 0;
        foreach (var run in paragraph.Runs)
        {
            var from = 0;
            while (from < run.Text.Length)
            {
                var at = position + from;
                var kinds = KindsAt(index, at);
                var length = Math.Min(run.Text.Length - from, NextEdge(index, at) - at);
                var part = run with { Text = run.Text.Substring(from, length) };
                if (pieces.Count > 0 && pieces[^1].Kinds.SequenceEqual(kinds))
                {
                    pieces[^1].Runs.Add(part);
                }
                else
                {
                    pieces.Add(new Piece(kinds, [part]));
                }

                from += length;
            }

            position += run.Text.Length;
        }

        return pieces;
    }
}
